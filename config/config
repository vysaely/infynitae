    # options: true  · false

PAN_MODE="free"
    # Super+Middle drag
    # default: free
    #   free     the cursor moves with the canvas
    #    grab    the canvas moves under a fixed cursor
    #    rts     camera grip (edge-scroll style)

CANVAS_COLOR="#0b0f14"
