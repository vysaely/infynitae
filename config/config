# ═══ Key bindings ══════════════════════════════════════════════════════════════════ [save] ═══
# The built-in keys follow one rule: often used on the left hand, rare on the right.
#   Often:  Super+Tab  last two windows (a window asking for attention first; hold Super and
#                      tap Tab to go further back)    Super+Shift+Tab  overview
#           Super+Q / W / E  terminal / edge / files    Super+A  control menu
#           Super+S  region screenshot    Super+Shift+S  whole screen    Super+V  clipboard
#           Super+C  close (Shift: force)    Super+Space  centre    Super+1..9  window slots
#   Rare:   Super+L  lock    Super+Shift+O  tearing    Super+Shift+P  privacy
#           Super+Shift+I  stay awake    Super+Alt+P  record    Super+Alt+C  replay clip
#           Super+Shift+BackSpace  reload
#   Old keys kept as aliases: Super+Shift+R (region screenshot), Super+Shift+T (tearing),
#   Super+Alt+R (record).
# Give an action other keys (all its built-in ones are freed), or free them with "none":
#   BIND_<ACTION>="CHORD[,CHORD]"       e.g. BIND_TERMINAL="SUPER+RETURN"
#   FOCUS_NEXT OVERVIEW LAUNCHER TERMINAL FILE_MANAGER SCREENSHOT REGION_SCREENSHOT RELOAD LOCK
#   CLIPBOARD CONTROL PRIVACY IDLE_INHIBIT TEARING SAVE_REPLAY RECORD FIT FULLSCREEN CLOSE
#   FORCE_CLOSE RECENTER RECENTER_KEEP_ZOOM
# Run a command:
#   EXEC_<NAME>="CHORD:command"         e.g. EXEC_BROWSER="SUPER+B:firefox"
# Chord: SUPER CTRL ALT SHIFT (exactly those held) + one key: A-Z 0-9 F1-F12 RETURN SPACE TAB
# ESC BACKSPACE DELETE INSERT HOME END PAGEUP PAGEDOWN LEFT RIGHT UP DOWN PRINT MINUS EQUAL
# COMMA PERIOD SLASH SEMICOLON APOSTROPHE GRAVE BACKSLASH BRACKETLEFT BRACKETRIGHT.
# A line that is not understood is skipped and noted in ~/.local/state/infynitae/session.log.
# Built-in keys and mouse gestures: see the README.

GLOBAL_SHORTCUTS=""
    # Your keys for apps' global shortcuts (Discord, OBS, browsers: what they register through
    # the shortcuts portal), whatever key the app asked for; the key still types as usual
    # default: ""   (each app keeps the key it asked for)
    #   "ID=KEY ID=KEY"         e.g. "discord-toggle-mute=Shift_R discord-toggle-deafen=Control_R"
    #   "APP/ID=KEY"            one app's shortcut only
    # KEY: a key name (Shift_R, Control_R, F9, Pause, XF86AudioMute) or a chord (CTRL+SHIFT+m).
    # The IDs: `grep "Bound shortcut" ~/.local/state/infynitae/portal.log`

XWAYLAND_KEYS="modifiers"
    # Keys X11 apps hear while another window has focus (push-to-talk in an X11 Discord or
    # TeamSpeak, a game's or OBS's hotkeys). Never while the screen is locked.
    # default: modifiers
    #   off          none
    #   modifiers    keys that type nothing: Shift, Ctrl, Alt, Super alone, F1-F24, media keys
    #   shortcuts    those, and any key while Ctrl, Alt or Super is held
    #   all          every key (an X11 app can then read whatever you type)


