FAVORITES=""
    # The apps the favorites module shows, in this order: desktop file names or app names.
    # Right click an app (or Shift+Enter) in the apps panel to add it or take it out. [use]
    # default: ""   e.g. "firefox org.gnome.Nautilus steam discord"

# The edge's panels, one line each: PANEL_<NAME>="KEY PLACE MODULES", words in any order. [use]
#   KEY     a chord (SUPER+W, SUPER+SHIFT+M, see the keys below), or none
#   PLACE   the edge: top bottom left right; then where along it: left center right (top center
#           bottom on a side edge); a width in px; hover: a touch of that screen edge opens it
#   MODULES stacked in the order written; one with nothing to show hides itself:
#           search  favorites  apps  windows  clipboard  clock  volume  media  wifi  bluetooth
#           dnd  nightlight  keyboard  osk  power  replay  tray  notifications  session
#           calendar  memory  system  (these three: the Rust edge only)
#           (clock: a click shows the month; media: the player playing, hidden when none;
#           nightlight: warmer colours, NIGHT_LIGHT_TEMP; keyboard: the next layout, shown with
#           more than one in XKB_DEFAULT_LAYOUT; osk: the on-screen keyboard, shown with squeekboard
#           installed; bluetooth's list: Find new devices pairs one)
#   A module's look: module:look, smallest first (none written: the switches tile, search bar, clock time):
#           the switches (wifi bluetooth dnd nightlight keyboard osk power replay):
#             small (a quarter row, the name only)  tile (half a row, name and state)  wide (the row)
#           search: hidden (shows once you type)  bar      clock: time  big  calendar (month shown)
#           e.g. PANEL_CONTROL="clock:big wifi:small bluetooth:small dnd:small nightlight:small volume"
#   Editing a panel: right click on it where nothing else uses the right click (or hold a finger
#   there). It keeps its look: the card under the pointer shows a bar to move it up or down, make
#   it half width (two halves sit side by side), change its look, or take it out; a card can be
#   dragged too. Each switch in Quick settings has its own x. The bar beside the panel: Undo,
#   Reset (asks first), Add (each module with what it is for), - and + (the width), the edge the
#   panel is on, Hover, Cancel (throws the changes away), Done. Done or Escape saves the line here
#   (module@half for a half); the line from before is kept in ~/.config/infynitae/panels.backup.
#   A line written with places (module@x,y,WxH, the older editor) is read in order, side by side
#   modules as halves. An open list (networks, devices, sound, replay) opens beside the panel.
#   The desktop's widgets (WIDGETS) keep free placement; for them Snap and Overlap still apply:
PANELS_SNAP="true"
PANELS_OVERLAP="false"
