# ═══ Displays & sharpness ══════════════════════════════════════════════════════════ [restart] ═══

OUTPUT_SCALE="1.0"
    # Interface scale of every screen
    # default: 1.0
    # options: 1.0  · 1.25  · 1.5  · 2.0 …

SCALING_FILTER="nearest"
    # How windows look when not at 100% zoom
    # default: nearest
    #   nearest    zoomed in: sharp pixels · zoomed out: averaged, so text stays legible
    #    linear    zoomed in: smooth      · zoomed out: averaged
    #    fast      not averaged: the crispest edges zoomed out, but text shimmers while the
    #              camera moves; the least GPU work (games are never affected)

MAX_APP_SCALE="1"
    # Apps redraw sharper as you zoom in, up to this scale [save]
    # default: 1
    # options: 1 never: zooming only scales what is drawn (text soft when zoomed in, never
    #            shifts)  · 2  · 3 sharper, apps redraw as you zoom (see ZOOM_SHARPEN)  · 4 …

ZOOM_SHARPEN="after"
    # When apps redraw sharper as you zoom [save]
    # default: after
    #   after   once the zoom stops, at a whole scale (2x, 3x): text does not shift while zooming
    #   live    at each step while zooming (finer steps; a terminal re-flows its text at each)

