# ═══ Performance & latency ═════════════════════════════════════════════════════════ [save] ═══

LATENCY="off"
    # When each frame is drawn
    # default: off
    #   off         at once (the most forgiving under heavy GPU load)
    #    balanced   just in time for the refresh: about a frame less delay (experimental;
    #               misses more refreshes while the GPU is busy, e.g. a game or AI training)
    #    lowest     tighter still

LATENCY_STATS="false"
    # Input-to-screen times in ~/.local/state/infynitae/session.log every 10 s
    # default: false
    # options: false  · true

DIRECT_SCANOUT="true"
    # A fullscreen game's frames go straight to the screen
    # default: true
    # options: true  · false

TEARING="true"
    # A fullscreen game shows each frame at once (lowest latency, a visible tear line)
    # default: true
    #   true     when it asks (vsync off) or after Super+Shift+O on its window
    #    false   never

GAME_MODE="true"
    # While a game is fullscreen (shown directly), gamemode runs the CPU at full speed
    # (when installed)
    # default: true
    # options: true  · false

BACKGROUND_PRIORITY="true"
    # An app whose windows have all been out of sight for 15 s runs at a lower CPU priority,
    # back when you see one (never a shared window, the game, or X11 apps)
    # default: true
    # options: true  · false

HARDWARE_CURSOR="true"
    # The cursor on the GPU's own cursor layer: it moves without a redraw, and a fullscreen game
    # under it still goes to the screen directly (tearing, game mode)
    # default: true
    #   true     GPU cursor layer
    #    false   drawn into the frame

OVERLAY_PLANES="false"
    # Also put windows' buffers on overlay planes
    # default: false
    # options: false  · true (on AMD this dropped frames whenever Electron apps like Discord drew)


