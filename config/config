# ═══ Windows & canvas ═════════════════════════════════════════════════════════════ [save] ═══

FOCUS_FOLLOWS_MOUSE="strict"
    # Which window gets the keyboard
    # default: strict
    #   strict     hover focuses; empty canvas unfocuses
    #    sloppy    hover focuses; kept over empty canvas
    #    click     only a click focuses

FOCUS_ON_OPEN="priority"
    # Whether a new window takes the focus
    # default: priority
    #   priority    unless you are busy: windows you opened always do; with Do Not Disturb
    #               (Super+A) no other does; a fullscreen game or video keeps it (only its own
    #               dialogs get in). A held window asks for attention instead
    #    user       only windows you opened (shortcuts, launcher, a command in the focused
    #               terminal), not ones an app opens by itself; those ask for attention
    # A window asking for attention is marked in the edge (Super+W), and Super+Tab goes to it
    # first.
    #    1          every window
    #    0          never

TELEPORT_ON_OPEN="user"
    # Whether the camera moves to a new window
    # default: user
    #   user    only windows you opened  · 1 every window  · 0 never

FOCUS_ON_ACTIVATE="user"
    # An app asks to be focused
    # default: user
    #   user       only from your launcher or itself; one app handing focus to another
    #              (a link from Discord in the browser) only marks it
    #    always    · never

FOCUS_CYCLE_NAVIGATE="1"
    # Super+Tab also centres the camera on the window (always on a window asking for attention)
    # default: 1
    # options: 1  · 0

PLACEMENT_POLICY="cluster"
    # Where a new window goes
    # default: cluster
    #   cluster    next free spot beside the others
    #    center    the middle of the view
    #    origin    the canvas origin

SUPER_ENTER_ACTION="maximize"
    # Super+Enter
    # default: maximize
    #   maximize    the window fills the view at 100%
    #    fit        zoom the camera to the window

FULLSCREEN_PAN="true"
