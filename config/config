    #   off     only by hand   (the lock screen has its own)

BATTERY_LIMIT="off"
    # The battery stops charging at this % (it wears more slowly). Laptops that support it;
    # also in the control menu (Super+A)
    # default: off
    #   off    to full  · e.g. "80"

AUTO_ROTATE="auto"
    # Turn the laptop's own screen with the device (convertibles; needs iio-sensor-proxy)
