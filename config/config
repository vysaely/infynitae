# ═══ Privacy & screen capture ══════════════════════════════════════════════════════ [save] ═══

SCREENSHARE_ASK="app"
    # An app's Share button (the screen-sharing portal) [reload]
    # default: app
    #   app      the first time an app shares, you are asked (this time, always, or deny);
    #            then the (first) screen is shared at once, a window tab gets a menu
    #    true    asked as with app, and always pick a screen or a window from a menu
    #   false    no question: the first screen is shared at once
    # "Always" is remembered per app id in ~/.local/state/infynitae/screenshare-allowed (one
    # per line: delete a line to be asked again). Apps outside a sandbox have no id and are
    # asked each time. Direct capture (screenshots, recorders) is ALLOW_CAPTURE below.

SCREENCOPY_CURSOR="false"
    # Draw the cursor into captures
    # default: false
    #   false    no double cursor in RustDesk  · true (OBS)

CAPTURE_INDICATOR="true"
    # A small red dot in the top right corner while any app captures the screen (sharing,
    # remote desktop, screenshots); the replay buffer does not show it, captures never show
    # it. Over a fullscreen window a notification says it instead
    # default: true
    # options: true  · false

PRIVACY_APPS=""
    # Hidden from captures, by app
    # default: ""
    # options: ""  · e.g. "bitwarden,keepassxc" (comma or space separated)

PRIVACY_TITLES=""
    # Hidden from captures, by title (Super+Shift+P toggles a window)
    # default: ""
    # options: ""  · e.g. "Password"

# Which apps may use the powers above the normal app's (docs/SECURITY.md). Each list holds
# app ids (a sandboxed app, e.g. Flatpak: "com.obsproject.Studio") and program names or paths
# (a desktop app, known by its real file), separated by spaces. The word "native" lets every
# desktop app in; take it out to allow only the ones named. A sandboxed app gets a power only
# when its app id is listed. Infynitae's own helpers always have what they need. Applies to
# apps that start after you save.

