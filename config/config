# Infynitae — ~/.config/infynitae/config
#
# A shell file: KEY="value", '#' starts a comment. Each section says when its changes apply:
#   [save]    the moment you save this file
#   [reload]  on Super+Shift+Backspace (or `infynitae-reload`)
#   [use]     the next time the thing is used
#   [restart] on the next compositor start (Ctrl+Alt+Backspace; closes windows)
# A setting left out uses its default (the value shown here).

# ── Keyboard & mouse ──────────────────────────────────────────────────── [save] ──
XKB_DEFAULT_LAYOUT=""             # [restart] "us", "us,de"… — empty: the system's layout
XKB_DEFAULT_OPTIONS=""            # [restart] e.g. "grp:alt_shift_toggle,caps:swapescape"
KEYBOARD_REPEAT_DELAY="200"       # ms before a held key repeats
KEYBOARD_REPEAT_RATE="35"         # repeats per second
MOUSE_ACCEL_PROFILE="flat"        # flat (1:1, best for games) | adaptive
MOUSE_ACCEL_SPEED="0.0"           # -1.0 … 1.0
TOUCHPAD_TAP="true"               # tap to click
TOUCHPAD_NATURAL_SCROLL="false"   # content follows the fingers
SUPER_FREES_CURSOR="true"         # holding Super frees a cursor a game captured (Dota…)

# ── Windows & canvas ──────────────────────────────────────────────────── [save] ──
FOCUS_FOLLOWS_MOUSE="strict"      # sloppy: hover focuses, kept over empty canvas
                                  # strict: hover focuses, empty canvas unfocuses | click
FOCUS_ON_OPEN="priority"          # a new window takes the focus — priority: unless you are busy:
                                  # windows you opened always do; with Do Not Disturb (Super+A)
                                  # no other does; a fullscreen game or video keeps it (only its
                                  # own dialogs get in). A held window asks for attention instead
                                  # | user: only windows you opened (shortcuts, launcher, a command
                                  # in the focused terminal) | 1: every window | 0: never
TELEPORT_ON_OPEN="user"           # the camera moves to a new window — same values
FOCUS_ON_ACTIVATE="user"          # an app asks to be focused — user: only from your launcher or
                                  # itself; one app handing focus to another (a link from Discord
                                  # in the browser) only marks it | always | never
FOCUS_CYCLE_NAVIGATE="1"          # Super+Tab also centres the camera on the window
PLACEMENT_POLICY="cluster"        # cluster: next free spot beside the others | center | origin
SUPER_ENTER_ACTION="maximize"     # maximize: the window fills the view at 100% | fit: zoom to it
FULLSCREEN_PAN="true"             # Super+Middle drag and Super+1…9 work out of fullscreen
PAN_MODE="free"                   # Super+Middle drag — free: cursor moves with the canvas
                                  # grab: canvas under a fixed cursor | rts: camera grip
CANVAS_COLOR="#0b0f14"
BORDER_WIDTH="1"                  # px, 0 = none
BORDER_ACTIVE="#7aa2f7"
BORDER_INACTIVE="#333b54"
BORDER_IGNORE_CSD="true"          # no border around apps that draw their own (Firefox…)
LATENCY="off"                     # off: drawn at once | balanced: each frame drawn just in time for the
                                  # refresh (about a frame less delay; experimental) | lowest: tighter
LATENCY_STATS="false"             # true: input-to-screen times in the session log every 10 s
SQUARE_CORNERS="true"             # apps draw square corners and no shadow (they are told they are
                                  # tiled), flush with the border; false: their own rounded look
CLIP_TO_GEOMETRY="true"           # windows are drawn only inside their own edges, not in the
                                  # margins apps keep for shadows (stale pixels there: black blocks)
WINE_TRANSPARENCY="true"          # no black boxes behind Wine/Proton/X11 layered windows
FORCE_TRANSPARENT_APPS=""         # more apps to blend that way, e.g. "steam_app"

# ── Look ──────────────────────────────────────────────────────────────── [reload] ──
CURSOR_THEME="Adwaita"            # installed themes: infynitae-settings list cursors
CURSOR_SIZE="24"
FONT_NAME="monospace"
FONT_SIZE="10"
ICON_THEME="Adwaita"
COLOR_SCHEME="prefer-dark"        # prefer-dark | prefer-light
WALLPAPER=""                      # [save] an image (PNG, JPG, WebP); "$HOME/…" works. Empty: the
                                  # first in ~/Pictures/Wallpapers or ~/.local/share/wallpapers
WALLPAPER_MODE="fill"             # [save] fill | fit | stretch | center | tile

# ── Displays ──────────────────────────────────────────────────────────── [restart] ──
OUTPUT_SCALE="1.0"                # 1.0, 1.25, 1.5, 2.0 …
SCALING_FILTER="nearest"          # zoomed in — nearest: sharp pixels | linear: smooth; zoomed
                                  # out, windows are averaged so text stays legible | fast: not
                                  # averaged (the least GPU work; games are never affected)
MAX_APP_SCALE="3"                 # [save] apps redraw sharper as you zoom in, up to this scale
                                  # (1 = never: cheapest, blurry when zoomed in)
VRR_ENABLED="auto"                # auto: FreeSync while a window is fullscreen | on | off
                                  # (display tools can switch it per screen: wlr-randr --adaptive-sync)
VIRTUAL_SCREEN="auto"             # [restart] with no screen connected (monitor off or unplugged), a
                                  # virtual 1920x1080 one stands in, so remote desktop still works
                                  # | off
DIRECT_SCANOUT="true"             # [save] a fullscreen game's frames go straight to the screen
TEARING="true"                    # [save] a fullscreen game shows each frame at once (lowest
                                  # latency, a visible tear line) when it asks (vsync off) or
                                  # after Super+Shift+T on its window | false: never
GAME_MODE="true"                  # [save] while a game is fullscreen (shown directly), gamemode
                                  # runs the CPU at full speed (when installed)
BACKGROUND_PRIORITY="true"        # [save] an app whose windows have all been out of sight for 15
                                  # seconds runs at a lower CPU priority, back when you see one
                                  # (never a shared window, the game, or X11 apps)
HARDWARE_CURSOR="true"            # [save] the cursor on the GPU's own cursor layer: it moves without
                                  # a redraw, and a fullscreen game under it still goes to the
                                  # screen directly (tearing, game mode) | false: drawn in
OVERLAY_PLANES="false"            # [save] also windows' buffers on overlay planes (on AMD this
                                  # dropped frames whenever Electron apps like Discord drew)
OSK="auto"                        # [restart] on-screen keyboard (squeekboard) for text fields —
                                  # auto: runs in tablet mode only | always | off. The lock screen
                                  # has its own
BATTERY_LIMIT="off"               # the battery stops charging at this % (e.g. "80": it wears
                                  # more slowly) | off: to full. Laptops that support it; also
                                  # in the control menu (Super+A)
AUTO_ROTATE="auto"                # [restart] turn the laptop's own screen with the device
                                  # (convertibles; needs iio-sensor-proxy) | false
OUTPUT_ORDER=""                   # left to right, e.g. "DP-1,HDMI-A-1" (the names
                                  # are the "Screen …" lines in ~/.local/state/infynitae/session.log)
OUTPUT_LAYOUT="left-to-right"     # or right-to-left
# Per screen (its name, '-' written as '_'), e.g. for DP-1:
#   OUTPUT_DP_1_MODE="2560x1440"  OUTPUT_DP_1_RATE="144"  OUTPUT_DP_1_SCALE="1.25"
#   OUTPUT_DP_1_TRANSFORM="90"    a turned screen: normal, 90, 180, 270 (counter-clockwise),
#                                 flipped, flipped-90, flipped-180, flipped-270. While running:
#                                 wlr-randr --output DP-1 --transform 90 (or wdisplays)

# ── Apps ──────────────────────────────────────────────────────────────── [use] ──
# "auto": the first one installed (terminal: kitty, alacritty, foot, …), or any command.
TERMINAL="auto"                   # Super+Q, and file managers' "Open Terminal Here"
LAUNCHER="auto"                   # Super+W — fuzzel, rofi, tofi, wofi, or e.g. "wofi --show drun"
ENABLE_QUICKSHELL="false"         # the Quickshell island/radar instead (needs quickshell)
FILE_MANAGER="auto"               # Super+E — terminal ones (yazi, lf) open in TERMINAL
BROWSER="auto"                    # auto: the system default; programs open links with it
POLKIT_AGENT="auto"               # [restart] password prompts — auto: infynitae-polkit, or a path
SCREENSHOT_DIR="$HOME/Pictures/Screenshots"
SCREENSHOT_CMD=""                 # Super+Shift+S — empty: grim; a command gets the file path
FREEZE_SCREENSHOT="true"          # Super+Shift+R: the screen stays frozen at the key press while you
                                  # pick the region (videos and games keep running underneath)
XWAYLAND="true"                   # [restart] X11 apps and games (xwayland-satellite, on demand)
SESSION_RESTORE="true"            # [restart] reopen the apps that were open, where they were
START_TERMINAL="true"             # [restart] open a terminal at login when nothing was restored
CLIPBOARD_PERSIST="true"          # [reload] keep clipboard after source closes (needs wl-clip-persist)
CLIPBOARD_HISTORY="true"          # [reload] Super+V clipboard history (needs cliphist and wl-paste)
CLIPBOARD_PICKER=""               # Super+V picker — empty: MENU_PICKER
MENU_PICKER=""                    # menus (control menu, clipboard) — empty: fuzzel --dmenu; any
                                  # dmenu-style command, e.g. "rofi -dmenu"
CONTROL_MENU="auto"               # Super+A — Wi-Fi, Bluetooth, sound output, power mode,
                                  # do not disturb (the parts whose tools are installed), or a command
NOTIFICATIONS="auto"              # [restart] notification daemon — auto: mako, swaync, dunst, fnott
                                  # (first installed) | none | a command
AUTOMOUNT="true"                  # [restart] USB drives and SD cards mount when plugged in (udiskie)

# ── Lock & idle ───────────────────────────────────────────────────────── [save] ──
IDLE_SLEEP_TIMEOUT_MIN="15"       # screens off after this many idle minutes, 0 = never
IDLE_AUTO_LOCK="true"             # lock when the screens go off (Super+Shift+I: stay awake)
SCREEN_LOCKER="auto"              # [use] Super+L — auto: infynitae-lock, or a command
START_LOCKED="false"              # [restart] start the session at the lock screen

# ── Privacy & screen capture ──────────────────────────────────────────── [save] ──
SCREENSHARE_ASK="false"           # [reload] false: an app's Share button shares the (first)
                                  # screen at once, a window tab gets a menu of the windows |
                                  # true: always pick a screen or a window from a menu.
                                  # Note: desktop apps can also capture directly (wlr-screencopy,
                                  # used by recorders and screenshots); the prompt guards the
                                  # screen-sharing portal only.
SCREENCOPY_CURSOR="false"         # draw the cursor into captures (true: OBS; false: no double
                                  # cursor in RustDesk)
CAPTURE_INDICATOR="true"          # [save] a small red dot in the top right corner while any app
                                  # captures the screen (sharing, remote desktop, screenshots);
                                  # the replay buffer does not show it, captures never show it.
                                  # Over a fullscreen window a notification says it instead
                                  # false: no dot
PRIVACY_APPS=""                   # hidden from captures, e.g. "bitwarden,keepassxc"
PRIVACY_TITLES=""                 # by title, e.g. "Password"; Super+Shift+P toggles a window
REMOTE_DESKTOP="false"            # [restart] true: remote desktop apps (AnyDesk, GNOME's clients)
                                  # get the screen and, once you allow it, the keyboard and mouse
                                  # (the RemoteDesktop portal). RustDesk uses it too when it is on.

# ── Screen recorder & replay buffer ───────────────────────────────────── [use] ──
# A rolling buffer in RAM: about 110 MB per minute, frames copied through the CPU. Audio: see
# RECORD_AUDIO (the microphone only when you choose mic or both). Super+Alt+C saves a clip, Super+Alt+R records.
# Changes apply when the recorder restarts: infynitae-reload recorder.
ENABLE_REPLAY_BUFFER="false"
REPLAY_BUFFER_MINUTES="20"
REPLAY_DIR="/dev/shm/infynitae-replay"
CLIPS_DIR="$HOME/Videos/Clips"
RECORDINGS_DIR="$HOME/Videos/Recordings"
RECORD_FPS="60"
RECORD_CODEC="hevc"               # auto | hevc | av1 | h264
RECORD_AUDIO="desktop"            # desktop | mic | both | none — the system's default devices

# ── Key bindings ──────────────────────────────────────────────────────── [save] ──
# Give an action other keys (its own are freed), or free them with "none":
#   BIND_<ACTION>="CHORD[,CHORD]"       e.g. BIND_TERMINAL="SUPER+RETURN"
#   FOCUS_NEXT OVERVIEW LAUNCHER TERMINAL FILE_MANAGER SCREENSHOT REGION_SCREENSHOT RELOAD LOCK
#   CLIPBOARD CONTROL PRIVACY IDLE_INHIBIT SAVE_REPLAY RECORD FIT FULLSCREEN CLOSE FORCE_CLOSE RECENTER
#   RECENTER_KEEP_ZOOM
# Run a command:
#   EXEC_<NAME>="CHORD:command"         e.g. EXEC_BROWSER="SUPER+B:firefox"
# Chord: SUPER CTRL ALT SHIFT (exactly those held) + one key: A-Z 0-9 F1-F12 RETURN SPACE TAB
# ESC BACKSPACE DELETE INSERT HOME END PAGEUP PAGEDOWN LEFT RIGHT UP DOWN PRINT MINUS EQUAL
# COMMA PERIOD SLASH SEMICOLON APOSTROPHE GRAVE BACKSLASH BRACKETLEFT BRACKETRIGHT.
# A line that is not understood is skipped and noted in ~/.local/state/infynitae/session.log.
# Built-in keys and mouse gestures: see the README.

# ── Your own scripts ──
# ~/.config/infynitae/autostart.sh   run at session start (bars, notifications…)
# ~/.config/infynitae/launch.sh      handles every shortcut action instead of the built-in one
