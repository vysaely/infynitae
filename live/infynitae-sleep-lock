#!/bin/sh
# infynitae-sleep-lock: the screen is locked before the machine sleeps (the lid, the power button,
# a menu), so it wakes at the lock screen. It holds a logind "delay" sleep inhibitor; when sleep
# is announced (PrepareForSleep true) it starts the lock screen, waits until the compositor says
# the session is locked (the shell snapshot), and only then lets the sleep go on; without that
# answer it keeps the inhibitor until logind's own limit. After the wake it takes the inhibitor
# again (or still has it). Started by session.sh; ends with the session.
#   INFYNITAE_SLEEP_MONITOR: a command printing logind's signals instead of gdbus (tests)
set -u
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/infynitae"
LOCK_LOG="$STATE_DIR/lock.log"
LOG="$STATE_DIR/sleep-lock.log"
mkdir -p "$STATE_DIR"
log() {
    printf '%s %s\n' "$(date '+%F %T.%3N')" "$*" >> "$LOG" 2>/dev/null || true
}

# one per session: two would race for the same sleep (fd 9 holds the lock; the programs started
# below do not inherit it, so a lock screen still up never keeps the next session's helper out)
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/infynitae"
mkdir -p "$RUN_DIR"
exec 9> "$RUN_DIR/sleep-lock.lock"
if command -v flock >/dev/null 2>&1 && ! flock -n 9; then
    exit 0
fi

INH=""
take() {
    [ -n "$INH" ] && kill -0 "$INH" 2>/dev/null && return
    systemd-inhibit --what=sleep --mode=delay --who=Infynitae \
        --why="Locking the screen before sleep" sleep infinity 9>&- &
    INH=$!
}
release() {
    [ -n "$INH" ] && kill "$INH" 2>/dev/null
    INH=""
}
end() {
    trap - INT TERM HUP
    release
    [ -n "${MON:-}" ] && kill "$MON" 2>/dev/null
    exit 0
}
trap end INT TERM HUP

locker() {
    case "${SCREEN_LOCKER:-auto}" in
        auto | "")
            for l in "$HOME/.local/bin/infynitae-lock" "$HOME/infynitae/live/lock/infynitae-lock"; do
                [ -x "$l" ] && { echo "$l"; return; }
            done
            command -v infynitae-lock 2>/dev/null
            ;;
        *) echo "$SCREEN_LOCKER" ;;
    esac
}

# Whether the session is locked, as the compositor says (the shell snapshot's "locked"): yes,
# no, or unknown (a compositor from before the field, or no answer). Never a process name: any
# program can call itself infynitae-lock.
INF_BIN="${INFYNITAE_BIN:-$HOME/.local/bin/infynitae}"
lock_state() {
    snap=$("$INF_BIN" msg snapshot 2>/dev/null) || { echo unknown; return; }
    case "$snap" in
        *'"locked":true'*) echo yes ;;
        *'"locked":false'*) echo no ;;
        *) echo unknown ;;
    esac
}

# logind waits for the inhibitor at most InhibitDelayMaxSec (5 s by default): that long, in
# tenths of a second, less one so the last check comes before it
delay_tenths() {
    us=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null | awk '{print $2}')
    case "$us" in
        '' | *[!0-9]*) echo 49 ;;
        *) t=$((us / 100000 - 1)); [ "$t" -gt 0 ] && echo "$t" || echo 49 ;;
    esac
}

# the lock screen up, then the sleep may go on. Returns 0 once the lock is confirmed; 1 when it
# is not: the inhibitor is then kept, so the sleep waits as long as logind allows (it never goes
# on early because a lock screen was slow)
lock_now() {
    state=$(lock_state)
    if [ "$state" = yes ]; then
        log "already locked"
        return 0
    fi
    l=$(locker)
    [ -n "$l" ] || { log "no lock screen installed"; return 1; }
    log "starting the lock screen ($l)"
    : > "$LOCK_LOG" 2>/dev/null
    $l > "$LOCK_LOG" 2>&1 9>&- &
    limit=$(delay_tenths)
    i=0
    while [ "$i" -lt "$limit" ]; do
        case "$state" in
            unknown)
                # a compositor without "locked": infynitae-lock's own confirmation, else a moment
                case "$l" in
                    *infynitae-lock*) grep -q "Screen locked" "$LOCK_LOG" 2>/dev/null && break ;;
                    *) [ "$i" -ge 10 ] && break ;;
                esac
                ;;
            *) [ "$(lock_state)" = yes ] && { log "lock confirmed"; return 0; } ;;
        esac
        sleep 0.1
        i=$((i + 1))
    done
    if [ "$state" = unknown ] && [ "$i" -lt "$limit" ]; then
        log "lock confirmed by the lock screen"
        return 0
    fi
    log "no confirmation in time: the sleep waits for logind's limit ($(tail -1 "$LOCK_LOG" 2>/dev/null))"
    return 1
}

# the background job becomes the monitor itself (exec): $MON is then gdbus, ended by `end`, and
# no subshell of this script (which a stop would end without its trap) is left holding it
monitor() {
    if [ -n "${INFYNITAE_SLEEP_MONITOR:-}" ]; then
        exec sh -c "$INFYNITAE_SLEEP_MONITOR"
    else
        exec gdbus monitor --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1
    fi
}

command -v systemd-inhibit >/dev/null 2>&1 || exit 0
log "started (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset})"
take
# the monitor in the background, its lines through a FIFO: a signal ends the script at once
FIFO="$STATE_DIR/sleep-lock.$$"
rm -f "$FIFO"
mkfifo "$FIFO" || exit 1
monitor > "$FIFO" 2>/dev/null 9>&- &
MON=$!
exec 3< "$FIFO"
rm -f "$FIFO"
while IFS= read -r line <&3; do
    case "$line" in
        *PrepareForSleep*true*)
            log "sleep announced"
            if lock_now; then
                log "letting the sleep go on"
                release
            fi
            ;;
        *PrepareForSleep*false*)
            log "woke up"
            take
            ;;
    esac
done
end
