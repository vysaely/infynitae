#!/bin/sh
# infynitae-sleep-lock: the screen is locked before the machine sleeps (the lid, the power button,
# a menu), so it wakes at the lock screen. infynitae-bus-watch (live/bus-watch) holds a logind
# "delay" sleep inhibitor and runs this script for each step:
#   infynitae-sleep-lock start: at the session's start (the log)
#   infynitae-sleep-lock sleep: sleep is announced (PrepareForSleep true). It starts the lock
#     screen and waits until the compositor says the session is locked (the shell snapshot); it
#     exits 0 once it is, and the watcher then lets the sleep go on. Otherwise it exits 1: the
#     inhibitor is kept until logind's own limit.
#   infynitae-sleep-lock wake: after the wake (PrepareForSleep false); the watcher then takes the
#     inhibitor again

# the checkout these scripts run from: the one install.sh recorded, else ~/infynitae
INFYNITAE_DIR=; { IFS= read -r INFYNITAE_DIR < "$HOME/.config/infynitae/checkout"; } 2>/dev/null || :
INFYNITAE_DIR="${INFYNITAE_DIR:-$HOME/infynitae}"
set -u
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/infynitae"
LOCK_LOG="$STATE_DIR/lock.log"
LOG="$STATE_DIR/sleep-lock.log"
mkdir -p "$STATE_DIR"
for _r in "$(dirname "$0")/log-rotate.sh" "$INFYNITAE_DIR/live/log-rotate.sh"; do
    [ -f "$_r" ] && { . "$_r"; break; }
done
unset _r
log() {
    printf '%s %s\n' "$(date '+%F %T.%3N')" "$*" >> "$LOG" 2>/dev/null || true
}

locker() {
    case "${SCREEN_LOCKER:-auto}" in
        auto | "")
            for l in "$HOME/.local/bin/infynitae-lock" "$INFYNITAE_DIR/live/lock/infynitae-lock"; do
                [ -x "$l" ] && { echo "$l"; return; }
            done
            command -v infynitae-lock 2>/dev/null
            ;;
        *) echo "$SCREEN_LOCKER" ;;
    esac
}

# Whether the session is locked, as the compositor says (the shell snapshot's "locked"): yes,
# no, or unknown (a compositor from before the field, or no answer). Never a process name: any
# program can call itself infynitae-lock.
INF_BIN="${INFYNITAE_BIN:-$HOME/.local/bin/infynitae}"
lock_state() {
    snap=$("$INF_BIN" msg snapshot 2>/dev/null) || { echo unknown; return; }
    case "$snap" in
        *'"locked":true'*) echo yes ;;
        *'"locked":false'*) echo no ;;
        *) echo unknown ;;
    esac
}

# logind waits for the inhibitor at most InhibitDelayMaxSec (5 s by default): that long, in
# tenths of a second, less one so the last check comes before it
delay_tenths() {
    us=$(busctl get-property org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager InhibitDelayMaxUSec 2>/dev/null | awk '{print $2}')
    case "$us" in
        '' | *[!0-9]*) echo 49 ;;
        *) t=$((us / 100000 - 1)); [ "$t" -gt 0 ] && echo "$t" || echo 49 ;;
    esac
}

# the lock screen up, then the sleep may go on. Returns 0 once the lock is confirmed; 1 when it
# is not: the inhibitor is then kept, so the sleep waits as long as logind allows (it never goes
# on early because a lock screen was slow)
lock_now() {
    state=$(lock_state)
    if [ "$state" = yes ]; then
        log "already locked"
        return 0
    fi
    # the compositor locks itself at once (black and locked within a frame) and starts the lock
    # screen; the sleep then never waits on a lock screen's start-up, and logind's few seconds can
    # never run out with the session open (2026-11-06; a compositor without `msg lock` refuses it)
    if "$INF_BIN" msg lock >/dev/null 2>&1 && [ "$(lock_state)" = yes ]; then
        log "locked by the compositor"
        return 0
    fi
    l=$(locker)
    [ -n "$l" ] || { log "no lock screen installed"; return 1; }
    log "starting the lock screen ($l)"
    : > "$LOCK_LOG" 2>/dev/null
    $l > "$LOCK_LOG" 2>&1 &
    lpid=$!
    limit=$(delay_tenths)
    i=0
    while [ "$i" -lt "$limit" ]; do
        case "$state" in
            unknown)
                # a compositor without "locked": infynitae-lock's own confirmation, else the lock
                # screen still running after a second (one that exited or crashed confirms nothing)
                case "$l" in
                    *infynitae-lock*) grep -q "Screen locked" "$LOCK_LOG" 2>/dev/null && break ;;
                    *) if [ "$i" -ge 10 ]; then
                           kill -0 "$lpid" 2>/dev/null && break
                           log "the lock screen exited ($(tail -1 "$LOCK_LOG" 2>/dev/null)): the sleep waits for logind's limit"
                           return 1
                       fi ;;
                esac
                ;;
            *) [ "$(lock_state)" = yes ] && { log "lock confirmed"; return 0; } ;;
        esac
        sleep 0.1
        i=$((i + 1))
    done
    if [ "$state" = unknown ] && [ "$i" -lt "$limit" ]; then
        log "lock confirmed by the lock screen"
        return 0
    fi
    log "no confirmation in time: the sleep waits for logind's limit ($(tail -1 "$LOCK_LOG" 2>/dev/null))"
    return 1
}

case "${1:-}" in
    start)
        rotate_log "$LOG"
        log "started (WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-unset})"
        ;;
    sleep)
        log "sleep announced"
        lock_now || exit 1
        log "letting the sleep go on"
        ;;
    wake)
        log "woke up"
        ;;
    *)
        echo "usage: infynitae-sleep-lock start|sleep|wake (run by infynitae-bus-watch)" >&2
        exit 2
        ;;
esac
