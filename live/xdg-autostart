#!/bin/sh
# xdg-autostart: starts the apps that asked to start with the session (an app's "start on login"
# writes ~/.config/autostart/NAME.desktop), as every desktop does (the XDG Autostart spec). Owner,
# 2026-11-06: only ~/.config/infynitae/autostart.sh ran, so these were ignored.
#
# Read: $XDG_CONFIG_HOME/autostart (else ~/.config/autostart), then each $XDG_CONFIG_DIRS/autostart
# (else /etc/xdg/autostart); a user file hides the system file of the same name. Skipped: Hidden
# or X-GNOME-Autostart-enabled=false, OnlyShowIn without one of $XDG_CURRENT_DESKTOP's names,
# NotShowIn with one, a TryExec that is not there, a Type other than Application. Field codes
# (%U, %f…) are dropped from Exec. --dry-run prints the commands instead (tools/test-xdg-autostart).
#
# The desktop journal (live/journal.sh) gets each entry that starts and was not there at the last
# session start (autostart-added), and each that is gone (autostart-removed); the user's
# ~/.config/infynitae/autostart.sh counts by its checksum. The list is kept in
# $XDG_STATE_HOME/infynitae/journal/autostart.last. A dry run changes neither.

# the checkout these scripts run from: the one install.sh recorded, else ~/infynitae
INFYNITAE_DIR=; { IFS= read -r INFYNITAE_DIR < "$HOME/.config/infynitae/checkout"; } 2>/dev/null || :
INFYNITAE_DIR="${INFYNITAE_DIR:-$HOME/infynitae}"
set -u
dry=false
[ "${1:-}" = "--dry-run" ] && dry=true

desktops=":${XDG_CURRENT_DESKTOP:-infynitae}:"
dirs="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
old_ifs=$IFS
IFS=:
for d in ${XDG_CONFIG_DIRS:-/etc/xdg}; do dirs="$dirs:$d/autostart"; done
IFS=$old_ifs

seen=" "
listed=""
IFS=:
for dir in $dirs; do
    IFS=$old_ifs
    [ -d "$dir" ] || continue
    for f in "$dir"/*.desktop; do
        [ -f "$f" ] || continue
        name=${f##*/}
        case "$seen" in *" $name "*) continue ;; esac
        seen="$seen$name "
        # the [Desktop Entry] group's keys, unlocalised
        cmd=$(awk -v desktops="$desktops" '
            /^\[/ { group = $0; next }
            group != "[Desktop Entry]" { next }
            /^[A-Za-z0-9-]+=/ {
                k = substr($0, 1, index($0, "=") - 1); v = substr($0, index($0, "=") + 1)
                if (!(k in kv)) kv[k] = v
            }
            function shown(list,    n, i, a) {
                n = split(list, a, ";")
                for (i = 1; i <= n; i++) if (a[i] != "" && index(desktops, ":" tolower(a[i]) ":")) return 1
                return 0
            }
            END {
                if (("Type" in kv) && kv["Type"] != "Application") exit
                if (tolower(kv["Hidden"]) == "true" || tolower(kv["X-GNOME-Autostart-enabled"]) == "false") exit
                if (("OnlyShowIn" in kv) && !shown(tolower(kv["OnlyShowIn"]))) exit
                if (("NotShowIn" in kv) && shown(tolower(kv["NotShowIn"]))) exit
                e = kv["Exec"]
                gsub(/ ?%[fFuUdDnNickvm]/, "", e)
                gsub(/%%/, "%", e)
                if (e == "") exit
                print (("TryExec" in kv) ? kv["TryExec"] : "") "\t" e
            }' "$f")
        [ -n "$cmd" ] || continue
        try=${cmd%%"	"*}
        exec_line=${cmd#*"	"}
        if [ -n "$try" ]; then
            case "$try" in
                /*) [ -x "$try" ] || continue ;;
                *) command -v "$try" >/dev/null 2>&1 || continue ;;
            esac
        fi
        listed="$listed$f: $exec_line
"
        if $dry; then
            printf '%s\n' "$exec_line"
        else
            sh -c "$exec_line" >/dev/null 2>&1 &
        fi
    done
    IFS=:
done
IFS=$old_ifs

$dry && exit 0
for _r in "$(dirname "$0")/journal.sh" "$INFYNITAE_DIR/live/journal.sh"; do
    [ -f "$_r" ] && { . "$_r"; break; }
done
script="$HOME/.config/infynitae/autostart.sh"
[ -x "$script" ] && listed="$listed$script: cksum $(cksum < "$script" | cut -d ' ' -f 1)
"
last="${XDG_STATE_HOME:-$HOME/.local/state}/infynitae/journal/autostart.last"
before=$(cat "$last" 2>/dev/null || true)
printf '%s' "$listed" | while IFS= read -r line; do
    printf '%s\n' "$before" | grep -Fxq -- "$line" || journal_write autostart-added "" "$line" new
done
printf '%s\n' "$before" | while IFS= read -r line; do
    [ -n "$line" ] || continue
    printf '%s' "$listed" | grep -Fxq -- "$line" || journal_write autostart-removed "" "$line" gone
done
mkdir -p "${last%/*}" && printf '%s' "$listed" > "$last.tmp" && mv -f "$last.tmp" "$last"
exit 0
