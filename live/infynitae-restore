#!/usr/bin/env python3
"""Infynitae Session Restore Helper.

Manages saving and restoring canvas sessions across compositor restarts:
  watch:    Periodically snapshots mapped windows and camera centres to session.json.
  restore:  Relaunches saved apps and places windows at their saved canvas positions.
  selftest: Self-contained test suite verifying desktop lookup and session restore matching.
  check:    Exits 0 if session.json has at least one window whose app can be launched (a desktop
            file whose command is installed), 1 otherwise.
"""

import json
import os
import re
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time

_req_counter = 0


def next_req_id():
    global _req_counter
    _req_counter += 1
    return _req_counter


def get_socket_path():
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime_dir:
        runtime_dir = f"/run/user/{os.getuid()}"
    return os.path.join(runtime_dir, "infynitae", "shell.sock")


def send_request(req_obj, sock_path=None):
    if sock_path is None:
        sock_path = get_socket_path()
    if not os.path.exists(sock_path):
        return {"ok": False, "error": "socket_not_found", "path": sock_path}
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(sock_path)
        payload = json.dumps(req_obj) + "\n"
        sock.sendall(payload.encode("utf-8"))

        buf = b""
        while b"\n" not in buf:
            chunk = sock.recv(4096)
            if not chunk:
                break
            buf += chunk
        sock.close()

        line = buf.split(b"\n")[0].decode("utf-8", errors="replace").strip()
        if not line:
            return {"ok": False, "error": "empty_response"}
        return json.loads(line)
    except Exception as e:
        return {"ok": False, "error": str(e)}


def log_restore(message, log_file=None):
    if log_file is None:
        log_file = os.path.expanduser("~/.local/state/infynitae/restore.log")
    try:
        os.makedirs(os.path.dirname(log_file), exist_ok=True)
        ts = time.strftime("%Y-%m-%d %H:%M:%S")
        with open(log_file, "a", encoding="utf-8") as f:
            f.write(f"[{ts}] {message}\n")
    except Exception:
        pass


def save_session_file(session_data, session_path=None):
    if session_path is None:
        session_path = os.path.expanduser("~/.local/state/infynitae/session.json")
    state_dir = os.path.dirname(session_path)
    os.makedirs(state_dir, exist_ok=True)
    temp_path = f"{session_path}.tmp.{os.getpid()}"
    try:
        with open(temp_path, "w", encoding="utf-8") as f:
            json.dump(session_data, f, indent=2)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(temp_path, session_path)
    finally:
        if os.path.exists(temp_path):
            try:
                os.remove(temp_path)
            except OSError:
                pass


def take_and_save_snapshot(session_path=None, ipc_fn=send_request):
    res = ipc_fn({"id": next_req_id(), "cmd": "snapshot"})
    if not isinstance(res, dict) or not res.get("ok"):
        return False
    snapshot = res.get("snapshot")
    if not isinstance(snapshot, dict):
        return False

    windows = []
    for elem in snapshot.get("elements", []):
        if not isinstance(elem, dict):
            continue
        if elem.get("state") != "mapped":
            continue
        app_id = elem.get("app_id")
        if not app_id:
            continue
        windows.append({
            "app_id": app_id,
            "title": elem.get("title"),
            "anchor": elem.get("anchor"),
            "size": elem.get("size"),
            "fullscreen": elem.get("fullscreen"),
        })

    outputs = []
    for out in snapshot.get("outputs", []):
        if not isinstance(out, dict):
            continue
        out_id = out.get("id")
        camera = out.get("camera")
        center = None
        if isinstance(camera, dict):
            center = camera.get("center")
        outputs.append({
            "id": out_id,
            "center": center,
        })

    session_data = {
        "windows": windows,
        "outputs": outputs,
    }
    save_session_file(session_data, session_path=session_path)
    return True


def cmd_watch(session_path=None, ipc_fn=send_request, interval=15.0):
    stop_requested = False

    def on_signal(signum, frame):
        nonlocal stop_requested
        stop_requested = True

    signal.signal(signal.SIGTERM, on_signal)
    signal.signal(signal.SIGINT, on_signal)

    while not stop_requested:
        start_t = time.time()
        while time.time() - start_t < interval:
            if stop_requested:
                break
            time.sleep(0.2)
        if not stop_requested:
            take_and_save_snapshot(session_path=session_path, ipc_fn=ipc_fn)

    # No snapshot on SIGTERM: the session is ending and its windows are already closing, so it
    # would overwrite the last good file with a partial one.


def parse_desktop_file(path):
    """Parses [Desktop Entry] section of a .desktop file."""
    entry = {}
    in_desktop_entry = False
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("[") and line.endswith("]"):
                    in_desktop_entry = (line == "[Desktop Entry]")
                    continue
                if in_desktop_entry and "=" in line:
                    key, val = line.split("=", 1)
                    key = key.strip().lower()
                    val = val.strip()
                    if key not in entry:
                        entry[key] = val
    except Exception:
        pass
    return entry


def clean_exec(exec_str):
    """Removes field codes %u, %U, %f, %F, %i, %c, %k and returns command argument list."""
    tokens = shlex.split(exec_str)
    codes = {"%u", "%U", "%f", "%F", "%i", "%c", "%k"}
    res = []
    for t in tokens:
        if t in codes:
            continue
        cleaned = re.sub(r"%[uUfFick]", "", t)
        if cleaned:
            res.append(cleaned)
    return res


def find_desktop_file(app_id, apps_dirs=None):
    """Finds matching desktop file by basename or StartupWMClass (case-insensitive)."""
    if apps_dirs is None:
        apps_dirs = [
            os.path.expanduser("~/.local/share/applications"),
            "/usr/share/applications",
        ]
    target = app_id.lower()
    if target.endswith(".desktop"):
        target = target[:-8]

    # Pass 1: Basename match (basename without .desktop == app_id, case-insensitive)
    for d in apps_dirs:
        if not os.path.isdir(d):
            continue
        for root, _, files in os.walk(d):
            for f in sorted(files):
                if not f.endswith(".desktop"):
                    continue
                base = f[:-8].lower()
                if base == target:
                    entry = parse_desktop_file(os.path.join(root, f))
                    if "exec" in entry:
                        return entry["exec"]

    # Pass 2: StartupWMClass match (StartupWMClass == app_id, case-insensitive)
    for d in apps_dirs:
        if not os.path.isdir(d):
            continue
        for root, _, files in os.walk(d):
            for f in sorted(files):
                if not f.endswith(".desktop"):
                    continue
                entry = parse_desktop_file(os.path.join(root, f))
                if entry.get("startupwmclass", "").lower() == target:
                    if "exec" in entry:
                        return entry["exec"]

    return None


def resolve_app_command(app_id, apps_dirs=None):
    raw_exec = find_desktop_file(app_id, apps_dirs=apps_dirs)
    if not raw_exec:
        return None
    args = clean_exec(raw_exec)
    return args if args else None


def default_launch_app(app_id, cmd_args, log_file=None):
    if log_file is None:
        log_file = os.path.expanduser("~/.local/state/infynitae/restore.log")
    try:
        os.makedirs(os.path.dirname(log_file), exist_ok=True)
        # the app's own output is not the restore's: it would flood restore.log
        subprocess.Popen(
            cmd_args,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception as e:
        log_restore(f"Error launching {app_id} ({cmd_args}): {e}", log_file=log_file)


def cmd_restore(
    session_path=None,
    apps_dirs=None,
    ipc_fn=send_request,
    launch_fn=None,
    log_file=None,
    poll_timeout=60.0,
    poll_interval=0.2,
    relaunch_after=8.0,
):
    if session_path is None:
        session_path = os.path.expanduser("~/.local/state/infynitae/session.json")
    if log_file is None:
        log_file = os.path.expanduser("~/.local/state/infynitae/restore.log")
    if launch_fn is None:
        launch_fn = default_launch_app

    if not os.path.isfile(session_path):
        log_restore(f"Session file not found: {session_path}", log_file=log_file)
        return

    try:
        with open(session_path, "r", encoding="utf-8") as f:
            session_data = json.load(f)
    except Exception as e:
        log_restore(f"Failed to load session file {session_path}: {e}", log_file=log_file)
        return

    saved_windows = session_data.get("windows", [])
    saved_outputs = session_data.get("outputs", [])

    if not saved_windows:
        log_restore("No saved windows found in session", log_file=log_file)
        for out in saved_outputs:
            out_id = out.get("id")
            center = out.get("center")
            if out_id is not None and center is not None:
                ipc_fn({
                    "id": next_req_id(),
                    "cmd": "navigate",
                    "output": out_id,
                    "to": {"canvas": center},
                })
        return

    # 1. Launch each distinct app_id once. An app that opens one window per launch (a terminal)
    # is launched again in the poll loop while it still has windows to place; one that reopens
    # its own windows (a browser) brings them all within RELAUNCH_AFTER and is not.
    apps = {}  # app_id.lower() -> {"cmd", "saved", "launches", "last"}
    for win in saved_windows:
        app_id = win.get("app_id")
        if not app_id:
            continue
        key = app_id.lower()
        if key in apps:
            apps[key]["saved"] += 1
            continue
        cmd_args = resolve_app_command(app_id, apps_dirs=apps_dirs)
        if not cmd_args:
            log_restore(f"Skip {app_id}: no desktop file found", log_file=log_file)
            continue
        apps[key] = {"cmd": cmd_args, "saved": 1, "launches": 1, "last": time.time()}
        log_restore(f"Launch {app_id}: {cmd_args}", log_file=log_file)
        launch_fn(app_id, cmd_args, log_file=log_file)

    # 2. Poll snapshots for up to 60 s and place matching windows
    # only windows of apps that were launched can come back: waiting for the others would hold
    # the camera's return until the timeout
    pending_saved = [
        w
        for w in saved_windows
        if w.get("app_id") and w.get("anchor") is not None and w["app_id"].lower() in apps
    ]
    placed_element_ids = set()

    start_time = time.time()
    while time.time() - start_time < poll_timeout:
        if not pending_saved:
            break

        res = ipc_fn({"id": next_req_id(), "cmd": "snapshot"})
        if isinstance(res, dict) and res.get("ok"):
            snapshot = res.get("snapshot", {})
            elements = snapshot.get("elements", [])
            for elem in elements:
                if not isinstance(elem, dict):
                    continue
                elem_id_raw = elem.get("id")
                if not isinstance(elem_id_raw, list) or len(elem_id_raw) < 2:
                    continue
                elem_id = (elem_id_raw[0], elem_id_raw[1])
                if elem_id in placed_element_ids:
                    continue
                if elem.get("state") != "mapped":
                    continue

                placed_element_ids.add(elem_id)
                app_id = elem.get("app_id")
                if not app_id:
                    continue

                # Match against saved windows of this app in their saved order
                target_idx = None
                for idx, sw in enumerate(pending_saved):
                    s_app = sw.get("app_id")
                    if s_app and (s_app == app_id or s_app.lower() == app_id.lower()):
                        target_idx = idx
                        break

                if target_idx is not None:
                    target_win = pending_saved.pop(target_idx)
                    if app_id.lower() in apps:
                        apps[app_id.lower()]["last"] = time.time()
                    anchor = target_win.get("anchor")
                    if anchor is not None:
                        log_restore(
                            f"Moving {app_id} (element {elem_id_raw}) to {anchor}",
                            log_file=log_file,
                        )
                        ipc_fn({
                            "id": next_req_id(),
                            "cmd": "move_element",
                            "element": elem_id_raw,
                            "to": anchor,
                        })

        # an app with windows still to place and no news for RELAUNCH_AFTER: launch it again
        now = time.time()
        for key, app in apps.items():
            waiting = sum(1 for w in pending_saved if w.get("app_id", "").lower() == key)
            if waiting and app["launches"] < app["saved"] and now - app["last"] >= relaunch_after:
                app["launches"] += 1
                app["last"] = now
                log_restore(f"Launch {key} again ({waiting} window(s) to place)", log_file=log_file)
                launch_fn(key, app["cmd"], log_file=log_file)

        time.sleep(poll_interval)

    # 3. Finally navigate each output's camera back to its saved centre
    for out in saved_outputs:
        out_id = out.get("id")
        center = out.get("center")
        if out_id is not None and center is not None:
            log_restore(f"Navigating output {out_id} to {center}", log_file=log_file)
            ipc_fn({
                "id": next_req_id(),
                "cmd": "navigate",
                "output": out_id,
                "to": {"canvas": center},
            })


def check_saved_session(session_path=None, apps_dirs=None, launchable=False):
    """The saved session has a window; with `launchable`, one whose app restore can start (a
    desktop file whose command is installed). The session script starts its default terminal
    unless a restore would bring something back."""
    if session_path is None:
        session_path = os.path.expanduser("~/.local/state/infynitae/session.json")
    if not os.path.isfile(session_path):
        return False
    try:
        with open(session_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        windows = data.get("windows")
        if not isinstance(windows, list) or not windows:
            return False
    except Exception:
        return False
    if not launchable:
        return True
    for app_id in {w.get("app_id") for w in windows if isinstance(w, dict) and w.get("app_id")}:
        cmd = resolve_app_command(app_id, apps_dirs=apps_dirs)
        if cmd and shutil.which(cmd[0]):
            return True
    return False


def cmd_selftest():
    """Runs self-test verifying desktop lookup and save/restore matching."""
    with tempfile.TemporaryDirectory() as tmp_dir:
        apps_dir = os.path.join(tmp_dir, "applications")
        os.makedirs(apps_dir, exist_ok=True)
        session_file = os.path.join(tmp_dir, "session.json")
        log_file = os.path.join(tmp_dir, "restore.log")

        # 1. Test desktop-file lookup
        # 1a. Basename match + field codes removal
        term_desktop = os.path.join(apps_dir, "my-term.desktop")
        with open(term_desktop, "w") as f:
            f.write(
                "[Desktop Entry]\n"
                "Type=Application\n"
                "Name=My Terminal\n"
                "Exec=my-term -e %f %F\n"
            )

        cmd = resolve_app_command("MY-TERM", apps_dirs=[apps_dir])
        assert cmd == ["my-term", "-e"], f"Expected ['my-term', '-e'], got {cmd}"

        # 1b. StartupWMClass match + field codes removal
        browser_desktop = os.path.join(apps_dir, "special-browser.desktop")
        with open(browser_desktop, "w") as f:
            f.write(
                "[Desktop Entry]\n"
                "Type=Application\n"
                "Name=Web Browser\n"
                "StartupWMClass=Special-Browser-WM\n"
                "Exec=browser-bin %u %U %k %c %i --profile default\n"
            )

        cmd = resolve_app_command("special-browser-wm", apps_dirs=[apps_dir])
        assert cmd == ["browser-bin", "--profile", "default"], (
            f"Expected ['browser-bin', '--profile', 'default'], got {cmd}"
        )

        # 1c. App with no desktop file
        assert resolve_app_command("nonexistent-app", apps_dirs=[apps_dir]) is None

        # 2. Test snapshot saving (mapped windows with app_id and camera centres)
        fake_snapshot_payload = {
            "id": 1,
            "ok": True,
            "snapshot": {
                "outputs": [
                    {"id": 1, "camera": {"center": [500.0, 600.0]}}
                ],
                "elements": [
                    {
                        "id": [1, 1],
                        "state": "mapped",
                        "app_id": "demo-app",
                        "title": "Window 1",
                        "anchor": [10.0, 20.0],
                        "size": [100.0, 100.0],
                        "fullscreen": None,
                    },
                    {
                        "id": [1, 2],
                        "state": "unmapped",
                        "app_id": "demo-app",
                        "title": "Unmapped",
                        "anchor": [0.0, 0.0],
                    },
                    {
                        "id": [1, 3],
                        "state": "mapped",
                        "app_id": None,
                        "title": "No app_id",
                        "anchor": [0.0, 0.0],
                    },
                    {
                        "id": [1, 4],
                        "state": "mapped",
                        "app_id": "demo-app",
                        "title": "Window 2",
                        "anchor": [30.0, 40.0],
                        "size": [100.0, 100.0],
                        "fullscreen": None,
                    },
                ],
            },
        }

        save_ok = take_and_save_snapshot(
            session_path=session_file,
            ipc_fn=lambda req: fake_snapshot_payload,
        )
        assert save_ok, "take_and_save_snapshot should return True on success"
        assert check_saved_session(session_file), "check_saved_session should return True"
        # demo-app has no desktop file: nothing a restore could launch
        assert not check_saved_session(session_file, apps_dirs=[apps_dir], launchable=True), (
            "a session with no launchable app counted as restorable"
        )
        other_apps = os.path.join(tmp_dir, "other-applications")
        os.makedirs(other_apps, exist_ok=True)
        with open(os.path.join(other_apps, "demo-app.desktop"), "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=Demo\nExec=sh -c true\n")
        assert check_saved_session(session_file, apps_dirs=[other_apps], launchable=True), (
            "a session with an installed app did not count as restorable"
        )

        with open(session_file, "r") as f:
            saved_data = json.load(f)
        assert len(saved_data.get("windows", [])) == 2, (
            f"Expected 2 saved windows, got {len(saved_data.get('windows', []))}"
        )
        assert saved_data["windows"][0]["anchor"] == [10.0, 20.0]
        assert saved_data["windows"][1]["anchor"] == [30.0, 40.0]
        assert saved_data["outputs"][0]["center"] == [500.0, 600.0]

        # 2b. Write nothing when snapshot fails
        failed_save = take_and_save_snapshot(
            session_path=session_file,
            ipc_fn=lambda req: {"ok": False, "error": "socket_closed"},
        )
        assert not failed_save, "take_and_save_snapshot should return False on failure"
        # Confirm old file data is untouched
        with open(session_file, "r") as f:
            untouched_data = json.load(f)
        assert len(untouched_data.get("windows", [])) == 2

        # 3. Test save/restore matching (two saved windows of one app placed in order, unknown app skipped)
        demo_desktop = os.path.join(apps_dir, "demo-app.desktop")
        with open(demo_desktop, "w") as f:
            f.write(
                "[Desktop Entry]\n"
                "Type=Application\n"
                "Name=Demo App\n"
                "Exec=demo-app-bin\n"
            )

        # Prepare saved session with:
        # - Two windows of demo-app
        # - One window of app-without-desktop
        # - Output camera
        test_session = {
            "windows": [
                {
                    "app_id": "demo-app",
                    "title": "Win 1",
                    "anchor": [100.0, 200.0],
                    "size": [800.0, 600.0],
                    "fullscreen": None,
                },
                {
                    "app_id": "demo-app",
                    "title": "Win 2",
                    "anchor": [300.0, 400.0],
                    "size": [800.0, 600.0],
                    "fullscreen": None,
                },
                {
                    "app_id": "app-without-desktop",
                    "title": "Win 3",
                    "anchor": [50.0, 50.0],
                    "size": [400.0, 300.0],
                    "fullscreen": None,
                },
            ],
            "outputs": [
                {"id": 1, "center": [1200.0, 800.0]}
            ],
        }
        with open(session_file, "w") as f:
            json.dump(test_session, f)

        launched_apps = []
        def fake_launch(app_id, cmd_args, log_file=None):
            launched_apps.append((app_id, cmd_args))

        ipc_calls = []
        def fake_ipc(req):
            ipc_calls.append(req)
            cmd = req.get("cmd")
            if cmd == "snapshot":
                return {
                    "id": req.get("id"),
                    "ok": True,
                    "snapshot": {
                        "elements": [
                            # First window of demo-app
                            {"id": [1, 101], "state": "mapped", "app_id": "demo-app"},
                            # Window of an unknown app not in session
                            {"id": [1, 102], "state": "mapped", "app_id": "unknown-app"},
                            # Second window of demo-app
                            {"id": [1, 103], "state": "mapped", "app_id": "demo-app"},
                        ],
                        "outputs": [
                            {"id": 1, "camera": {"center": [0.0, 0.0]}}
                        ],
                    },
                }
            elif cmd in ("move_element", "navigate"):
                return {"id": req.get("id"), "ok": True}
            return {"id": req.get("id"), "ok": False}

        cmd_restore(
            session_path=session_file,
            apps_dirs=[apps_dir],
            ipc_fn=fake_ipc,
            launch_fn=fake_launch,
            log_file=log_file,
            poll_timeout=1.0,
            poll_interval=0.01,
        )

        # Assert: distinct app launched once
        assert launched_apps == [("demo-app", ["demo-app-bin"])], (
            f"Expected [('demo-app', ['demo-app-bin'])], got {launched_apps}"
        )

        # Assert: app-without-desktop was skipped and logged
        with open(log_file, "r") as f:
            log_content = f.read()
        assert "Skip app-without-desktop: no desktop file found" in log_content

        # Assert: move_element calls placed two windows of demo-app in order, unknown app skipped
        moves = [c for c in ipc_calls if c.get("cmd") == "move_element"]
        assert len(moves) == 2, f"Expected 2 move_element commands, got {len(moves)}"
        assert moves[0]["element"] == [1, 101] and moves[0]["to"] == [100.0, 200.0], (
            f"First window mismatch: {moves[0]}"
        )
        assert moves[1]["element"] == [1, 103] and moves[1]["to"] == [300.0, 400.0], (
            f"Second window mismatch: {moves[1]}"
        )

        # Assert: navigate called for output camera centre
        navs = [c for c in ipc_calls if c.get("cmd") == "navigate"]
        assert len(navs) == 1, f"Expected 1 navigate command, got {len(navs)}"
        assert navs[0]["output"] == 1 and navs[0]["to"] == {"canvas": [1200.0, 800.0]}, (
            f"Navigate mismatch: {navs[0]}"
        )

        # 4. Test watch signal termination (SIGTERM graceful exit)
        watch_sub = subprocess.Popen(
            [sys.executable, os.path.abspath(__file__), "watch"],
            env={**os.environ, "XDG_RUNTIME_DIR": tmp_dir},
        )
        time.sleep(0.1)
        watch_sub.terminate()
        watch_ret = watch_sub.wait(timeout=2.0)
        assert watch_ret == 0, f"Expected watch return code 0 on SIGTERM, got {watch_ret}"

    # A terminal opens one window per launch: two saved windows need a second launch; an app
    # that reopens its own windows (two at once) is launched once.
    with tempfile.TemporaryDirectory() as tmp:
        apps_dir = os.path.join(tmp, "apps")
        os.makedirs(apps_dir)
        for name in ("term", "browser"):
            with open(os.path.join(apps_dir, f"{name}.desktop"), "w") as f:
                f.write(f"[Desktop Entry]\nType=Application\nName={name}\nExec={name}-bin\n")
        session_file = os.path.join(tmp, "session.json")
        with open(session_file, "w") as f:
            json.dump({"windows": [
                {"app_id": "term", "anchor": [0, 0]}, {"app_id": "term", "anchor": [10, 0]},
                {"app_id": "browser", "anchor": [0, 50]}, {"app_id": "browser", "anchor": [10, 50]},
            ], "outputs": []}, f)
        windows, launches, next_id = [], [], [200]
        def launch(app_id, cmd_args, log_file=None):
            launches.append(app_id)
            for _ in range(1 if app_id == "term" else 2):
                next_id[0] += 1
                windows.append({"id": [1, next_id[0]], "state": "mapped", "app_id": app_id})
        def ipc(req):
            if req.get("cmd") == "snapshot":
                return {"ok": True, "snapshot": {"elements": list(windows), "outputs": []}}
            return {"ok": True}
        cmd_restore(session_path=session_file, apps_dirs=[apps_dir], ipc_fn=ipc,
                    launch_fn=launch, log_file=os.path.join(tmp, "log"),
                    poll_timeout=1.0, poll_interval=0.01, relaunch_after=0.1)
        assert sorted(launches) == ["browser", "term", "term"], launches

    print("ok")
    sys.exit(0)


def main():
    if len(sys.argv) < 2:
        print("Usage: infynitae-restore [watch|restore|selftest|check]", file=sys.stderr)
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "watch":
        cmd_watch()
    elif cmd == "restore":
        cmd_restore()
    elif cmd == "selftest":
        cmd_selftest()
    elif cmd == "check":
        path = sys.argv[2] if len(sys.argv) > 2 else None
        sys.exit(0 if check_saved_session(path, launchable=True) else 1)
    elif cmd in ("-h", "--help"):
        print("Usage: infynitae-restore [watch|restore|selftest|check]")
        sys.exit(0)
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
