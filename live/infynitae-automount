#!/bin/sh
# infynitae-automount: USB drives and SD cards mount when plugged in, through udisks2.
# infynitae-bus-watch (live/bus-watch) watches udisks2 and runs it, one step at a time:
#   infynitae-automount scan: at the session's start, mounts drives already plugged in and unmounted
#   infynitae-automount signal LINE: one udisks2 signal, as `gdbus monitor` prints it. A filesystem
#     added on removable media is mounted with udisksctl, and a notification offers Open and Eject.
# An encrypted drive asks for its passphrase (the edge's question card, else fuzzel) and mounts
# once unlocked.
# Drives are named by Roman numeral, as Windows names them C:, D:, E: (DRIVE_NAMES="roman", the
# default; docs/DRIVES.md): a new filesystem is first given a numeral by the root helper
# infynitae-drive-name (through pkexec), which writes its line in /etc/fstab, so udisks mounts it at
# /mnt/<numeral>. A partition inside the PC gets a numeral it keeps and is not mounted; a USB drive
# or card gets its last numeral when no drive plugged in has it, else the lowest one free. Without
# the helper, or refused, a drive mounts under /run/media by its label, as DRIVE_NAMES="label".
#   infynitae-automount eject [DEVICE]: unmounts DEVICE (else every drive mounted under
#   /run/media or at a removable drive's /mnt/<numeral>), locks it if encrypted and powers the
#   drive off, so it is safe to pull
#   INFYNITAE_AUTOMOUNT_UDISKSCTL: a command used instead of udisksctl (tests)
#   INFYNITAE_AUTOMOUNT_ASK: a command printing a passphrase instead of fuzzel (tests)
#   INFYNITAE_AUTOMOUNT_MOUNTS: a mounts file instead of /proc/mounts (tests)
#   INFYNITAE_AUTOMOUNT_FSTAB: a file read instead of /etc/fstab (tests)
#   INFYNITAE_AUTOMOUNT_BY_UUID: a folder read instead of /dev/disk/by-uuid (tests)
#   INFYNITAE_AUTOMOUNT_DRIVE_NAME: a program run instead of pkexec infynitae-drive-name (tests)
set -u
if [ -f "$HOME/infynitae/live/config.sh" ]; then
    . "$HOME/infynitae/live/config.sh"
fi
# what a drive opens (the file manager) gets an app's out-of-memory score (session.sh, 1c): the
# watcher that runs this keeps the desktop's, for the lock screen it starts before sleep
oom=""
read -r oom < /proc/self/oom_score_adj 2>/dev/null || true
[ -n "$oom" ] && [ "$oom" -lt 300 ] && { echo 300 > /proc/self/oom_score_adj; } 2>/dev/null
FSTAB="${INFYNITAE_AUTOMOUNT_FSTAB:-/etc/fstab}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/infynitae"
LOG="$STATE_DIR/automount.log"
mkdir -p "$STATE_DIR"
for _r in "$(dirname "$0")/log-rotate.sh" "$HOME/infynitae/live/log-rotate.sh"; do
    [ -f "$_r" ] && { . "$_r"; break; }
done
unset _r
log() {
    printf '%s %s\n' "$(date '+%F %T.%3N')" "$*" >> "$LOG" 2>/dev/null || true
}

run_udisksctl() {
    ${INFYNITAE_AUTOMOUNT_UDISKSCTL:-udisksctl} "$@"
}

# a notification's text is plain: a drive's label is the drive's own (anything a stick says), so
# what a notification daemon would read as markup is escaped
plain() {
    printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}
notify() {
    if command -v notify-send >/dev/null 2>&1; then
        if [ "$#" -ge 2 ]; then
            notify-send -a Infynitae "$(plain "$1")" "$(plain "$2")" 2>/dev/null || true
        else
            notify-send -a Infynitae "$(plain "$1")" 2>/dev/null || true
        fi
    fi
}

# a notification with actions waits for its answer: in the background, and at most NOTIFY_WAIT
# seconds, so a server that never says it closed cannot keep it (and its
# shells) alive for hours (2026-11-24)
NOTIFY_WAIT="${NOTIFY_WAIT:-600}"
notify_actions() {
    command -v notify-send >/dev/null 2>&1 || return 0
    timeout "$NOTIFY_WAIT" notify-send -a Infynitae "$@" 2>/dev/null
}

# the device under a dm cleartext device (/dev/dm-N), else nothing
backing_device() {
    run_udisksctl info -b "$1" 2>/dev/null | awk '
    $1 == "CryptoBackingDevice:" {
        d = $2; gsub(/\047/, "", d);
        if (d != "/") {
            sub(".*/", "", d);
            gsub(/_2d/, "-", d);
            print "/dev/" d;
        }
    }'
}

# unmounts DEVICE, locks its encrypted device and powers the drive off; one notification says
# whether it can be pulled
eject_device() {
    dev="$1"
    label="${2:-$1}"
    backing=$(backing_device "$dev")
    if ! out=$(run_udisksctl unmount --no-user-interaction -b "$dev" 2>&1); then
        case "$out" in
            *NotMounted*|*"not mounted"*) ;;
            *)
                log "unmount failed for $dev: $out"
                notify "$label is still in use" "Close the files and windows open on it, then eject again."
                return 1
                ;;
        esac
    fi
    if [ -n "$backing" ]; then
        run_udisksctl lock --no-user-interaction -b "$backing" >/dev/null 2>&1 || true
    fi
    # powering off ends the drive's power and its write cache; some readers refuse it, and an
    # unmounted drive is safe to pull anyway
    run_udisksctl power-off --no-user-interaction -b "${backing:-$dev}" >/dev/null 2>&1 || true
    log "ejected $dev"
    notify "$label can be removed"
}

NUMERALS="I II III IV V VI VII VIII IX X XI XII XIII XIV XV XVI XVII XVIII XIX XX XXI XXII XXIII XXIV XXV XXVI XXVII XXVIII XXIX XXX XXXI XXXII XXXIII XXXIV XXXV XXXVI XXXVII XXXVIII XXXIX"

# The drives fstab names, one per line: where ("out" outside the block infynitae-drive-name
# writes, else the kind it gives: fixed or removable), the UUID in capitals (or -), the numeral of
# its /mnt/ folder (or -) and of its x-gvfs-name (or -)
fstab_entries() {
    awk '
    $0 == "# infynitae drives: begin" { inb = 1; next }
    $0 == "# infynitae drives: end" { inb = 0; next }
    inb && /^# (fixed|removable):/ { k = $2; sub(/:$/, "", k); next }
    /^[[:space:]]*(#|$)/ { next }
    {
        s = toupper($1); u = "-"
        if (s ~ /^UUID=/) u = substr(s, 6)
        else if (s ~ /^\/DEV\/DISK\/BY-UUID\//) u = substr(s, 19)
        m = "-"
        if ($2 ~ /^\/mnt\/[IVX]+$/) m = substr($2, 6)
        g = "-"
        o = "," $4 ","
        if (match(o, /,x-gvfs-name=[IVX]+,/)) g = substr(o, RSTART + 13, RLENGTH - 14)
        print (inb ? (k != "" ? k : "fixed") : "out"), u, m, g
        k = ""
    }' "$FSTAB" 2>/dev/null
}

if [ "${1:-}" = "eject" ]; then
    if [ -n "${2:-}" ]; then
        eject_device "$2"
        exit
    fi
    rc=0
    found=0
    user_media="/run/media/${USER:-$(id -un)}"
    # the folders of removable drives named by numeral (a fixed one is part of the PC)
    named=" $(fstab_entries | awk '$1 == "removable" && $3 != "-" { printf "/mnt/%s ", $3 }')"
    # every filesystem udisks mounted for this user
    while read -r src target _; do
        case "$target" in
            "$user_media"/*) found=1; eject_device "$src" "$(printf '%b' "${target##*/}")" || rc=1 ;;
            *)
                case "$named" in
                    *" $target "*) found=1; eject_device "$src" "${target#/mnt/}" || rc=1 ;;
                esac
                ;;
        esac
    done < "${INFYNITAE_AUTOMOUNT_MOUNTS:-/proc/mounts}"
    [ "$found" = 1 ] || notify "No drive to eject"
    exit "$rc"
fi

# what one step learns for the next ones, since each is a process of its own: the drives udisks
# calls removable, and that naming drives was refused this session (cleared by scan)
RUN_DIR="${XDG_RUNTIME_DIR:-/tmp}/infynitae"
mkdir -p "$RUN_DIR"
DRIVES_FILE="$RUN_DIR/automount.drives"
REFUSED_FILE="$RUN_DIR/automount.refused"

removable_drives=""
# fields of the parsed lines: not a tab, which `read` merges when a field (a label) is empty
SEP=$(printf '\037')

is_removable_drive() {
    drv="$1"
    [ -n "$drv" ] || return 1
    case " $removable_drives " in
        *" $drv "*) return 0 ;;
    esac
    # `info -p` takes the path below /org/freedesktop/UDisks2/ ("drives/..."): the full object
    # path is refused, so this check never ran before 2026-11-09
    drv_info=$(run_udisksctl info -p "${drv#/org/freedesktop/UDisks2/}" 2>/dev/null) || return 1
    # line by line: a pattern over the whole text matched an internal disk's "Removable: false"
    # followed by any later "true" (SmartEnabled, PmEnabled...), and mounted it (2026-11-09)
    if printf '%s\n' "$drv_info" | grep -qE '^[[:space:]]*(Media)?Removable:[[:space:]]+true[[:space:]]*$'; then
        removable_drives="$removable_drives $drv "
        return 0
    fi
    return 1
}

DRIVE_NAME_HELPER="${INFYNITAE_AUTOMOUNT_DRIVE_NAME:-/usr/local/lib/infynitae-drive-name}"
names_refused=0

# the helper as root, through pkexec (a test's own helper runs as it is)
run_drive_name() {
    if [ -n "${INFYNITAE_AUTOMOUNT_DRIVE_NAME:-}" ]; then
        "$DRIVE_NAME_HELPER" "$@"
    else
        pkexec --disable-internal-agent "$DRIVE_NAME_HELPER" "$@"
    fi
}
drive_name_installed() {
    [ -x "$DRIVE_NAME_HELPER" ] && { [ -n "${INFYNITAE_AUTOMOUNT_DRIVE_NAME:-}" ] || command -v pkexec >/dev/null 2>&1; }
}

# Gives the filesystem on $1 its Roman numeral, of kind $2 (fixed or removable), and sets
# $numeral to it; returns 1 when it gets none (it then mounts by its label under /run/media). The
# helper is asked only when the numeral, or the line, is new.
name_drive() {
    numeral=""
    case "${DRIVE_NAMES:-roman}" in
        label) return 1 ;;
    esac
    if ! nd_info=$(block_info "$1"); then
        log "no numeral for $1: udisks does not describe it"
        return 1
    fi
    IFS="$SEP" read -r nd_label _ _ _ _ nd_drive nd_uuid nd_type nd_fstab <<INFO
$nd_info
INFO
    case "$nd_type" in
        vfat | exfat | btrfs | ext4 | xfs | f2fs) nd_fs="$nd_type" ;;
        # the kernel's NTFS driver since Linux 5.15, the one udisks 2.11 tries first
        ntfs) nd_fs=ntfs3 ;;
        *)
            log "no numeral for $1: its filesystem (${nd_type:-none}) is not one named here"
            return 1
            ;;
    esac
    # Ventoy's boot partition, beside the one that holds the images
    if [ "$nd_label" = VTOYEFI ]; then
        log "no numeral for $1: Ventoy's boot partition"
        return 1
    fi
    case "$nd_uuid" in
        '' | -* | *[!0-9A-Fa-f-]*)
            log "no numeral for $1: no UUID udisks gives (${nd_uuid:-none})"
            return 1
            ;;
    esac
    # the drives plugged in now (by-uuid lists every filesystem the kernel sees)
    nd_here=$(ls -1 "${INFYNITAE_AUTOMOUNT_BY_UUID:-/dev/disk/by-uuid}" 2>/dev/null | tr '\n' ' ')
    nd_pick=$(fstab_entries | awk -v U="$nd_uuid" -v KIND="$2" -v FSTAB_LINE="$nd_fstab" \
        -v HERE="$nd_here" -v NUMS="$NUMERALS" '
    BEGIN {
        U = toupper(U)
        nh = split(toupper(HERE), h, " ")
        for (i = 1; i <= nh; i++) here[h[i]] = 1
    }
    # outside the block: named by hand, those numerals are fixed
    $1 == "out" { if ($2 == U) outside = 1; fixed[$3] = 1; fixed[$4] = 1; next }
    $2 == U { if (mine == "") { mine = $3; kind = $1 }; next }
    $1 == "fixed" { fixed[$3] = 1; fixed[$4] = 1; next }
    # a removable drive plugged in now holds its numeral; one that is out leaves it free
    ($2 in here) { taken[$3] = 1 }
    END {
        # a line of its own outside the block (udisks matches LABEL= and PARTUUID= ones too)
        if (outside || (mine == "" && FSTAB_LINE == "1")) { print "outside"; exit }
        if (mine != "" && mine != "-") {
            if (kind == "fixed" || (!(mine in fixed) && !(mine in taken))) { print mine, kind, "keep"; exit }
        } else {
            kind = KIND
        }
        n = split(NUMS, order, " ")
        for (i = 1; i <= n; i++) {
            if (!(order[i] in fixed) && !(order[i] in taken)) { print order[i], kind, "write"; exit }
        }
        print "full"
    }')
    case "$nd_pick" in
        outside)
            log "$1 keeps the name of its own line in fstab"
            return 1
            ;;
        full | '')
            log "no numeral for $1: I to XXXIX are all taken"
            return 1
            ;;
    esac
    set -- "$1" $nd_pick
    if [ "$4" = write ]; then
        if ! drive_name_installed; then
            log "no numeral for $1: $DRIVE_NAME_HELPER (or pkexec) is not installed (infynitae-update installs the helper)"
            return 1
        fi
        if [ "$names_refused" = 1 ]; then
            log "no numeral for $1: naming drives was refused earlier in this session"
            return 1
        fi
        # its note in fstab: the label, else udisks' name of the drive (vendor, model, serial)
        nd_note="$nd_label"
        [ -n "$nd_note" ] || nd_note="${nd_drive##*/}"
        nd_rc=0
        nd_out=$(run_drive_name "$nd_uuid" "$2" "$nd_fs" "$3" "$nd_note" 2>&1 </dev/null) || nd_rc=$?
        case "$nd_rc" in
            0) log "named $1 $2 ($3): $nd_out" ;;
            # pkexec: not allowed, or the password prompt dismissed; not asked again this session
            126 | 127)
                names_refused=1
                : > "$REFUSED_FILE"
                log "naming $1 $2 was refused (pkexec $nd_rc): $nd_out"
                return 1
                ;;
            *)
                log "naming $1 $2 failed: $nd_out"
                return 1
                ;;
        esac
    fi
    numeral="$2"
}

mount_device() {
    dev="$1"
    label="$2"
    [ -n "$label" ] || label="$dev"
    name_drive "$dev" removable || true

    log "mounting $dev ($label)"
    mount_out=$(run_udisksctl mount --no-user-interaction -b "$dev" 2>&1)
    mount_rc=$?

    if [ "$mount_rc" -eq 0 ]; then
        mount_path=$(printf '%s\n' "$mount_out" | sed -n 's/^Mounted .* at \(.*\)\./\1/p')
        [ -z "$mount_path" ] && mount_path=$(printf '%s\n' "$mount_out" | sed -n 's/^Mounted .* at //p')
        [ -z "$mount_path" ] && mount_path="$mount_out"
        log "mounted $dev at $mount_path"
        # Open shows it in the file manager, Eject makes it safe to pull (in the background:
        # the notification waits for its answer). A drive at its numeral's folder is called by
        # the numeral, its label below it.
        name="$label"
        set -- -A open=Open -A eject=Eject "$(plain "$label mounted at $mount_path")"
        if [ -n "$numeral" ] && [ "$mount_path" = "/mnt/$numeral" ]; then
            name="$numeral"
            set -- -A open=Open -A eject=Eject "$(plain "$numeral mounted")" "$(plain "$label")"
        fi
        (
            case $(notify_actions "$@") in
                open) xdg-open "$mount_path" >/dev/null 2>&1 ;;
                eject) eject_device "$dev" "$name" ;;
            esac
        ) &
    else
        log "mount failed for $dev: $mount_out"
        notify "Mount failed for $label" "$mount_out"
    fi
}

edge_bin() {
    if command -v infynitae-edge >/dev/null 2>&1; then
        command -v infynitae-edge
    elif [ -x "$HOME/.local/bin/infynitae-edge" ]; then
        printf '%s\n' "$HOME/.local/bin/infynitae-edge"
    else
        return 1
    fi
}

# only an edge that says it supports ask is asked: an older one takes "ask" as a reason to restart
edge_can_ask() {
    [ -n "${XDG_RUNTIME_DIR:-}" ] && cat "$XDG_RUNTIME_DIR/infynitae-edge.features" \
        "$XDG_RUNTIME_DIR/infynitae-edge-rs.features" 2>/dev/null | grep -qx ask \
        && edge_bin >/dev/null
}

# the passphrase for an encrypted drive, from the edge's question card or fuzzel (empty: cancelled;
# exit 3: no prompt could be shown)
ask_passphrase() {
    if [ -n "${INFYNITAE_AUTOMOUNT_ASK:-}" ]; then
        sh -c "$INFYNITAE_AUTOMOUNT_ASK"
        return $?
    fi
    if edge_can_ask && edge=$(edge_bin); then
        rc=0
        "$edge" ask --text --secret "$1" </dev/null 2>/dev/null || rc=$?
        [ "$rc" = 3 ] || return "$rc"
    fi
    if command -v fuzzel >/dev/null 2>&1 && [ -n "${WAYLAND_DISPLAY:-}" ]; then
        rc=0
        fuzzel --dmenu --password --lines 0 --prompt-only "$1: " </dev/null 2>/dev/null || rc=$?
        [ "$rc" = 3 ] && rc=1
        return "$rc"
    fi
    return 3
}

# an encrypted partition on a removable drive: its passphrase asked (three tries), the cleartext
# device then mounted like any other. In the background: the prompt waits for the user.
unlock_device() {
    dev="$1"
    label="$2"
    [ -n "$label" ] || label="$dev"
    (
        tries=0
        while [ "$tries" -lt 3 ]; do
            tries=$((tries + 1))
            ask_rc=0
            pass=$(ask_passphrase "Passphrase for $label") || ask_rc=$?
            if [ -z "$pass" ]; then
                if [ "$tries" -eq 1 ] && [ "$ask_rc" = 3 ]; then
                    notify "$label is encrypted" "Unlock it with: udisksctl unlock -b $dev"
                fi
                log "unlock of $dev cancelled"
                exit 0
            fi
            # the passphrase goes through a pipe, never the command line (ps would show it)
            if out=$(printf '%s' "$pass" | run_udisksctl unlock --no-user-interaction -b "$dev" --key-file /dev/stdin 2>&1); then
                clear=$(printf '%s\n' "$out" | sed -n 's/^Unlocked .* as \(.*\)\.$/\1/p')
                log "unlocked $dev as ${clear:-?}"
                [ -n "$clear" ] && mount_device "$clear" "$label"
                exit 0
            fi
            log "unlock failed for $dev: $out"
            case "$out" in
                *AlreadyUnlocked*|*"already unlocked"*) exit 0 ;;
            esac
            notify "Wrong passphrase for $label"
        done
    ) &
}

handle_block() {
    dev="$1"
    label="$2"
    hint_auto="$3"
    hint_sys="$4"
    hint_ign="$5"
    is_mounted="$6"
    drv="$7"

    if [ "$is_mounted" = "1" ]; then
        log "ignoring $dev (already mounted)"
        return 0
    fi
    if [ "$hint_ign" = "true" ]; then
        log "ignoring $dev (HintIgnore is set)"
        return 0
    fi
    removable=0
    if [ "$hint_auto" = "true" ] || is_removable_drive "$drv"; then
        removable=1
    fi
    # a partition inside the PC (udisks calls every one a system device) is not mounted here: it
    # gets the numeral it keeps, and a file manager opens it at that folder
    if [ "$removable" = 0 ] && [ "${8:-}" != "encrypted" ]; then
        name_drive "$dev" fixed || true
    fi
    if [ "$hint_sys" = "true" ]; then
        log "ignoring $dev (system disk)"
        return 0
    fi

    if [ "$removable" = 1 ]; then
        if [ "${8:-}" = "encrypted" ]; then
            unlock_device "$dev" "$label"
        else
            mount_device "$dev" "$label"
        fi
    else
        log "ignoring $dev (not removable)"
    fi
}

scan_existing() {
    dump=$(run_udisksctl dump 2>/dev/null) || return 0
    [ -n "$dump" ] || return 0

    items=$(printf '%s\n' "$dump" | awk -v SEP="$SEP" '
    BEGIN {
        q = sprintf("%c", 39)
    }
    /^(\/org\/freedesktop\/UDisks2\/[a-zA-Z0-9_/]+):/ {
        obj = substr($1, 1, length($1)-1)
        # a label or a name with a line break can print lines that look like udisks own: an
        # object, section or property that comes twice, or a device two objects claim, means
        # one of them is such text, and that object is not trusted
        if (seen_obj[obj]++) bad[obj] = 1
        section = ""
    }
    /^[ ]+org\.freedesktop\.UDisks2\./ {
        section = $1
        sub(/:$/, "", section)
        if (seen_sec[obj, section]++) bad[obj] = 1
    }
    /^[ ]+[A-Za-z]+:/ {
        if (section != "" && seen_prop[obj, section, $1]++) bad[obj] = 1
    }
    /^[ ]+Device:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Block") {
            device[obj] = $2
            if ((claimed[$2]++) > 0) bad_dev[$2] = 1
        }
    }
    /^[ ]+Drive:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Block") {
            d = $2
            gsub(q, "", d)
            gsub("\"", "", d)
            drive[obj] = d
        }
    }
    /^[ ]+HintAuto:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Block") hintauto[obj] = $2
    }
    /^[ ]+HintSystem:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Block") hintsystem[obj] = $2
    }
    /^[ ]+HintIgnore:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Block") hintignore[obj] = $2
    }
    /^[ ]+IdLabel:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Block") {
            l = $0
            sub(/^[ ]+IdLabel:[ ]+/, "", l)
            gsub(/[[:cntrl:]]/, " ", l)
            label[obj] = l
        }
    }
    /^[ ]+MountPoints:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Filesystem") {
            mp = $0
            sub(/^[ ]+MountPoints:[ ]+/, "", mp)
            mountpoints[obj] = mp
        }
    }
    /^[ ]+CleartextDevice:[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Encrypted") {
            c = $2
            gsub(q, "", c)
            locked[obj] = (c == "/")
        }
    }
    /^[ ]+(Removable|MediaRemovable):[ ]+/ {
        if (section == "org.freedesktop.UDisks2.Drive") {
            if ($2 == "true") removable[obj] = 1
        }
    }
    END {
        for (d in removable) {
            print "DRIVE" SEP d
        }
        for (o in device) {
            if ((o in bad) || (device[o] in bad_dev) || device[o] !~ /^\/dev\/[A-Za-z0-9_.\/-]+$/) {
                print "SKIP" SEP device[o]
                continue
            }
            if (o in mountpoints) {
                d = drive[o]
                is_mounted = (mountpoints[o] != "" && mountpoints[o] != "[]" && mountpoints[o] !~ /^\[[[:space:]]*\]$/) ? "1" : "0"
                ha = (hintauto[o] == "true") ? "true" : "false"
                hs = (hintsystem[o] == "true") ? "true" : "false"
                hi = (hintignore[o] == "true") ? "true" : "false"
                print "BLOCK" SEP device[o] SEP label[o] SEP ha SEP hs SEP hi SEP is_mounted SEP d
            } else if (locked[o]) {
                ha = (hintauto[o] == "true") ? "true" : "false"
                hs = (hintsystem[o] == "true") ? "true" : "false"
                hi = (hintignore[o] == "true") ? "true" : "false"
                print "BLOCK" SEP device[o] SEP label[o] SEP ha SEP hs SEP hi SEP "0" SEP drive[o] SEP "encrypted"
            }
        }
    }
    ')

    while IFS="$SEP" read -r type f1 f2 f3 f4 f5 f6 f7 f8; do
        case "$type" in
            DRIVE)
                removable_drives="$removable_drives $f1 "
                ;;
            SKIP)
                log "ignoring $f1 (udisks lists it inconsistently: a label with a line break?)"
                ;;
            BLOCK)
                handle_block "$f1" "$f2" "$f3" "$f4" "$f5" "$f6" "$f7" "$f8"
                ;;
        esac
    done <<EOF
$items
EOF
}

# A block's label, HintAuto, HintSystem, HintIgnore, mounted (1/0), drive, UUID, filesystem type
# and whether udisks finds a line for it in fstab (1/0), from udisksctl info (false when udisks
# does not know it)
block_info() {
    run_udisksctl info -b "$1" 2>/dev/null | awk -v SEP="$SEP" '
    /^\// { if (objs++) bad = 1 }
    /^  org\.freedesktop\.UDisks2\./ { section = $1; sub(/:$/, "", section); if (secs[section]++) bad = 1 }
    /^ +[A-Za-z]+:/ { if (section != "" && props[section, $1]++) bad = 1 }
    section == "org.freedesktop.UDisks2.Block" && $1 == "IdLabel:" { l = $0; sub(/^ +IdLabel: */, "", l); gsub(/[[:cntrl:]]/, " ", l); label = l }
    section == "org.freedesktop.UDisks2.Block" && $1 == "HintAuto:" { ha = $2 }
    section == "org.freedesktop.UDisks2.Block" && $1 == "HintSystem:" { hs = $2 }
    section == "org.freedesktop.UDisks2.Block" && $1 == "HintIgnore:" { hi = $2 }
    section == "org.freedesktop.UDisks2.Block" && $1 == "Drive:" { d = $2; gsub(/\047/, "", d) }
    section == "org.freedesktop.UDisks2.Block" && $1 == "IdUUID:" { u = $2 }
    section == "org.freedesktop.UDisks2.Block" && $1 == "IdType:" { t = $2 }
    section == "org.freedesktop.UDisks2.Block" && $1 == "Configuration:" { if ($0 ~ /\(\047fstab\047/) f = 1 }
    section == "org.freedesktop.UDisks2.Filesystem" && $1 == "MountPoints:" { if (NF > 1) m = 1 }
    END {
        # text that only looks like udisks own lines (see scan_existing): not trusted
        if (d == "" || bad) exit 1
        print label SEP (ha == "true" ? "true" : "false") SEP (hs == "true" ? "true" : "false") SEP (hi == "true" ? "true" : "false") SEP (m ? 1 : 0) SEP d SEP u SEP t SEP (f ? 1 : 0)
    }'
}

process_line() {
    line="$1"
    case "$line" in
        *InterfacesAdded*) ;;
        *InterfacesRemoved*) ;;
        *) return 0 ;;
    esac

    parsed=$(printf '%s\n' "$line" | awk -v SEP="$SEP" '
    BEGIN {
        q = sprintf("%c", 39)
    }
    {
        line = $0
        if (line ~ /InterfacesAdded/) {
            obj = ""
            if (match(line, "objectpath " q "[^" q "]+" q)) {
                obj = substr(line, RSTART, RLENGTH)
                sub("^objectpath " q, "", obj)
                sub(q "$", "", obj)
            }

            if (line ~ (q "org\\.freedesktop\\.UDisks2\\.Drive" q)) {
                rem = (match(line, q "Removable" q ": <true>")) || (match(line, q "MediaRemovable" q ": <true>"))
                if (rem) printf "DRIVE_ADD%s%s\n", SEP, obj
                next
            }

            enc = (line ~ (q "org\\.freedesktop\\.UDisks2\\.Encrypted" q)) ? "encrypted" : ""
            if (enc != "" || line ~ (q "org\\.freedesktop\\.UDisks2\\.Filesystem" q)) {
                dev = ""
                if (match(line, q "Device" q ": <(b|objectpath )?" q "[^" q "]*" q ">")) {
                    dev = substr(line, RSTART, RLENGTH)
                    sub("^" q "Device" q ": <(b|objectpath )?" q, "", dev)
                    sub(q ">$", "", dev)
                }
                if (dev == "") {
                    dev = obj
                    sub("^/org/freedesktop/UDisks2/block_devices/", "/dev/", dev)
                }
                label = ""
                if (match(line, q "IdLabel" q ": <" q "[^" q "]*" q ">")) {
                    label = substr(line, RSTART, RLENGTH)
                    sub("^" q "IdLabel" q ": <" q, "", label)
                    sub(q ">$", "", label)
                }
                hint_auto = (match(line, q "HintAuto" q ": <true>")) ? "true" : "false"
                hint_sys = (match(line, q "HintSystem" q ": <true>")) ? "true" : "false"
                hint_ign = (match(line, q "HintIgnore" q ": <true>")) ? "true" : "false"

                drive = ""
                if (match(line, q "Drive" q ": <(objectpath )?" q "[^" q "]*" q ">")) {
                    drive = substr(line, RSTART, RLENGTH)
                    sub("^" q "Drive" q ": <(objectpath )?" q, "", drive)
                    sub(q ">$", "", drive)
                }

                is_mounted = "0"
                if (match(line, q "MountPoints" q ": <[^>]+>")) {
                    mp = substr(line, RSTART, RLENGTH)
                    sub("^" q "MountPoints" q ": <", "", mp)
                    sub(">$", "", mp)
                    if (mp !~ /\[[[:space:]]*\]/) {
                        is_mounted = "1"
                    }
                }
                printf "BLOCK_ADD%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n", SEP, dev, SEP, label, SEP, hint_auto, SEP, hint_sys, SEP, hint_ign, SEP, is_mounted, SEP, drive, SEP, enc
                next
            }
        } else if (line ~ /InterfacesRemoved/) {
            obj = ""
            if (match(line, "objectpath " q "[^" q "]+" q)) {
                obj = substr(line, RSTART, RLENGTH)
                sub("^objectpath " q, "", obj)
                sub(q "$", "", obj)
                printf "REMOVED%s%s\n", SEP, obj
            }
            next
        }
    }
    ')

    [ -n "$parsed" ] || return 0

    while IFS="$SEP" read -r type f1 f2 f3 f4 f5 f6 f7 f8; do
        case "$type" in
            DRIVE_ADD)
                removable_drives="$removable_drives $f1 "
                log "drive added: $f1"
                ;;
            BLOCK_ADD)
                if [ -z "$f7" ]; then
                    # the filesystem came alone, once udisks probed it: the block's hints from
                    # udisks itself, not guessed
                    if ! info=$(block_info "$f1"); then
                        log "no information on $f1 from udisks: not mounted"
                        continue
                    fi
                    IFS="$SEP" read -r f2 f3 f4 f5 f6 f7 _ <<INFO
$info
INFO
                fi
                handle_block "$f1" "$f2" "$f3" "$f4" "$f5" "$f6" "$f7" "$f8"
                ;;
            REMOVED)
                case "$f1" in
                    /org/freedesktop/UDisks2/block_devices/*)
                        dev="/dev/${f1##*/}"
                        log "device removed: $dev"
                        ;;
                    /org/freedesktop/UDisks2/drives/*)
                        log "drive removed: $f1"
                        removable_drives=$(printf '%s' "$removable_drives" | sed "s| $f1 ||g")
                        ;;
                    *)
                        log "removed: $f1"
                        ;;
                esac
                ;;
        esac
    done <<EOF
$parsed
EOF
}

command -v "${INFYNITAE_AUTOMOUNT_UDISKSCTL:-udisksctl}" >/dev/null 2>&1 || exit 0
case "${1:-}" in
    scan)
        rotate_log "$LOG"
        rm -f "$REFUSED_FILE"
        log "started"
        scan_existing
        ;;
    signal)
        removable_drives=$(cat "$DRIVES_FILE" 2>/dev/null || true)
        [ -f "$REFUSED_FILE" ] && names_refused=1
        process_line "${2:-}"
        ;;
    *)
        echo "usage: infynitae-automount scan | signal LINE (run by infynitae-bus-watch) | eject [DEVICE]" >&2
        exit 2
        ;;
esac
printf '%s\n' "$removable_drives" > "$DRIVES_FILE"
