#!/bin/sh
# Super+A: the control menu. Wi-Fi, Bluetooth, volume (all sound and each app), sound output,
# power mode, each shown only when its tool is installed, and do not disturb: nmcli
# (NetworkManager) or iwctl (iwd), bluetoothctl (bluez-utils), pactl (pipewire-pulse),
# powerprofilesctl (power-profiles-daemon), makoctl or swaync-client. The picker is MENU_PICKER
# (empty: fuzzel --dmenu); any dmenu-style command works.
# CONTROL_MENU in the config replaces this whole menu with your own command.

PICKER="${MENU_PICKER:-fuzzel --dmenu}"
TERM_BIN="${TERMINAL:-auto}"
[ "$TERM_BIN" = "auto" ] && for t in kitty alacritty foot wezterm ghostty konsole xterm; do
    command -v "$t" >/dev/null 2>&1 && TERM_BIN="$t" && break
done

have() { command -v "$1" >/dev/null 2>&1; }
pick() { printf '%s\n' "$@" | $PICKER; }
note() { have notify-send && notify-send -a Infynitae "$1" "${2:-}"; }
in_terminal() { [ "$TERM_BIN" != "auto" ] && exec $TERM_BIN -e "$@"; note "No terminal found" "Set TERMINAL in the config"; }

# ── Wi-Fi ──────────────────────────────────────────────────────────────────────────────────────
wifi_menu() {
    if have nmcli; then
        state=$(nmcli radio wifi 2>/dev/null)
        if [ "$state" != "enabled" ]; then
            [ "$(pick 'Turn Wi-Fi on')" = "Turn Wi-Fi on" ] && nmcli radio wifi on
            return
        fi
        # IN-USE, SIGNAL, SECURITY, SSID; ':' inside an SSID is escaped by nmcli as '\:'
        list=$(nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan auto 2>/dev/null \
            | sed 's/\\:/\x1f/g' \
            | awk -F: '$4 != "" { mark = ($1 == "*") ? "● " : "  "; lock = ($3 == "" || $3 == "--") ? "" : " [secured]";
                         gsub("\x1f", ":", $4); printf "%s%s  %s%%%s\n", mark, $4, $2, lock }' | awk '!seen[$0]++')
        choice=$(printf 'Turn Wi-Fi off\n%s\n' "$list" | $PICKER)
        [ -z "$choice" ] && return
        if [ "$choice" = "Turn Wi-Fi off" ]; then nmcli radio wifi off; return; fi
        ssid=$(printf '%s' "$choice" | sed 's/^\(● \|  \)//; s/  [0-9]*%\( \[secured\]\)\{0,1\}$//')
        # a known network connects as it is; a new secured one asks for its password
        if nmcli -t -f NAME connection show | grep -qxF "$ssid"; then
            nmcli connection up id "$ssid" >/dev/null 2>&1 && note "Connected" "$ssid" || note "Could not connect" "$ssid"
        elif printf '%s' "$choice" | grep -q '\[secured\]$'; then
            case "$PICKER" in
                fuzzel*) pass=$(printf '' | fuzzel --dmenu --password --prompt "Password for $ssid: ") ;;
                *) in_terminal nmcli --ask dev wifi connect "$ssid" ;;
            esac
            [ -z "$pass" ] && return
            nmcli dev wifi connect "$ssid" password "$pass" >/dev/null 2>&1 \
                && note "Connected" "$ssid" || note "Could not connect" "$ssid"
        else
            nmcli dev wifi connect "$ssid" >/dev/null 2>&1 && note "Connected" "$ssid" || note "Could not connect" "$ssid"
        fi
    elif have iwctl; then
        in_terminal iwctl
    fi
}

# ── Bluetooth ──────────────────────────────────────────────────────────────────────────────────
bt_menu() {
    if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
        [ "$(pick 'Turn Bluetooth on')" = "Turn Bluetooth on" ] && bluetoothctl power on >/dev/null
        return
    fi
    devices=$(bluetoothctl devices Paired 2>/dev/null | while read -r _ mac name; do
        if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
            printf '● %s\t%s\n' "$name" "$mac"
        else
            printf '  %s\t%s\n' "$name" "$mac"
        fi
    done)
    choice=$(printf 'Pair a new device…\nTurn Bluetooth off\n%s\n' "$devices" | $PICKER)
    case "$choice" in
        "") return ;;
        "Turn Bluetooth off") bluetoothctl power off >/dev/null ;;
        "Pair a new device…") in_terminal bluetoothctl ;;
        *)
            mac=$(printf '%s' "$choice" | awk -F'\t' '{print $2}')
            name=$(printf '%s' "$choice" | awk -F'\t' '{print $1}' | sed 's/^\(● \|  \)//')
            if printf '%s' "$choice" | grep -q '^●'; then
                bluetoothctl disconnect "$mac" >/dev/null && note "Disconnected" "$name"
            else
                bluetoothctl connect "$mac" >/dev/null && note "Connected" "$name" || note "Could not connect" "$name"
            fi
            ;;
    esac
}

# ── Sound output ───────────────────────────────────────────────────────────────────────────────
sound_menu() {
    default=$(pactl get-default-sink 2>/dev/null)
    # "name<TAB>description" for every sink
    sinks=$(pactl list sinks 2>/dev/null | awk -F': ' '/^\s*Name:/ {n=$2} /^\s*Description:/ {print n "\t" $2}')
    choice=$(printf '%s\n' "$sinks" | while IFS="$(printf '\t')" read -r name desc; do
        [ -z "$name" ] && continue
        if [ "$name" = "$default" ]; then printf '● %s\n' "$desc"; else printf '  %s\n' "$desc"; fi
    done | $PICKER)
    [ -z "$choice" ] && return
    desc=$(printf '%s' "$choice" | sed 's/^\(● \|  \)//')
    name=$(printf '%s\n' "$sinks" | awk -F'\t' -v d="$desc" '$2 == d {print $1; exit}')
    [ -n "$name" ] && pactl set-default-sink "$name" && note "Sound output" "$desc"
}

# ── Volume ─────────────────────────────────────────────────────────────────────────────────────
# "target<TAB>name<TAB>volume<TAB>muted": all sound (the default output) first, then every app
# playing now (its sink input's index)
volumes() {
    vol=$(LC_ALL=C pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | grep -o '[0-9]*%' | head -1)
    mute=$(LC_ALL=C pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | awk '{ print $2 }')
    [ -n "$vol" ] && printf '@DEFAULT_SINK@\tAll sound\t%s\t%s\n' "$vol" "$mute"
    LC_ALL=C pactl list sink-inputs 2>/dev/null | awk '
        function out() { if (idx != "") print idx "\t" (app != "" ? app : "Stream " idx) "\t" vol "\t" mute }
        /^Sink Input #/ { out(); idx = substr($3, 2); app = ""; vol = ""; mute = "" }
        /^\s*Mute:/ { mute = $2 }
        /^\s*Volume:/ && vol == "" { if (match($0, /[0-9]+%/)) vol = substr($0, RSTART, RLENGTH) }
        /^\s*application\.name = / { sub(/^[^"]*"/, ""); sub(/"$/, ""); app = $0 }
        END { out() }'
}
volume_label() { awk -F'\t' '{ printf "%s · %s%s\n", $2, $3, ($4 == "yes") ? " (muted)" : "" }'; }
volume_menu() {
    list=$(volumes)
    [ -z "$list" ] && { note "No sound output"; return; }
    choice=$(printf '%s\n' "$list" | volume_label | $PICKER)
    [ -z "$choice" ] && return
    line=$(printf '%s\n' "$list" | while IFS= read -r l; do
        [ "$(printf '%s\n' "$l" | volume_label)" = "$choice" ] && printf '%s\n' "$l" && break
    done)
    [ -z "$line" ] && return
    target=$(printf '%s' "$line" | cut -f1)
    name=$(printf '%s' "$line" | cut -f2)
    current=$(printf '%s' "$line" | cut -f3 | tr -d '%')
    if [ "$target" = @DEFAULT_SINK@ ]; then kind=sink; else kind=sink-input; fi
    if [ "$(printf '%s' "$line" | cut -f4)" = yes ]; then mute_label="Unmute"; else mute_label="Mute"; fi
    level=$(pick "100%" "75%" "50%" "25%" "+10%" "-10%" "$mute_label" | tr -d ' ')
    # +10% stops at 100%
    [ "$level" = "+10%" ] && [ "${current:-0}" -ge 90 ] && level="100%"
    case "$level" in
        "") return ;;
        Mute|Unmute) pactl "set-$kind-mute" "$target" toggle ;;
        *) pactl "set-$kind-volume" "$target" "$level" && pactl "set-$kind-mute" "$target" 0 ;;
    esac
    now=$(volumes | awk -F'\t' -v t="$target" '$1 == t { print $3 ($4 == "yes" ? ", muted" : ""); exit }')
    note "$name" "Volume ${now:-changed}"
}

# ── Power mode ─────────────────────────────────────────────────────────────────────────────────
power_menu() {
    current=$(powerprofilesctl get 2>/dev/null)
    choice=$(powerprofilesctl list 2>/dev/null | sed -n 's/^[ *]*\([a-z-]*\):$/\1/p' | while read -r p; do
        if [ "$p" = "$current" ]; then printf '● %s\n' "$p"; else printf '  %s\n' "$p"; fi
    done | $PICKER)
    [ -n "$choice" ] && powerprofilesctl set "$(printf '%s' "$choice" | sed 's/^\(● \|  \)//')"
}

# ── Do not disturb ─────────────────────────────────────────────────────────────────────────────
# One switch, its state a flag file the compositor reads (FOCUS_ON_OPEN=priority: no window an
# app opens takes the focus while it is on); the notification daemon follows it
DND_FLAG="${XDG_RUNTIME_DIR:-/tmp}/infynitae/do-not-disturb"
dnd_on() { [ -e "$DND_FLAG" ]; }
dnd_toggle() {
    if dnd_on; then
        rm -f "$DND_FLAG"
        if have makoctl; then makoctl mode -r do-not-disturb >/dev/null 2>&1
        elif have swaync-client; then swaync-client --dnd-off >/dev/null 2>&1; fi
        note "Do not disturb off"
    else
        mkdir -p "$(dirname "$DND_FLAG")" && : > "$DND_FLAG"
        if have makoctl; then makoctl mode -a do-not-disturb >/dev/null 2>&1
        elif have swaync-client; then swaync-client --dnd-on >/dev/null 2>&1; fi
    fi
}

# ── Replay buffer ──────────────────────────────────────────────────────────────────────────────
# on or off: ENABLE_REPLAY_BUFFER in the config (read from the file: the session's copy is from
# its start), then the recorder restarted for it
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/infynitae/config"
replay_on() { grep -qE '^ENABLE_REPLAY_BUFFER="?(true|1|yes|on)"?' "$CONFIG" 2>/dev/null; }
replay_toggle() {
    if replay_on; then to=false; else to=true; fi
    if grep -q '^ENABLE_REPLAY_BUFFER=' "$CONFIG"; then
        sed -i "s/^ENABLE_REPLAY_BUFFER=\"[^\"]*\"/ENABLE_REPLAY_BUFFER=\"$to\"/; s/^ENABLE_REPLAY_BUFFER=[^\" ]*\$/ENABLE_REPLAY_BUFFER=\"$to\"/" "$CONFIG"
    else
        echo "ENABLE_REPLAY_BUFFER=\"$to\"" >> "$CONFIG"
    fi
    reload="$HOME/.local/bin/infynitae-reload"
    [ -x "$reload" ] || reload="$HOME/infynitae/live/infynitae-reload"
    "$reload" recorder >/dev/null 2>&1
    if [ "$to" = true ]; then note "Replay buffer on" "Super+Alt+C saves a clip"; else note "Replay buffer off"; fi
}

# ── Battery limit ──────────────────────────────────────────────────────────────────────────────
# BATTERY_LIMIT in the config (80 or off), applied at once and at every login
BATTERY_LIMIT_SCRIPT="$HOME/infynitae/live/battery-limit"
battery_limit_now() { sh "$BATTERY_LIMIT_SCRIPT" 2>/dev/null; }
battery_limit_toggle() {
    if [ "$(battery_limit_now)" = off ]; then to=80; else to=off; fi
    if ! sh "$BATTERY_LIMIT_SCRIPT" "$to" 2>/dev/null; then
        note "Battery limit" "Not allowed yet: run infynitae-update once"
        return
    fi
    if grep -q '^BATTERY_LIMIT=' "$CONFIG"; then
        sed -i "s/^BATTERY_LIMIT=\"[^\"]*\"/BATTERY_LIMIT=\"$to\"/; s/^BATTERY_LIMIT=[^\" ]*\$/BATTERY_LIMIT=\"$to\"/" "$CONFIG"
    else
        echo "BATTERY_LIMIT=\"$to\"" >> "$CONFIG"
    fi
    if [ "$to" = off ]; then note "Battery charges to full"; else note "Battery stops at $to%" "It wears more slowly"; fi
}

# ── The menu ───────────────────────────────────────────────────────────────────────────────────
battery=""
for b in /sys/class/power_supply/BAT*; do
    [ -r "$b/capacity" ] && battery="Battery $(cat "$b/capacity")% ($(cat "$b/status" 2>/dev/null))" && break
done

entries=""
add() { entries="${entries}${1}
"; }
{ have nmcli || have iwctl; } && add "Wi-Fi"
have bluetoothctl && [ -n "$(ls /sys/class/bluetooth 2>/dev/null)" ] && add "Bluetooth"
have pactl && add "Volume"
have pactl && add "Sound output"
have powerprofilesctl && add "Power mode"
if dnd_on; then add "Do not disturb: on (turn off)"; else add "Do not disturb"; fi
if have ffmpeg && { have infynitae-recorder || [ -x "$HOME/.local/bin/infynitae-recorder" ]; }; then
    if replay_on; then add "Replay buffer: on (turn off)"; else add "Replay buffer: off (turn on)"; fi
fi
case "$(battery_limit_now)" in
    "") ;;
    off) add "Battery limit: off (stop at 80%)" ;;
    *) add "Battery limit: $(battery_limit_now)% (charge to full)" ;;
esac
[ -n "$battery" ] && add "$battery"

if [ -z "$entries" ]; then
    note "Nothing to control" "Install NetworkManager, bluez-utils, pipewire-pulse or power-profiles-daemon"
    exit 0
fi

case "$(printf '%s' "$entries" | $PICKER)" in
    "Wi-Fi") wifi_menu ;;
    "Bluetooth") bt_menu ;;
    "Sound output") sound_menu ;;
    "Volume") volume_menu ;;
    "Power mode") power_menu ;;
    "Do not disturb"|"Do not disturb: on (turn off)") dnd_toggle ;;
    "Replay buffer: on (turn off)"|"Replay buffer: off (turn on)") replay_toggle ;;
    "Battery limit: "*) battery_limit_toggle ;;
esac
