#!/bin/sh
# infynitae-xkill APP_ID TITLE SESSION_PID: Super+Shift+Delete on an X11 window. Every X11 app
# reaches the compositor through xwayland-satellite's one connection, so cutting it would end them
# all; the app's own process is found instead: the X11 windows of that class with exactly that
# title, and for each the process the X server says created it (infynitae-xres-pid; the server
# read it from the socket, the app cannot change it). _NET_WM_PID, which the app writes itself, is
# only compared with it. Matches started by another match count as that one; nothing is killed
# unless exactly one process remains (the window was already asked to close), and only inside the
# session: a process under SESSION_PID (the compositor), never the satellite, Xwayland or what
# runs under them. That process and everything it started is killed.
#   exit 0: killed   1: no single match   2: no X11 tools or display   3: outside the session
#   INFYNITAE_XKILL_DRY=1: print the processes instead of killing them
set -u
app=${1:-}
title=${2:-}
session=${3:-}
xres="$(dirname "$0")/infynitae-xres-pid"
case "$session" in '' | *[!0-9]*) echo "infynitae-xkill: no session process given" >&2; exit 2 ;; esac
[ -n "${DISPLAY:-}" ] && command -v xprop >/dev/null 2>&1 && [ -x "$xres" ] || exit 2
[ -n "$app" ] || exit 1

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
want_class=$(lower "$app")

# the X11 windows: xwininfo's tree, else xdotool
windows() {
    if command -v xwininfo >/dev/null 2>&1; then
        xwininfo -root -tree 2>/dev/null | awk '$1 ~ /^0x[0-9a-f]+$/ { print $1 }'
    elif command -v xdotool >/dev/null 2>&1; then
        xdotool search --name '' 2>/dev/null
    fi
}

# the matching windows, each with the _NET_WM_PID it claims
matches=""
for w in $(windows); do
    props=$(xprop -id "$w" WM_CLASS _NET_WM_NAME WM_NAME _NET_WM_PID 2>/dev/null) || continue
    # WM_CLASS = "instance", "class": either may be the app id the satellite gave the toplevel
    class_line=$(printf '%s\n' "$props" | grep '^WM_CLASS')
    inst=$(lower "$(printf '%s' "$class_line" | cut -d'"' -f2)")
    cls=$(lower "$(printf '%s' "$class_line" | cut -d'"' -f4)")
    [ "$inst" = "$want_class" ] || [ "$cls" = "$want_class" ] || continue
    name=$(printf '%s\n' "$props" | grep '^_NET_WM_NAME.* = ' | sed 's/^[^"]*"//; s/"$//')
    [ -n "$name" ] || name=$(printf '%s\n' "$props" | grep '^WM_NAME.* = ' | sed 's/^[^"]*"//; s/"$//')
    [ "$name" = "$title" ] || continue
    claimed=$(printf '%s\n' "$props" | awk '/^_NET_WM_PID/ { print $3 }')
    matches="$matches $w:${claimed:--}"
done
[ -n "$matches" ] || exit 1

pids=""
# shellcheck disable=SC2046
answers=$("$xres" $(for m in $matches; do printf '%s ' "${m%%:*}"; done)) || exit 2
for m in $matches; do
    w=${m%%:*}
    claimed=${m#*:}
    pid=$(printf '%s\n' "$answers" | awk -v w="$w" '$1 == w { print $2 }')
    case "$pid" in '' | *[!0-9]*) continue ;; esac
    [ "$claimed" = "-" ] || [ "$claimed" = "$pid" ] \
        || echo "infynitae-xkill: window $w says process $claimed, the X server says $pid" >&2
    case " $pids " in *" $pid "*) ;; *) pids="$pids $pid" ;; esac
done

parent() { awk '{ sub(/^.*\) /, ""); print $2 }' "/proc/$1/stat" 2>/dev/null; }

# a match started by another match is part of that app (Steam's window comes from both steam
# and the steamwebhelper it started): only the topmost ones are kept
descends() {
    up=$(parent "$1")
    while [ -n "$up" ] && [ "$up" -gt 1 ]; do
        [ "$up" = "$2" ] && return 0
        up=$(parent "$up")
    done
    return 1
}
roots=""
for p in $pids; do
    under=false
    for q in $pids; do
        [ "$q" != "$p" ] && descends "$p" "$q" && under=true
    done
    [ "$under" = true ] || roots="$roots $p"
done

set -- $roots
[ $# -eq 1 ] || exit 1
root=$1

# inside the session: below the compositor, and neither the satellite nor Xwayland nor below them
inside() {
    p=$1
    while [ -n "$p" ] && [ "$p" -gt 1 ]; do
        [ "$p" = "$session" ] && return 0
        case "$(basename "$(readlink "/proc/$p/exe" 2>/dev/null)")" in
            xwayland-satellite | Xwayland) return 1 ;;
        esac
        p=$(parent "$p")
    done
    return 1
}
[ "$root" != "$session" ] && inside "$root" || exit 3

# the tree: the process and everything it started
tree() {
    echo "$1"
    for c in $(cat /proc/"$1"/task/*/children 2>/dev/null); do tree "$c"; done
}
all=$(tree "$root")
if [ -n "${INFYNITAE_XKILL_DRY:-}" ]; then
    echo $all
    exit 0
fi
# stop them all first, so none starts new ones, then kill
kill -STOP $all 2>/dev/null
kill -KILL $all 2>/dev/null
exit 0
