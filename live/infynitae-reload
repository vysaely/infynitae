#!/bin/sh
# Restart Infynitae's helper programs in place, without restarting the compositor (your windows
# stay open). Only the compositor binary itself needs Ctrl+Alt+Backspace.
#
#   infynitae-reload [all|settings|wallpaper|recorder|portal|polkit|screenshare|clipboard|status] ...
#
# Run it from any terminal inside the session, or let infynitae-update call it.

STATE_DIR="$HOME/.local/state/infynitae"
LOG="$STATE_DIR/helpers.log"
BIN_DIR="$HOME/.local/bin"
LIVE="$HOME/infynitae/live"
mkdir -p "$STATE_DIR"

[ -f "$LIVE/env.sh" ] && . "$LIVE/env.sh" >/dev/null 2>&1
[ -f "$LIVE/config.sh" ] && . "$LIVE/config.sh"

# The compositor's socket: the one this shell already uses if it is live, else the one the
# newest session.log start announced (a stale wayland-0 from another desktop must not win).
if [ -z "$WAYLAND_DISPLAY" ] || [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    sock=$(grep -o 'Listening on Wayland socket: [^ ]*' "$STATE_DIR/session.log" 2>/dev/null | tail -1 | cut -d' ' -f5)
    [ -n "$sock" ] && export WAYLAND_DISPLAY="$sock"
fi
if [ -z "$WAYLAND_DISPLAY" ] || ! pgrep -x infynitae >/dev/null 2>&1; then
    echo "infynitae-reload: no running Infynitae session found" >&2
    exit 1
fi

# The first existing path, or nothing.
first() {
    for p in "$@"; do
        [ -x "$p" ] && { echo "$p"; return; }
    done
}

# Start a helper detached from this terminal, logging to helpers.log.
spawn() {
    echo "[$(date '+%F %T')] start: $*" >> "$LOG"
    setsid -f "$@" >> "$LOG" 2>&1 < /dev/null
}

# PIDs of a helper: processes whose program (argv[0]), or whose script when the program is a shell
# or interpreter (argv[1]), is named $1. Kernel process names are cut at 15 characters, so
# "infynitae-wallpaper" can never be found by name; matching the whole command line would also
# hit e.g. "less infynitae-recorder".
pids_of() {
    found=1
    for d in /proc/[0-9]*; do
        [ "${d#/proc/}" = "$$" ] && continue
        set -- "$1" $( { tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null)
        [ $# -ge 2 ] || continue
        prog=${2##*/}
        case "$prog" in
            sh|bash|dash|python3|python) [ $# -ge 3 ] && prog=${3##*/} ;;
        esac
        if [ "$prog" = "$1" ]; then
            echo "${d#/proc/}"
            found=0
        fi
    done
    return $found
}

# Stop every running copy of helper $1, then wait up to 2 s for it to go.
stop_helper() {
    pids=$(pids_of "$1") || return 0
    kill -TERM $pids 2>/dev/null || true
    i=0
    while pids_of "$1" >/dev/null && [ $i -lt 20 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    pids=$(pids_of "$1") && kill -KILL $pids 2>/dev/null || true
}

# PIDs of a helper matching program $1 and arguments matching $2.
pids_matching() {
    found=1
    for d in /proc/[0-9]*; do
        [ "${d#/proc/}" = "$$" ] && continue
        set -- "$1" "$2" $( { tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null)
        [ $# -ge 3 ] || continue
        prog=${3##*/}
        case "$prog" in
            sh|bash|dash|python3|python) [ $# -ge 4 ] && prog=${4##*/} ;;
        esac
        if [ "$prog" = "$1" ]; then
            shift 3
            case " $* " in
                *" $2 "*)
                    echo "${d#/proc/}"
                    found=0
                    ;;
            esac
        fi
    done
    return $found
}

# Stop every running copy of helper $1 matching arguments $2, then wait up to 2 s for it to go.
stop_matching() {
    pids=$(pids_matching "$1" "$2") || return 0
    kill -TERM $pids 2>/dev/null || true
    i=0
    while pids_matching "$1" "$2" >/dev/null && [ $i -lt 20 ]; do
        sleep 0.1
        i=$((i + 1))
    done
    pids=$(pids_matching "$1" "$2") && kill -KILL $pids 2>/dev/null || true
}

is_true() {
    case "$1" in 1|true|yes|on|TRUE|True) return 0 ;; *) return 1 ;; esac
}

reload_settings() {
    s=$(first "$LIVE/settings.sh" "$BIN_DIR/infynitae-settings")
    [ -n "$s" ] && sh "$s" apply >> "$LOG" 2>&1
    echo "settings: re-applied"
}

reload_wallpaper() {
    w=$(first "$BIN_DIR/infynitae-wallpaper" "$LIVE/wallpaper/infynitae-wallpaper")
    if [ -z "$WALLPAPER" ] || [ -z "$w" ]; then
        echo "wallpaper: not configured"
        return
    fi
    # a new instance replaces the old one itself; the config's WALLPAPER may hold an unexpanded
    # $HOME for the program, so pass the path this shell expanded
    spawn "$w" "$WALLPAPER" "${WALLPAPER_MODE:-fill}"
    echo "wallpaper: restarted"
}

reload_recorder() {
    r=$(first "$BIN_DIR/infynitae-recorder" "$LIVE/record/infynitae-recorder")
    RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/infynitae-runtime-$(id -u)}"
    sup="$RUNTIME_DIR/infynitae-recorder-supervisor.pid"
    if [ -f "$sup" ]; then
        # the supervisor's TERM trap also stops its encoder
        kill -TERM "$(cat "$sup")" 2>/dev/null || true
        sleep 0.5
    fi
    stop_helper infynitae-record-stream
    # its ffmpeg encoder can outlive both; it is the one writing into the replay dir
    pkill -f "^ffmpeg .*${RUNTIME_DIR}/infynitae-replay/chunk" 2>/dev/null || true
    pkill -f "^ffmpeg .*/dev/shm/infynitae-replay/chunk" 2>/dev/null || true
    if [ -n "$r" ] && is_true "${ENABLE_REPLAY_BUFFER:-false}"; then
        spawn "$r" supervisor
        echo "recorder: restarted"
    else
        echo "recorder: stopped (ENABLE_REPLAY_BUFFER is off)"
    fi
}

reload_portal() {
    p=$(first "$LIVE/infynitae-portal" "$BIN_DIR/infynitae-portal")
    stop_helper infynitae-portal
    if [ -n "$p" ]; then
        spawn "$p"
        echo "portal: restarted"
    fi
}

reload_polkit() {
    p=$(first "$BIN_DIR/infynitae-polkit")
    stop_helper infynitae-polkit
    if [ -n "$p" ]; then
        spawn "$p"
        echo "polkit: restarted"
    fi
}

# Screen sharing (xdg-desktop-portal-wlr): what a share shows (live/screenshare-chooser).
# SCREENSHARE_ASK=false (default) shares the first screen as soon as an app asks for a screen,
# and an app asking for a window gets a menu of the windows; true always asks, in a menu of the
# screens and the windows (MENU_PICKER, fuzzel by default; without one, click a screen with
# slurp). Written only when absent or marked as ours (a hand-written config is the user's); the
# portal reads it when it next starts, so a running one is stopped (it restarts on demand).
reload_screenshare() {
    cfg="$HOME/.config/xdg-desktop-portal-wlr/config"
    if [ -f "$cfg" ] && ! grep -q '^# managed by infynitae' "$cfg"; then
        echo "screenshare: $cfg is your own (no '# managed by infynitae' line); left alone"
        return
    fi
    screens=$(awk '/Starting Infynitae compositor/ { n = "" }
        /^\[infynitae\] Screen [^ ]+:/ { s = $3; sub(/:$/, "", s); n = n " " s }
        END { print n }' "$STATE_DIR/session.log" 2>/dev/null)
    first=$(echo $screens | cut -d' ' -f1)
    mkdir -p "${cfg%/*}"
    {
        echo "# managed by infynitae: written from SCREENSHARE_ASK in ~/.config/infynitae/config;"
        echo "# delete this line to keep your own settings"
        echo "[screencast]"
        echo "force_mod_linear=1"
        picker="${MENU_PICKER:-fuzzel --dmenu}"
        chooser="$HOME/infynitae/live/screenshare-chooser"
        if [ -x "$chooser" ] && command -v "${picker%% *}" >/dev/null 2>&1; then
            # a screen at once (or asked, with SCREENSHARE_ASK), a window from the menu
            if is_true "${SCREENSHARE_ASK:-false}"; then mode=ask; else mode=first; fi
            echo "chooser_type=dmenu"
            echo "chooser_cmd=$chooser $mode '$picker'"
        elif is_true "${SCREENSHARE_ASK:-false}" || [ -z "$first" ]; then
            echo "chooser_type=simple"
            echo "chooser_cmd=slurp -f %o -or"
        else
            echo "chooser_type=none"
            echo "output_name=$first"
        fi
    } > "$cfg.new" && mv -f "$cfg.new" "$cfg"
    systemctl --user stop xdg-desktop-portal-wlr.service 2>/dev/null || true
    if is_true "${SCREENSHARE_ASK:-false}"; then
        echo "screenshare: pick a screen or a window when an app asks"
    else
        echo "screenshare: a screen is shared as soon as an app asks; a window is picked from a menu"
    fi
}

reload_clipboard() {
    stop_matching wl-clip-persist "--clipboard regular"
    stop_matching wl-paste "cliphist store"
    restarted=0
    if is_true "${CLIPBOARD_PERSIST:-true}" && command -v wl-clip-persist >/dev/null 2>&1; then
        spawn wl-clip-persist --clipboard regular
        restarted=1
    fi
    if is_true "${CLIPBOARD_HISTORY:-true}" && command -v cliphist >/dev/null 2>&1 && command -v wl-paste >/dev/null 2>&1; then
        spawn wl-paste --type text --watch cliphist store
        spawn wl-paste --type image --watch cliphist store
        restarted=1
    fi
    if [ $restarted -eq 1 ]; then
        echo "clipboard: restarted"
    else
        echo "clipboard: stopped"
    fi
}

status() {
    printf '%-26s %s\n' infynitae "$(pgrep -x infynitae | tr '\n' ' ')"
    for n in infynitae-wallpaper infynitae-recorder infynitae-record-stream infynitae-portal infynitae-polkit infynitae-lock; do
        pids=$(pids_of "$n" | tr '\n' ' ')
        printf '%-26s %s\n' "$n" "${pids:-not running}"
    done
    # the compositor's file on disk was replaced since it started: a restart picks up the update
    exe=$(readlink "/proc/$(pgrep -x infynitae | head -1)/exe" 2>/dev/null)
    case "$exe" in
        *" (deleted)") echo "compositor: an updated binary is installed; Ctrl+Alt+Backspace loads it" ;;
        *) echo "compositor: running the installed binary" ;;
    esac
}

[ $# -eq 0 ] && set -- all
for what in "$@"; do
    case "$what" in
        all) reload_settings; reload_wallpaper; reload_recorder; reload_portal; reload_polkit; reload_screenshare; reload_clipboard ;;
        settings) reload_settings ;;
        wallpaper) reload_wallpaper ;;
        recorder) reload_recorder ;;
        portal) reload_portal ;;
        polkit) reload_polkit ;;
        screenshare) reload_screenshare ;;
        clipboard) reload_clipboard ;;
        status) status ;;
        *)
            echo "usage: infynitae-reload [all|settings|wallpaper|recorder|portal|polkit|screenshare|clipboard|status] ..." >&2
            exit 2
            ;;
    esac
done
