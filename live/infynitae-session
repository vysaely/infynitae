#!/bin/sh
# Infynitae session launcher: restarts the compositor after a clean quit (Ctrl+Alt+Backspace =
# reload), stops after a crash loop, and logs to ~/.local/state/infynitae/session.log. A crash
# leaves a report in ~/.local/state/infynitae/crashes/ (the last 10), which the next start
# announces in a notification (session.sh).
#
#   infynitae-session          run the session
#   infynitae-session stop     end the session for real (no restart)

STATE_DIR="$HOME/.local/state/infynitae"
STOP_FILE="$STATE_DIR/stop"
mkdir -p "$STATE_DIR"

if [ "$1" = "stop" ]; then
    : > "$STOP_FILE"
    pkill -TERM -x infynitae 2>/dev/null || true
    exit 0
fi

cleanup() {
    stty sane 2>/dev/null || true
    tput cnorm 2>/dev/null || true
}
# told to end (logout, shutdown: systemd sends TERM, the console HUP): the compositor running now
# is let finish, and no new one starts. Before this, the trap only tidied the terminal and the loop
# started a fresh session at the lock screen while the system went down, which systemd then waited
# 90 s for before killing it.
ENDING=""
end_session() {
    ENDING=1
    cleanup
}
trap cleanup EXIT
trap end_session INT TERM HUP
umask 077

# Decide console vs nested from environment before sourcing env.sh
TTY_MODE=""
if [ "$XDG_SESSION_TYPE" = "tty" ] || { [ -z "$WAYLAND_DISPLAY" ] && [ -z "$DISPLAY" ]; }; then
    TTY_MODE="--tty"
fi

if [ -f "$HOME/infynitae/live/env.sh" ]; then
    . "$HOME/infynitae/live/env.sh"
fi

# In console mode, do not inherit any stale display env.sh might have found on disk
if [ -n "$TTY_MODE" ]; then
    unset WAYLAND_DISPLAY DISPLAY
fi

export RUST_BACKTRACE=1
SESSION_LOG="$STATE_DIR/session.log"
LOG_MAX_BYTES=20000000
FAST_FAIL_SECS=5
MAX_FAST_FAILS=3

BIN="$HOME/.local/bin/infynitae"
SESSION_SCRIPT="$HOME/infynitae/live/session.sh"

XWLS=""
if command -v xwayland-satellite >/dev/null 2>&1; then
    XWLS="--xwayland-satellite $(command -v xwayland-satellite)"
fi

CRASH_DIR="$STATE_DIR/crashes"
CRASH_NOTE="$STATE_DIR/crashed"

# The crash just seen, in a report: how it ended, the panic message if Rust left one, and the
# end of this run's log. CRASH_NOTE tells the next start (session.sh) to say so.
crash_report() {
    mkdir -p "$CRASH_DIR"
    report="$CRASH_DIR/$(date '+%F_%H-%M-%S').log"
    run_log() { tail -c +"$((START_BYTES + 1))" "$SESSION_LOG" 2>/dev/null; }
    how="exit status $STATUS"
    [ "$STATUS" -gt 128 ] && how="signal $(kill -l "$((STATUS - 128))" 2>/dev/null || echo "$((STATUS - 128))")"
    # "thread 'main' panicked at src/…:", then the message on the next line
    panic=$(run_log | grep -m1 -A1 "panicked at" | tail -n 1)
    {
        echo "Infynitae crashed ($how) after ${DURATION}s"
        echo "Date:    $(date '+%F %T')"
        echo "Version: $(git -C "$HOME/infynitae" describe --always --dirty 2>/dev/null || echo unknown)"
        echo "Kernel:  $(uname -r)"
        [ -n "$panic" ] && echo "Panic:   $panic"
        echo ""
        echo "The end of the session log:"
        run_log | tail -n 200
    } > "$report"
    printf '%s\t%s\n' "$report" "${panic:-$how}" > "$CRASH_NOTE"
    ls -1t "$CRASH_DIR"/*.log 2>/dev/null | tail -n +11 | while IFS= read -r old; do rm -f "$old"; done
}

rm -f "$STOP_FILE"
FAILS=0

while true; do
    # keep one old log; the current one restarts past LOG_MAX_BYTES
    if [ -f "$SESSION_LOG" ] && [ "$(wc -c < "$SESSION_LOG")" -gt "$LOG_MAX_BYTES" ]; then
        mv -f "$SESSION_LOG" "$SESSION_LOG.old"
    fi

    START_TIME=$(date +%s)
    START_BYTES=0
    [ -f "$SESSION_LOG" ] && START_BYTES=$(wc -c < "$SESSION_LOG")
    echo "[infynitae-session] $(date '+%F %T') Starting Infynitae compositor..." >> "$SESSION_LOG"

    # Refresh environment and drop stale auth before launch
    if [ -f "$HOME/infynitae/live/env.sh" ]; then
        . "$HOME/infynitae/live/env.sh"
    fi
    if [ -n "$TTY_MODE" ]; then
        unset WAYLAND_DISPLAY DISPLAY
    fi
    if [ -n "$XAUTHORITY" ] && [ ! -f "$XAUTHORITY" ]; then
        unset XAUTHORITY
    fi

    # START_LOCKED, and every restart: the compositor itself starts locked (--locked), so nothing
    # runs unlocked before the lock screen (session.sh starts it) takes the lock
    LOCKED_ARG=""
    if [ -n "$TTY_MODE" ]; then
        case "${START_LOCKED:-false}" in
            1|true|yes|on|TRUE|True) LOCKED_ARG="--locked" ;;
        esac
        [ "${INFYNITAE_RESTART_LOCKED:-}" = "1" ] && LOCKED_ARG="--locked"
    fi

    # No pipe: $? must be the compositor's own exit status
    "$BIN" $TTY_MODE $LOCKED_ARG $XWLS --exec "$SESSION_SCRIPT" "$@" >> "$SESSION_LOG" 2>&1
    STATUS=$?
    # every later start is locked (session.sh): a compositor that crashed, or was quit, while
    # the screen was locked must not come back unlocked, whatever START_LOCKED says
    export INFYNITAE_RESTART_LOCKED=1
    DURATION=$(( $(date +%s) - START_TIME ))
    cleanup
    echo "[infynitae-session] $(date '+%F %T') Compositor exited with status $STATUS after ${DURATION}s" >> "$SESSION_LOG"

    if [ -f "$STOP_FILE" ]; then
        rm -f "$STOP_FILE"
        echo "[infynitae-session] Stop requested; ending session." >> "$SESSION_LOG"
        exit 0
    fi

    # the session or the system is ending: no restart
    if [ -n "$ENDING" ]; then
        echo "[infynitae-session] Told to end (logout or shutdown); not restarting." >> "$SESSION_LOG"
        exit 0
    fi
    case "$(systemctl is-system-running 2>/dev/null)" in
        stopping)
            echo "[infynitae-session] The system is shutting down; not restarting." >> "$SESSION_LOG"
            exit 0
            ;;
    esac
    if systemctl list-jobs 2>/dev/null | grep -qE 'shutdown\.target|reboot\.target|poweroff\.target|halt\.target'; then
        echo "[infynitae-session] Shutdown or reboot in progress; not restarting." >> "$SESSION_LOG"
        exit 0
    fi

    # SIGHUP (129), SIGINT (130), SIGTERM (143): the login/session was ended by the console or
    # systemd (shutdown, reboot, logout). Exit instead of respawning a locked session that would
    # block shutdown for 90s. Only clean quit (0, e.g. Ctrl+Alt+Backspace) or a crash restarts.
    case "$STATUS" in
        129|130|143)
            echo "[infynitae-session] Compositor ended by signal (status $STATUS); ending session." >> "$SESSION_LOG"
            exit 0
            ;;
        0) ;;
        *) crash_report ;;
    esac

    if [ "$STATUS" -ne 0 ] && [ "$DURATION" -lt "$FAST_FAIL_SECS" ]; then
        FAILS=$((FAILS + 1))
        if [ "$FAILS" -ge "$MAX_FAST_FAILS" ]; then
            MSG="[infynitae-session] Crash loop: $FAILS failures in a row (last status $STATUS). Not restarting; see $SESSION_LOG"
            echo "$MSG" >> "$SESSION_LOG"
            echo "$MSG" >&2
            # a rescue shell only makes sense on a real terminal, and only after your password:
            # with tty1 autologin nobody typed one, and the shell would be anyone's at the
            # keyboard. su to yourself asks for it; a wrong one ends the login.
            if [ -t 0 ]; then
                exec su -l "$(id -un)"
            fi
            exit 1
        fi
        sleep 1
    else
        FAILS=0
        sleep 0.5
    fi
done
