#!/bin/sh
# Infynitae session launcher: restarts the compositor after a clean quit (Ctrl+Alt+Backspace =
# reload), stops after a crash loop, and logs to ~/.local/state/infynitae/session.log.
#
#   infynitae-session          run the session
#   infynitae-session stop     end the session for real (no restart)

STATE_DIR="$HOME/.local/state/infynitae"
STOP_FILE="$STATE_DIR/stop"
mkdir -p "$STATE_DIR"

if [ "$1" = "stop" ]; then
    : > "$STOP_FILE"
    pkill -TERM -x infynitae 2>/dev/null || true
    exit 0
fi

cleanup() {
    stty sane 2>/dev/null || true
    tput cnorm 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP
umask 077

# Decide console vs nested from environment before sourcing env.sh
TTY_MODE=""
if [ "$XDG_SESSION_TYPE" = "tty" ] || { [ -z "$WAYLAND_DISPLAY" ] && [ -z "$DISPLAY" ]; }; then
    TTY_MODE="--tty"
fi

if [ -f "$HOME/infynitae/live/env.sh" ]; then
    . "$HOME/infynitae/live/env.sh"
fi

# In console mode, do not inherit any stale display env.sh might have found on disk
if [ -n "$TTY_MODE" ]; then
    unset WAYLAND_DISPLAY DISPLAY
fi

export RUST_BACKTRACE=1
SESSION_LOG="$STATE_DIR/session.log"
LOG_MAX_BYTES=20000000
FAST_FAIL_SECS=5
MAX_FAST_FAILS=3

BIN="$HOME/.local/bin/infynitae"
SESSION_SCRIPT="$HOME/infynitae/live/session.sh"

XWLS=""
if command -v xwayland-satellite >/dev/null 2>&1; then
    XWLS="--xwayland-satellite $(command -v xwayland-satellite)"
fi

rm -f "$STOP_FILE"
FAILS=0

while true; do
    # keep one old log; the current one restarts past LOG_MAX_BYTES
    if [ -f "$SESSION_LOG" ] && [ "$(wc -c < "$SESSION_LOG")" -gt "$LOG_MAX_BYTES" ]; then
        mv -f "$SESSION_LOG" "$SESSION_LOG.old"
    fi

    START_TIME=$(date +%s)
    echo "[infynitae-session] $(date '+%F %T') Starting Infynitae compositor..." >> "$SESSION_LOG"

    # Refresh environment and drop stale auth before launch
    if [ -f "$HOME/infynitae/live/env.sh" ]; then
        . "$HOME/infynitae/live/env.sh"
    fi
    if [ -n "$TTY_MODE" ]; then
        unset WAYLAND_DISPLAY DISPLAY
    fi
    if [ -n "$XAUTHORITY" ] && [ ! -f "$XAUTHORITY" ]; then
        unset XAUTHORITY
    fi

    # START_LOCKED, and every restart: the compositor itself starts locked (--locked), so nothing
    # runs unlocked before the lock screen (session.sh starts it) takes the lock
    LOCKED_ARG=""
    if [ -n "$TTY_MODE" ]; then
        case "${START_LOCKED:-false}" in
            1|true|yes|on|TRUE|True) LOCKED_ARG="--locked" ;;
        esac
        [ "${INFYNITAE_RESTART_LOCKED:-}" = "1" ] && LOCKED_ARG="--locked"
    fi

    # No pipe: $? must be the compositor's own exit status
    "$BIN" $TTY_MODE $LOCKED_ARG $XWLS --exec "$SESSION_SCRIPT" "$@" >> "$SESSION_LOG" 2>&1
    STATUS=$?
    # every later start is locked (session.sh): a compositor that crashed, or was quit, while
    # the screen was locked must not come back unlocked, whatever START_LOCKED says
    export INFYNITAE_RESTART_LOCKED=1
    DURATION=$(( $(date +%s) - START_TIME ))
    cleanup
    echo "[infynitae-session] $(date '+%F %T') Compositor exited with status $STATUS after ${DURATION}s" >> "$SESSION_LOG"

    if [ -f "$STOP_FILE" ]; then
        rm -f "$STOP_FILE"
        echo "[infynitae-session] Stop requested; ending session." >> "$SESSION_LOG"
        exit 0
    fi

    if [ "$STATUS" -ne 0 ] && [ "$DURATION" -lt "$FAST_FAIL_SECS" ]; then
        FAILS=$((FAILS + 1))
        if [ "$FAILS" -ge "$MAX_FAST_FAILS" ]; then
            MSG="[infynitae-session] Crash loop: $FAILS failures in a row (last status $STATUS). Not restarting; see $SESSION_LOG"
            echo "$MSG" >> "$SESSION_LOG"
            echo "$MSG" >&2
            # a rescue shell only makes sense on a real terminal, and only after your password:
            # with tty1 autologin nobody typed one, and the shell would be anyone's at the
            # keyboard. su to yourself asks for it; a wrong one ends the login.
            if [ -t 0 ]; then
                exec su -l "$(id -un)"
            fi
            exit 1
        fi
        sleep 1
    else
        FAILS=0
        sleep 0.5
    fi
done
