#!/bin/sh
# ==============================================================================
# Infynitae Native Screen Recorder & 20-Minute Replay Buffer
# Pure C screencopy + AMD Radeon VCN VA-API hardware acceleration
# Ultra-lean: < 5MB RAM, 0% CPU, zero background popups, zero lost clips.
# ==============================================================================

set -e

# Load user configuration
if [ -f "$HOME/infynitae/live/env.sh" ]; then
    . "$HOME/infynitae/live/env.sh"
fi
if [ -f "$HOME/.config/infynitae/config" ]; then
    . "$HOME/.config/infynitae/config"
fi

STREAM_BIN="$HOME/infynitae/live/record/infynitae-record-stream"
if [ ! -x "$STREAM_BIN" ]; then
    STREAM_BIN="$HOME/.local/bin/infynitae-record-stream"
fi

REPLAY_DIR="${REPLAY_DIR:-/dev/shm/infynitae-replay}"
CLIPS_DIR="${CLIPS_DIR:-$HOME/Videos/Clips}"
RECORDINGS_DIR="${RECORDINGS_DIR:-$HOME/Videos/Recordings}"
REPLAY_MINUTES="${REPLAY_BUFFER_MINUTES:-20}"
RECORD_FPS="${RECORD_FPS:-60}"
RECORD_CODEC="${RECORD_CODEC:-hevc}" # hevc or av1
RECORD_AUDIO="${RECORD_AUDIO:-true}"
DRI_DEVICE="${DRI_DEVICE:-/dev/dri/renderD128}"

# Calculate segment counts for circular buffer
SEGMENT_SECS=10
TOTAL_SECS=$((REPLAY_MINUTES * 60))
SEGMENT_WRAP=$((TOTAL_SECS / SEGMENT_SECS))
if [ "$SEGMENT_WRAP" -lt 6 ]; then
    SEGMENT_WRAP=6
fi

PID_FILE="/tmp/infynitae-recording.pid"
REPLAY_PID_FILE="/tmp/infynitae-replay.pid"
SUPERVISOR_PID_FILE="/tmp/infynitae-recorder-supervisor.pid"

notify_toast() {
    title="$1"
    msg="$2"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a "Infynitae" -u low -h string:x-canonical-private-synchronous:recorder -t 2000 "$title" "$msg" 2>/dev/null || true
    fi
}

start_replay_engine() {
    mkdir -p "$REPLAY_DIR"
    rm -f "$REPLAY_DIR"/chunk*.mkv "$REPLAY_DIR"/concat*.txt 2>/dev/null || true

    # Choose hardware encoder
    if [ "$RECORD_CODEC" = "av1" ]; then
        V_ENCODER="av1_vaapi"
    else
        V_ENCODER="hevc_vaapi"
    fi

    # Audio inputs
    AUDIO_ARGS=""
    if [ "$RECORD_AUDIO" = "true" ] && command -v pactl >/dev/null 2>&1 || command -v wpctl >/dev/null 2>&1; then
        AUDIO_ARGS="-f pulse -i default -c:a aac -b:a 192k"
    fi

    # Automatically resolve current Wayland display
    if [ -z "$WAYLAND_DISPLAY" ] && [ -n "$XDG_RUNTIME_DIR" ]; then
        for wsock in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
            if [ -S "$wsock" ]; then
                export WAYLAND_DISPLAY="${wsock##*/}"
                break
            fi
        done
    fi

    echo "[infynitae-recorder] Starting $REPLAY_MINUTES-min rolling replay buffer ($V_ENCODER, ${RECORD_FPS}fps)..."

    # Screen streamer -> FFmpeg hardware encoder -> circular segment ring buffer
    # Uses nice -n 10 so foreground games always get 100% priority
    exec nice -n 10 "$STREAM_BIN" | nice -n 10 ffmpeg -loglevel error -y \
        -init_hw_device vaapi=va:"$DRI_DEVICE" \
        -f rawvideo -pix_fmt bgr0 -s:v 1920x1080 -r "$RECORD_FPS" -i - \
        $AUDIO_ARGS \
        -vf 'format=nv12,hwupload' \
        -c:v "$V_ENCODER" \
        -b:v 14M -maxrate 18M \
        -f segment \
        -segment_time "$SEGMENT_SECS" \
        -segment_wrap "$SEGMENT_WRAP" \
        -reset_timestamps 1 \
        "$REPLAY_DIR/chunk%03d.mkv"
}

supervisor_loop() {
    echo $$ > "$SUPERVISOR_PID_FILE"
    echo "[infynitae-recorder] Invincible replay supervisor started (PID $$)"

    # Trap clean session termination
    trap 'kill $(cat "$REPLAY_PID_FILE" 2>/dev/null) 2>/dev/null || true; pkill -P $$ 2>/dev/null || true; rm -f "$SUPERVISOR_PID_FILE" "$REPLAY_PID_FILE"; exit 0' TERM INT HUP

    while true; do
        # Start replay engine in background with isolated descriptors
        start_replay_engine >/dev/null 2>&1 &
        ENGINE_PID=$!
        echo $ENGINE_PID > "$REPLAY_PID_FILE"

        # Wait for engine process
        wait $ENGINE_PID || true

        # If supervisor still running, auto-heal and restart in 1 second
        echo "[infynitae-recorder] Replay buffer exited unexpectedly. Restarting in 1s..."
        sleep 1
    done
}

save_replay_clip() {
    if [ ! -d "$REPLAY_DIR" ]; then
        notify_toast "Replay Buffer Inactive" "No replay buffer directory found."
        echo "Error: Replay directory $REPLAY_DIR does not exist" >&2
        return 1
    fi

    mkdir -p "$CLIPS_DIR"
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    OUT_FILE="$CLIPS_DIR/clip-${TIMESTAMP}.mp4"
    CONCAT_LIST="$REPLAY_DIR/concat-${TIMESTAMP}.txt"

    # Find chunks sorted chronologically by modification time
    CHUNKS=$(ls -tr "$REPLAY_DIR"/chunk*.mkv 2>/dev/null || true)
    if [ -z "$CHUNKS" ]; then
        notify_toast "Replay Buffer Empty" "Still buffering first segment, try again in a few seconds."
        echo "Error: No chunks found in $REPLAY_DIR" >&2
        return 1
    fi

    # Build concat playlist
    rm -f "$CONCAT_LIST"
    for c in $CHUNKS; do
        # Verify file is readable and non-empty
        if [ -s "$c" ]; then
            echo "file '$c'" >> "$CONCAT_LIST"
        fi
    done

    COUNT=$(wc -l < "$CONCAT_LIST" 2>/dev/null || echo 0)
    if [ "$COUNT" -eq 0 ]; then
        notify_toast "Replay Buffer Empty" "Waiting for segments..."
        return 1
    fi

    DURATION_MIN=$((COUNT * SEGMENT_SECS / 60))
    if [ "$DURATION_MIN" -eq 0 ]; then
        DURATION_STR="$((COUNT * SEGMENT_SECS))s"
    else
        DURATION_STR="${DURATION_MIN}m"
    fi

    # Instant stream-copy concat (0% CPU, ~0.2s duration)
    ffmpeg -loglevel error -y -f concat -safe 0 -i "$CONCAT_LIST" -c copy "$OUT_FILE"
    rm -f "$CONCAT_LIST"

    notify_toast "Clip Saved (${DURATION_STR})" "Saved to ${OUT_FILE##*/}"
    echo "[infynitae-recorder] Saved $DURATION_STR clip to $OUT_FILE"
}

start_recording() {
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        echo "Recording already running (PID $(cat "$PID_FILE"))"
        return 0
    fi

    mkdir -p "$RECORDINGS_DIR"
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    OUT_FILE="$RECORDINGS_DIR/recording-${TIMESTAMP}.mp4"

    if [ "$RECORD_CODEC" = "av1" ]; then
        V_ENCODER="av1_vaapi"
    else
        V_ENCODER="hevc_vaapi"
    fi

    AUDIO_ARGS=""
    if [ "$RECORD_AUDIO" = "true" ] && command -v pactl >/dev/null 2>&1 || command -v wpctl >/dev/null 2>&1; then
        AUDIO_ARGS="-f pulse -i default -c:a aac -b:a 192k"
    fi

    if [ -z "$WAYLAND_DISPLAY" ] && [ -n "$XDG_RUNTIME_DIR" ]; then
        for wsock in "$XDG_RUNTIME_DIR"/wayland-[0-9]*; do
            if [ -S "$wsock" ]; then
                export WAYLAND_DISPLAY="${wsock##*/}"
                break
            fi
        done
    fi

    # Run in background
    nice -n 10 "$STREAM_BIN" | nice -n 10 ffmpeg -loglevel error -y \
        -init_hw_device vaapi=va:"$DRI_DEVICE" \
        -f rawvideo -pix_fmt bgr0 -s:v 1920x1080 -r "$RECORD_FPS" -i - \
        $AUDIO_ARGS \
        -vf 'format=nv12,hwupload' \
        -c:v "$V_ENCODER" \
        -b:v 16M -maxrate 20M \
        "$OUT_FILE" >/dev/null 2>&1 &

    REC_PID=$!
    echo $REC_PID > "$PID_FILE"
    notify_toast "Recording Started" "Writing to ${OUT_FILE##*/}"
    echo "[infynitae-recorder] Started recording to $OUT_FILE (PID $REC_PID)"
}

stop_recording() {
    if [ -f "$PID_FILE" ]; then
        REC_PID=$(cat "$PID_FILE")
        if kill -0 "$REC_PID" 2>/dev/null; then
            # Send SIGINT to allow clean MP4 header finalization
            kill -INT "$REC_PID" 2>/dev/null || true
            # Also terminate stream bin if orphaned
            pkill -P "$REC_PID" 2>/dev/null || true
            pkill -f "$STREAM_BIN" 2>/dev/null || true
            sleep 1
            notify_toast "Recording Saved" "Saved to $RECORDINGS_DIR"
            echo "[infynitae-recorder] Recording stopped (PID $REC_PID)"
        fi
        rm -f "$PID_FILE"
    else
        echo "No recording active"
    fi
}

toggle_recording() {
    if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
        stop_recording
    else
        start_recording
    fi
}

case "$1" in
    supervisor|daemon|autostart)
        supervisor_loop
        ;;
    replay-start)
        start_replay_engine
        ;;
    replay-save|save-replay|clip|clip-save)
        save_replay_clip
        ;;
    record-start)
        start_recording
        ;;
    record-stop)
        stop_recording
        ;;
    record-toggle|toggle-record)
        toggle_recording
        ;;
    status)
        echo "=== Infynitae Recorder Status ==="
        if [ -f "$SUPERVISOR_PID_FILE" ] && kill -0 $(cat "$SUPERVISOR_PID_FILE") 2>/dev/null; then
            echo "Supervisor: ACTIVE (PID $(cat "$SUPERVISOR_PID_FILE"))"
        else
            echo "Supervisor: INACTIVE"
        fi
        if [ -f "$REPLAY_PID_FILE" ] && kill -0 $(cat "$REPLAY_PID_FILE") 2>/dev/null; then
            COUNT=$(ls "$REPLAY_DIR"/chunk*.mkv 2>/dev/null | wc -l)
            BUFFERED_MIN=$((COUNT * SEGMENT_SECS / 60))
            echo "Replay Buffer: ACTIVE (Buffered ~${BUFFERED_MIN} min, $COUNT chunks in $REPLAY_DIR)"
        else
            echo "Replay Buffer: INACTIVE"
        fi
        if [ -f "$PID_FILE" ] && kill -0 $(cat "$PID_FILE") 2>/dev/null; then
            echo "Continuous Recording: ACTIVE (PID $(cat "$PID_FILE"))"
        else
            echo "Continuous Recording: INACTIVE"
        fi
        ;;
    *)
        echo "Usage: $0 {supervisor|replay-start|replay-save|record-start|record-stop|record-toggle|status}"
        exit 1
        ;;
esac
