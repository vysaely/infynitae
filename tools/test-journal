#!/bin/sh
# tools/test-journal: live/journal.h, which the password prompt (infynitae-polkit) and the lock
# screen (infynitae-lock) write the desktop journal with: one line of six tab-separated fields in
# the compositor's format, the program by its executable, escapes, a file only the user reads, and
# ~/.local/state when XDG_STATE_HOME is unset. Run from the repository root.
set -eu
REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-journal.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM
cat > "$TMP/write.c" <<'C'
#include "journal.h"
int main(void) {
    journal_write("polkit", getpid(), "org.example.action\twith a tab\nand a newline \\", "denied");
    journal_write("unlock-failed", 0, "PAM service login: Authentication failure", "denied");
    return 0;
}
C
cc -O1 -Wall -Wextra -Werror -I "$REPO_DIR/live" -o "$TMP/writer" "$TMP/write.c"
XDG_STATE_HOME="$TMP/state" HOME="$TMP/unused" "$TMP/writer"
F="$TMP/state/infynitae/journal/journal.tsv"
fail() { echo "FAIL $1"; cat "$F"; exit 1; }
[ "$(wc -l < "$F")" -eq 2 ] || fail "two events, two lines"
awk -F '\t' 'NF != 6 { exit 1 }' "$F" || fail "six fields per line"
line1=$(sed -n 1p "$F")
printf '%s\n' "$line1" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z	' || fail "a UTC time first"
prog=$(printf '%s\n' "$line1" | cut -f 3)
[ "$prog" = "$(readlink -f "$TMP/writer")" ] || fail "the program by its executable: $prog"
printf '%s\n' "$line1" | cut -f 4 | grep -Eq '^[0-9]+$' || fail "its pid"
[ "$(printf '%s\n' "$line1" | cut -f 5)" = 'org.example.action\twith a tab\nand a newline \\' ] || fail "escaped detail"
[ "$(sed -n 2p "$F" | cut -f 2-6)" = "unlock-failed			PAM service login: Authentication failure	denied" ] || fail "an unknown pid leaves program and pid empty"
[ "$(stat -c %a "$F")" = 600 ] || fail "only the user reads it"
env -u XDG_STATE_HOME HOME="$TMP/home" "$TMP/writer"
[ "$(wc -l < "$TMP/home/.local/state/infynitae/journal/journal.tsv")" -eq 2 ] || fail "~/.local/state without XDG_STATE_HOME"
echo "ok   live/journal.h writes the compositor's journal format"
