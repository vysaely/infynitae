# Controls of the judge itself: a harmless seed must be MISSED, an unknown test name BROKEN.
JUDGE = [
    ("judge: a harmless seed is not reported as detected", "MISSED", f"{CORE}/projection.rs",
     "fn edge(x: i64, r: i64, c: i64, k: f64) -> i64 {", "fn edge(x: i64, r: i64, c: i64, k: f64) -> i64 {\n    // seeded comment",
     "infynitae-core", ["--lib"], "ob6_edge_equals_round_l"),
    ("judge: a filter matching no test is a broken control", "BROKEN", f"{CORE}/projection.rs",
     "((x - r) as f64 * k + DELTA).round() as i64 - c", "((x - r) as f64 * k + DELTA).floor() as i64 - c",
     "infynitae-core", ["--lib"], "no_such_test_name"),
]


def digest():
    h = hashlib.sha256()
    for item in COPY_ITEMS:
        p = os.path.join(ROOT, item)
        files = [p] if os.path.isfile(p) else sorted(os.path.join(d, f) for d, _, fs in os.walk(p) for f in fs)
        for f in files:
            h.update(os.path.relpath(f, ROOT).encode())
            with open(f, "rb") as fh:
                h.update(fh.read())
    return h.hexdigest()


def run_control(prop, rel, old, new, package, target, name, target_dir):
    tmp = tempfile.mkdtemp(prefix="verify-test-efficacy-")
    try:
        for item in COPY_ITEMS:
            src, dst = os.path.join(ROOT, item), os.path.join(tmp, item)
            (shutil.copytree if os.path.isdir(src) else shutil.copy2)(src, dst)
        path = os.path.join(tmp, rel)
        with open(path) as f:
            text = f.read()
        if text.count(old) != 1:
            return "BROKEN", f"seed anchor found {text.count(old)} times in {rel}"
        with open(path, "w") as f:
            f.write(text.replace(old, new, 1))
        cmd = ["cargo", "test", "--locked", "-p", package, *target, name, "--", "--test-threads=1"]
        p = subprocess.run(cmd, cwd=tmp, env={**os.environ, "CARGO_TARGET_DIR": target_dir},
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        out = p.stdout
        if "error[E" in out or "could not compile" in out:
            return "BROKEN", "the seeded tree does not compile"
        failed = [l for l in out.splitlines() if l.startswith("test ") and l.endswith("FAILED") and name in l]
        if p.returncode != 0 and failed:
            return "DETECTED", failed[0]
        ran = sum(int(m) for m in re.findall(r"test result: \w+\. (\d+) passed; (?:\d+) failed", out))
        ran += sum(int(m) for m in re.findall(r"test result: \w+\. \d+ passed; (\d+) failed", out))
        if ran == 0:
            return "BROKEN", f"no test matched {name!r}"
        return "MISSED", "the named test passed with the defect"
    finally:
        shutil.rmtree(tmp)


def main():
    if sys.argv[1:]:
        print(__doc__)
        return 2
    print("=" * 72)
    print("verify-test-efficacy — seeded behavioural defects (INC-1, INC1-F06/F07 corrective, INC-2, INC-3, INC-4, INC-6 hardening)")
    print("=" * 72)
    target_base = os.path.join(ROOT, "target")
    os.makedirs(target_base, exist_ok=True)
    target_dir = tempfile.mkdtemp(prefix=f"test-efficacy-{os.getpid()}-", dir=target_base)
    try:
        before = digest()
        failures = 0
        for prop, rel, old, new, package, target, name in CONTROLS:
            verdict, detail = run_control(prop, rel, old, new, package, target, name, target_dir)
            ok = verdict == "DETECTED"
            failures += not ok
            print(f"  {'ok  ' if ok else 'FAIL'}  {verdict:<9} {prop}\n          {package} {' '.join(target)} {name}: {detail}")
        for prop, want, rel, old, new, package, target, name in JUDGE:
            verdict, detail = run_control(prop, rel, old, new, package, target, name, target_dir)
            ok = verdict == want
            failures += not ok
            print(f"  {'ok  ' if ok else 'FAIL'}  {verdict:<9} {prop} (want {want})")
        same = digest() == before
        if not same:
            failures += 1
        print(f"  {'ok  ' if same else 'FAIL'}  canonical tree byte-identical after all controls")
        print("=" * 72)
        print(f"== verify-test-efficacy: {'PASS' if failures == 0 else f'FAIL ({failures})'}")
        return 0 if failures == 0 else 1
    finally:
        shutil.rmtree(target_dir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
