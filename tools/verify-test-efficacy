def digest():
    h = hashlib.sha256()
    for item in COPY_ITEMS:
        p = os.path.join(ROOT, item)
        files = [p] if os.path.isfile(p) else sorted(os.path.join(d, f) for d, _, fs in os.walk(p) for f in fs)
        for f in files:
            h.update(os.path.relpath(f, ROOT).encode())
            with open(f, "rb") as fh:
                h.update(fh.read())
    return h.hexdigest()


# Every control builds in one shared target directory, from a fresh copy whose files keep the
# canonical tree's modification times. Cargo decides freshness by modification time, and its
# artifacts do not depend on the copy's path, so a crate a control seeded stays built from the
# seeded source in later copies, which carry older times: a later control would then test a tree
# with two defects (found 2026-10-18, INC-10: a render-location seed in Core made the tracker
# control pass). STALE holds the (file, unit) pairs whose last build may have been seeded — unit
# "lib" is the crate's library as a dependency, "test" its own test build; each copy gives those
# files a fresh time, so cargo rebuilds them from the clean source, and a pair is dropped once a
# control's build has certainly recompiled that unit from clean source.
STALE = set()
DEPS = {
    "infynitae-core": set(),
    "infynitae-ipc": {"infynitae-core"},
    "infynitae-wayland": {"infynitae-core"},
    "infynitae-backend-headless": {"infynitae-core", "infynitae-wayland"},
    "infynitae-backend-winit": {"infynitae-core", "infynitae-wayland"},
    "infynitae": {"infynitae-core", "infynitae-wayland", "infynitae-backend-headless", "infynitae-backend-winit",
                  "infynitae-ipc"},
}


def rebuilt_clean(entry, package, target):
    """Whether a build of `package`'s `target` necessarily recompiled `entry`'s unit from its clean source."""
    rel, unit = entry
    parts = rel.split("/")
    if len(parts) < 4 or parts[0] != "crates" or parts[2] != "src":
        return False  # a test file or anything else: kept stale (a rebuild of its target, never wrong)
    crate = parts[1]
    if unit == "lib":
        return crate in DEPS.get(package, set()) or (crate == package and target[:1] == ["--test"])
    return crate == package and target == ["--lib"]


def run_control(prop, rel, old, new, package, target, name, target_dir):
    tmp = tempfile.mkdtemp(prefix="verify-test-efficacy-")
    try:
        for item in COPY_ITEMS:
            src, dst = os.path.join(ROOT, item), os.path.join(tmp, item)
            (shutil.copytree if os.path.isdir(src) else shutil.copy2)(src, dst)
        for stale_rel in {r for r, _ in STALE}:
            if os.path.exists(os.path.join(tmp, stale_rel)):
                os.utime(os.path.join(tmp, stale_rel))
        path = os.path.join(tmp, rel)
        with open(path) as f:
            text = f.read()
        if text.count(old) != 1:
            return "BROKEN", f"seed anchor found {text.count(old)} times in {rel}"
        with open(path, "w") as f:
            f.write(text.replace(old, new, 1))
        cmd = ["cargo", "test", "--locked", "-p", package, *target, name, "--", "--test-threads=1"]
        p = subprocess.run(cmd, cwd=tmp, env={**os.environ, "CARGO_TARGET_DIR": target_dir},
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
        out = p.stdout
        if "error[E" in out or "could not compile" in out:
            STALE.update({(rel, "lib"), (rel, "test")})
            return "BROKEN", "the seeded tree does not compile"
        STALE.difference_update({e for e in STALE if e[0] != rel and rebuilt_clean(e, package, target)})
        STALE.update({(rel, "lib"), (rel, "test")})
        failed = [l for l in out.splitlines() if l.startswith("test ") and l.endswith("FAILED") and name in l]
        if p.returncode != 0 and failed:
            return "DETECTED", failed[0]
        ran = sum(int(m) for m in re.findall(r"test result: \w+\. (\d+) passed; (?:\d+) failed", out))
        ran += sum(int(m) for m in re.findall(r"test result: \w+\. \d+ passed; (\d+) failed", out))
        if ran == 0:
            return "BROKEN", f"no test matched {name!r}"
        return "MISSED", "the named test passed with the defect"
    finally:
        shutil.rmtree(tmp)


def main():
    if sys.argv[1:]:
        print(__doc__)
        return 2
    print("=" * 72)
    print("verify-test-efficacy — seeded behavioural defects (INC-1, INC1-F06/F07 corrective, INC-2, INC-3, INC-4, INC-6 hardening)")
    print("=" * 72)
    target_base = os.path.join(ROOT, "target")
    os.makedirs(target_base, exist_ok=True)
    target_dir = tempfile.mkdtemp(prefix=f"test-efficacy-{os.getpid()}-", dir=target_base)
    try:
        before = digest()
        failures = 0
        for prop, rel, old, new, package, target, name in CONTROLS:
            verdict, detail = run_control(prop, rel, old, new, package, target, name, target_dir)
            ok = verdict == "DETECTED"
            failures += not ok
            print(f"  {'ok  ' if ok else 'FAIL'}  {verdict:<9} {prop}\n          {package} {' '.join(target)} {name}: {detail}")
        for prop, want, rel, old, new, package, target, name in JUDGE:
            verdict, detail = run_control(prop, rel, old, new, package, target, name, target_dir)
            ok = verdict == want
            failures += not ok
            print(f"  {'ok  ' if ok else 'FAIL'}  {verdict:<9} {prop} (want {want})")
        same = digest() == before
        if not same:
            failures += 1
        print(f"  {'ok  ' if same else 'FAIL'}  canonical tree byte-identical after all controls")
        print("=" * 72)
        print(f"== verify-test-efficacy: {'PASS' if failures == 0 else f'FAIL ({failures})'}")
        return 0 if failures == 0 else 1
    finally:
        shutil.rmtree(target_dir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
