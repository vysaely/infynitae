#!/bin/sh
# tools/test-env: tests for live/env.sh environment resolution and security.
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
ENV_SCRIPT="$REPO_DIR/live/env.sh"

TMP=$(mktemp -d "/tmp/infynitae-test-env.XXXXXX")
trap '[ -f "$TMP/portal_pid" ] && kill "$(cat "$TMP/portal_pid")" 2>/dev/null; rm -rf "$TMP"' EXIT INT TERM
# env.sh's /tmp paths go to a folder of the test's own (never the machine's X sockets), and nothing reaches a
# session bus or a display
export INFYNITAE_ENV_TMP="$TMP/tmp"
mkdir -p "$INFYNITAE_ENV_TMP"
unset DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY DISPLAY

# ----------------------------------------------------------------------
# 1. Finding 6: DISPLAY auto-detection ignores foreign X11 sockets
# ----------------------------------------------------------------------
X11="$INFYNITAE_ENV_TMP/.X11-unix"
mkdir -p "$X11"
# /etc/pacman.d/gnupg/S.gpg-agent is an existing socket not owned by the test user
FOREIGN_SOCK="/etc/pacman.d/gnupg/S.gpg-agent"
if [ -S "$FOREIGN_SOCK" ] && [ ! -O "$FOREIGN_SOCK" ]; then
    ln -s "$FOREIGN_SOCK" "$X11/X0"
else
    echo "Warning: cannot find foreign socket; skipping socket ownership check"
fi

# Create user's own socket on display :1
python3 -c "import socket; s = socket.socket(socket.AF_UNIX); s.bind('$X11/X1')"

# Sourcing env.sh with the X socket folder holding a foreign X0 and our own X1
export HOME="$TMP/home"
export XDG_RUNTIME_DIR="$TMP/run"
mkdir -p "$HOME" "$XDG_RUNTIME_DIR"
unset DISPLAY

set +eu
. "$ENV_SCRIPT" >/dev/null 2>&1
rc=$?
set -eu

if [ "$DISPLAY" != ":1" ]; then
    echo "FAIL Finding 6: expected DISPLAY ':1' (skipping foreign :0), got '$DISPLAY'"
    exit 1
fi
echo "ok Finding 6: DISPLAY auto-detect skips foreign X11 sockets"

# ----------------------------------------------------------------------
# 2. Finding 7: Insecure predictable temporary files in shared /tmp
# ----------------------------------------------------------------------
# A: When /tmp/infynitae-runtime-$(id -u) exists as a regular file (attacker blocked it),
# env.sh must create a secure fallback directory instead of reusing the file.
blocker="$INFYNITAE_ENV_TMP/infynitae-runtime-$(id -u)"
rm -rf "$blocker"
touch "$blocker"
res_dir=$(
    unset XDG_RUNTIME_DIR
    export HOME="$TMP/home2"
    mkdir -p "$HOME"
    set +eu
    . "$ENV_SCRIPT" >/dev/null 2>&1
    set -eu
    echo "$XDG_RUNTIME_DIR"
)
rm -f "$blocker"

if [ ! -d "$res_dir" ]; then
    echo "FAIL Finding 7: XDG_RUNTIME_DIR is not a directory when $blocker exists: got '$res_dir'"
    exit 1
fi
if [ "$res_dir" = "$blocker" ]; then
    echo "FAIL Finding 7: XDG_RUNTIME_DIR pointed to blocked regular file path"
    exit 1
fi
echo "ok Finding 7: safe fallback directory created when predictable runtime path is blocked"

# ----------------------------------------------------------------------
# 3. Finding 11: Cross-user process matching prevents portal startup
# ----------------------------------------------------------------------
# Mock pgrep in a dedicated bin dir:
# If -u <my_uid> is passed, return nothing (no portal running for my user).
# If -u is omitted, simulate finding another user's portal process (PID 99999).
MOCK_BIN="$TMP/mock_bin"
mkdir -p "$MOCK_BIN"
my_uid=$(id -u)
cat > "$MOCK_BIN/pgrep" <<EOF
#!/bin/sh
has_u=false
for arg in "\$@"; do
    if [ "\$arg" = "-u" ] || [ "\${arg#-u}" != "\$arg" ]; then
        has_u=true
    fi
done
if [ "\$has_u" = "true" ]; then
    exit 1
else
    echo "99999"
    exit 0
fi
EOF
chmod +x "$MOCK_BIN/pgrep"

# Create a mock infynitae-portal in HOME/.local/bin that marks when it was started
PORTAL_FLAG="$TMP/portal_started"
rm -f "$PORTAL_FLAG"
mkdir -p "$TMP/home3/.local/bin"
cat > "$TMP/home3/.local/bin/infynitae-portal" <<EOF
#!/bin/sh
touch "$PORTAL_FLAG"
echo \$\$ > "$TMP/portal_pid"
exec sleep 100
EOF
chmod +x "$TMP/home3/.local/bin/infynitae-portal"

(
    export PATH="$MOCK_BIN:$PATH"
    export HOME="$TMP/home3"
    export XDG_RUNTIME_DIR="$TMP/run3"
    mkdir -p "$HOME" "$XDG_RUNTIME_DIR"
    set +eu
    . "$ENV_SCRIPT" >/dev/null 2>&1
    set -eu
)

# If pgrep filtered by -u, portal would be launched and PORTAL_FLAG created.
# Without -u, pgrep matched the foreign process and skipped starting portal.
sleep 0.2
if [ ! -f "$PORTAL_FLAG" ]; then
    echo "FAIL Finding 11: infynitae-portal was not started because pgrep matched foreign process"
    exit 1
fi
echo "ok Finding 11: pgrep filters by user ID to prevent foreign process hijacking"
