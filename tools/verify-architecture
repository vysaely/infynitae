def tree_digest():
    h = hashlib.sha256()
    for item in COPY_ITEMS:
        p = os.path.join(ROOT, item)
        files = [p] if os.path.isfile(p) else sorted(
            os.path.join(d, f) for d, _, fs in os.walk(p) for f in fs)
        for f in files:
            h.update(os.path.relpath(f, ROOT).encode())
            with open(f, "rb") as fh:
                h.update(fh.read())
    return h.hexdigest()


def fresh_copy():
    tmp = tempfile.mkdtemp(prefix="verify-architecture-")
    for item in COPY_ITEMS:
        src = os.path.join(ROOT, item)
        dst = os.path.join(tmp, item)
        if os.path.isdir(src):
            shutil.copytree(src, dst)
        else:
            shutil.copy2(src, dst)
    for item in OPTIONAL_COPY_ITEMS:
        src = os.path.join(ROOT, item)
        if os.path.isfile(src):
            os.makedirs(os.path.dirname(os.path.join(tmp, item)), exist_ok=True)
            shutil.copy2(src, os.path.join(tmp, item))
    return tmp


def edit_or_create(root, rel, fn):
    p = os.path.join(root, rel)
    text = ""
    if os.path.isfile(p):
        with open(p) as f:
            text = f.read()
    new = fn(text)
    if new == text:
        raise RuntimeError(f"seed did not change {rel}")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as f:
        f.write(new)


