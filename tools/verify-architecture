def check_probe_features(meta, r):
    print("\n[3] Probe-feature hygiene")
    problems = []
    by_name = {p["name"]: p for p in meta["packages"] if p["id"] in meta["workspace_members"]}
    for name in PRODUCT:
        p = by_name.get(name)
        if not p:
            continue
        feats = p["features"]
        for f, enables in feats.items():
            if f == "default":
                if any("probe_" in e for e in enables):
                    problems.append(f"{name}: default features enable a probe: {enables}")
            elif not f.startswith("probe_"):
                problems.append(f"{name}: feature {f!r} is not a probe; INC-0 product crates declare probe features only")
            elif any(not e.split("/")[-1].startswith("probe_") for e in enables):
                problems.append(f"{name}: probe feature {f!r} enables non-probe {enables}")
        for d in p["dependencies"]:
            if any(x.startswith("probe_") for x in d["features"]):
                problems.append(f"{name}: dependency {d['name']} is declared with probe features {d['features']}")
    for x in problems:
        r.fail(x)
    if not problems:
        r.ok("probe features are named probe_*, off by default, never enabled by a dependency declaration")


