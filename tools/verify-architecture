class Quiet(Results):
    def ok(self, msg):
        pass

    def fail(self, msg):
        self.failures += 1


def check_mutations(binary, r):
    print("\n[6] Seeded negative controls (temporary copies; each defect must be detected)")
    before = tree_digest()
    for desc, rule, rel, seed in SOURCE_SEEDS:
        tmp = fresh_copy()
        try:
            edit(tmp, rel, seed)
            code, out = source_rules(binary, tmp)
            hit = code != 0 and any(l.startswith(f"FAIL {rule}:") for l in out.splitlines())
            r.check(hit, f"detected: {desc} ({rule})", f"NOT DETECTED: {desc} (expected {rule})\n{out}")
        finally:
            shutil.rmtree(tmp)
    for desc, rel, line, kind in GRAPH_SEEDS:
        tmp = fresh_copy()
        try:
            q = Quiet()
            if kind == "dag-acyclic":
                # remove the backend's own adapter edge first so the seed is not a Cargo cycle
                edit(tmp, "crates/infynitae-backend-headless/Cargo.toml",
                     replace('infynitae-wayland = { path = "../infynitae-wayland" }\n', ""))
                kind = "dag"
            if kind == "append-dag":
                edit(tmp, rel, append(line))
                hit = bool(dag_problems(metadata(tmp, locked=False)))
            elif kind == "dag":
                edit(tmp, rel, replace("[dependencies]\n", f"[dependencies]\n{line}\n"))
                hit = bool(dag_problems(metadata(tmp, locked=False)))
            elif kind == "smithay":
                edit(tmp, rel, replace('version = "=0.7.0"', 'version = "0.7"'))
                hit = not check_smithay(metadata(tmp, locked=False), q)
            elif kind == "toolchain":
                edit(tmp, rel, replace(f'channel = "{TOOLCHAIN}"', 'channel = "stable"'))
                hit = not check_toolchain(tmp, q)
            else:
                edit(tmp, rel, append('\n[patch.crates-io]\nsmithay = { path = "vendor/smithay" }\n'))
                hit = not check_root_manifest(tmp, q)
            r.check(hit, f"detected: {desc}", f"NOT DETECTED: {desc}")
        except Exception as e:  # a seed the checks never saw is a broken control, not a detection
            r.fail(f"CONTROL BROKEN: {desc}: {e}")
        finally:
            shutil.rmtree(tmp)
    # The probe judge rejects compilation, wrong error codes and harness failures.
    by_id = {p[0]: p for p in PROBES_INVENTORY}
    _, _, pkg, feat, _, _ = by_id["p5_control_compiles"]
    v, _ = judge(("code", "E0624", "set_center"), "enforcement/probes/src/lib.rs", *compile_probe(pkg, feat))
    r.check(v == "VIOLATION", "judge: a probe that compiles is a VIOLATION", f"judge accepted a compiling probe ({v})")
    _, _, pkg, feat, _, file = by_id["p1_mutate_through_read_accessor"]
    v, _ = judge(("code", "E0603", "Authority"), file, *compile_probe(pkg, feat))
    r.check(v == "WRONG REASON", "judge: a failure with another error code is WRONG REASON",
            f"judge accepted an unexpected error code ({v})")
    v, _ = judge(("code", "E0624", "set_center"), file, *compile_probe(PROBES, "no_such_probe_feature"))
    r.check(v == "HARNESS ERROR", "judge: a cargo failure without a compiler diagnostic is a HARNESS ERROR",
            f"judge accepted a broken harness ({v})")
    after = tree_digest()
    r.check(before == after, "canonical tree byte-identical after all seeded controls",
            "canonical tree CHANGED during seeded controls")


# ------------------------------------------------------------------ main

def main():
    skip_mutations = "--skip-mutations" in sys.argv[1:]
    if any(a not in ("--skip-mutations",) for a in sys.argv[1:]):
        print(__doc__)
        return 2
    print("=" * 72)
    print("verify-architecture — Infynitae Native (OB-19)")
    print(f"root: {ROOT}")
    print("=" * 72)
    r = Results()
    try:
        meta = check_pins(r)
        check_dag(meta, r)
        check_probe_features(meta, r)
        binary = rules_binary()
        check_source_rules(binary, r)
        check_probes(r)
        if skip_mutations:
            r.fail("seeded negative controls skipped (--skip-mutations): not a passing run")
        else:
            check_mutations(binary, r)
    except Exception as e:  # fail closed
        r.fail(f"verifier error: {e}")
    print("\n[7] Deferred runtime validation (owner ruling for INC-0; NOT tested here)")
    for what, why, owner in DEFERRED:
        print(f"  DEFERRED  {what}\n            reason: {why}\n            owner:  {owner}")
    print("\n" + "=" * 72)
    verdict = "PASS" if r.failures == 0 else f"FAIL ({r.failures} failing checks)"
    print(f"== verify-architecture: {verdict}")
    return 0 if r.failures == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
