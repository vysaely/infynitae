class Results:
    def __init__(self):
        self.failures = 0

    def ok(self, msg):
        print(f"  ok    {msg}")

    def fail(self, msg):
        self.failures += 1
        print(f"  FAIL  {msg}")

    def check(self, cond, ok_msg, fail_msg):
        if cond:
            self.ok(ok_msg)
        else:
            self.fail(fail_msg)
        return cond


def run(cmd, cwd=ROOT, env=None):
    e = dict(os.environ)
    if env:
        e.update(env)
    p = subprocess.run(cmd, cwd=cwd, env=e, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    return p.returncode, p.stdout, p.stderr


def metadata(root, locked=True):
    cmd = ["cargo", "metadata", "--format-version", "1", "--manifest-path", os.path.join(root, "Cargo.toml")]
    if locked:
        cmd.append("--locked")
    else:
        cmd.append("--offline")
    code, out, err = run(cmd, cwd=root)
    if code != 0:
        raise RuntimeError(f"cargo metadata failed: {err.strip()}")
    return json.loads(out)


# ------------------------------------------------------------------ [1] pins

def check_toolchain(root, r):
    path = os.path.join(root, "rust-toolchain.toml")
    try:
        with open(path, "rb") as f:
            channel = tomllib.load(f).get("toolchain", {}).get("channel")
    except (OSError, tomllib.TOMLDecodeError) as e:
        return r.check(False, "", f"rust-toolchain.toml unreadable: {e}")
    return r.check(channel == TOOLCHAIN, f"rust-toolchain.toml pins channel {TOOLCHAIN}",
                   f"rust-toolchain.toml channel is {channel!r}; {TOOLCHAIN!r} required")


def check_root_manifest(root, r):
    path = os.path.join(root, "Cargo.toml")
    try:
        with open(path, "rb") as f:
            manifest = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError) as e:
        return r.check(False, "", f"root Cargo.toml unreadable: {e}")
    ok = True
    if "replace" in manifest:
        ok &= r.check(False, "", "root Cargo.toml contains [replace]: forbidden by dependency policy")
    patch = manifest.get("patch")
    if patch is None:
        return r.check(False, "", "root Cargo.toml missing [patch]: authorized P1 patch required for INC-5 (OB-11)")
    if set(patch.keys()) != {"crates-io"}:
        return r.check(False, "", f"root Cargo.toml contains unauthorized patch targets: {list(patch.keys())}")
    crates_io = patch["crates-io"]
    if set(crates_io.keys()) != {"smithay"}:
        return r.check(False, "", f"root Cargo.toml contains arbitrary [patch.crates-io] additions: {list(crates_io.keys())}")
    smithay_patch = crates_io["smithay"]
    if not isinstance(smithay_patch, dict) or set(smithay_patch.keys()) != {"path"} or smithay_patch.get("path") != AUTHORIZED_SMITHAY_PATCH_REL:
        return r.check(False, "", f"root Cargo.toml smithay patch must pin path {AUTHORIZED_SMITHAY_PATCH_REL!r}; got {smithay_patch!r}")
    r.ok(f"root Cargo.toml specifies exactly authorized D-B12-PIN patch: smithay = {{ path = '{AUTHORIZED_SMITHAY_PATCH_REL}' }}")
    for cfg in (".cargo/config.toml", ".cargo/config"):
        p = os.path.join(root, cfg)
        if os.path.exists(p):
            with open(p) as f:
                text = f.read()
            ok &= r.check(not re.search(r"^\s*(\[patch|paths\s*=)", text, re.M), f"{cfg} has no patch/paths override",
                          f"{cfg} overrides dependency sources")
    return ok


def check_authorized_p1_patch(root, r):
    patch_dir = os.path.join(root, AUTHORIZED_SMITHAY_PATCH_REL)
    if not os.path.isdir(patch_dir):
        return r.check(False, "", f"authorized patch directory {AUTHORIZED_SMITHAY_PATCH_REL} does not exist")
    pointer_rs = os.path.join(patch_dir, "src", "wayland", "seat", "pointer.rs")
    if not os.path.exists(pointer_rs):
        return r.check(False, "", f"{pointer_rs} missing from vendor directory")
    with open(pointer_rs, "rb") as f:
        h = hashlib.sha256(f.read()).hexdigest()
    if h != AUTHORIZED_POINTER_SHA256:
        return r.check(False, "", f"pointer.rs sha256 mismatch (expected authorized P1 {AUTHORIZED_POINTER_SHA256}, got {h})")
    manifest_path = os.path.join(root, AUTHORIZED_SMITHAY_MANIFEST_REL)
    if not os.path.isfile(manifest_path):
        return r.check(False, "", f"vendor smithay manifest {manifest_path} missing")
    expected = {}
    with open(manifest_path, "r") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split(None, 1)
            if len(parts) == 2:
                expected[parts[1]] = parts[0]
    actual_files = set()
    mismatches = []
    for dirpath, _, filenames in os.walk(patch_dir):
        for fname in filenames:
            full = os.path.join(dirpath, fname)
            rel = os.path.relpath(full, patch_dir)
            actual_files.add(rel)
            with open(full, "rb") as fh:
                actual_h = hashlib.sha256(fh.read()).hexdigest()
            if rel not in expected:
                mismatches.append(f"unexpected file: {rel}")
            elif expected[rel] != actual_h:
                mismatches.append(f"checksum mismatch: {rel}")
    missing = set(expected.keys()) - actual_files
    for rel in sorted(missing):
        mismatches.append(f"missing file: {rel}")
    if mismatches:
        return r.check(False, "", f"vendor smithay has unauthorized local modifications beyond P1: {mismatches[:5]}")
    r.ok(f"vendor smithay source matches authorized minimal P1 patch (zero unauthorized modifications)")
    return True


def check_smithay(meta, root, r):
    ok = True
    pkgs = [p for p in meta["packages"] if p["name"] == "smithay"]
    expected_manifest = os.path.realpath(os.path.join(root, AUTHORIZED_SMITHAY_PATCH_REL, "Cargo.toml"))
    ok &= r.check(len(pkgs) == 1 and pkgs[0]["version"] == SMITHAY_VERSION and os.path.realpath(pkgs[0]["manifest_path"]) == expected_manifest,
                  f"resolved smithay is exactly {SMITHAY_VERSION} at authorized path {AUTHORIZED_SMITHAY_PATCH_REL}",
                  f"resolved smithay packages: {[(p['version'], p.get('source'), p.get('manifest_path')) for p in pkgs]}")
    ws = set(meta["workspace_members"])
    for p in meta["packages"]:
        if p["id"] not in ws:
            continue
        for d in p["dependencies"]:
            if d["name"] == "smithay":
                ok &= r.check(d["req"] == SMITHAY_REQ and d["source"] == CRATES_IO,
                              f"{p['name']} declares smithay {SMITHAY_REQ} from crates.io",
                              f"{p['name']} declares smithay {d['req']!r} from {d['source']!r}; {SMITHAY_REQ} from crates.io required")
    return ok


def check_manifest_pins(root, r):
    ok = True
    for crate in [WAYLAND, HEADLESS]:
        p = os.path.join(root, "crates", crate, "Cargo.toml")
        try:
            with open(p, "rb") as f:
                c = tomllib.load(f)
            dep = c.get("dependencies", {}).get("smithay")
            req = dep.get("version") if isinstance(dep, dict) else dep
            ok &= r.check(req == SMITHAY_REQ, f"{crate} declares smithay {SMITHAY_REQ}",
                          f"{crate} declares smithay version {req!r}; {SMITHAY_REQ} required")
        except Exception as e:
            ok &= r.check(False, "", f"{p} unreadable: {e}")
    return ok


def check_pins(r):
    print("\n[1] Pins (OB-19 item 3, INV-ARCH-3)")
    check_toolchain(ROOT, r)
    code, out, _ = run(["rustc", "--version"])
    r.check(code == 0 and out.startswith(f"rustc {TOOLCHAIN} "), f"active compiler: {out.strip()}",
            f"active compiler is {out.strip()!r}; rustc {TOOLCHAIN} required")
    lock = os.path.join(ROOT, "Cargo.lock")
    ignored = run(["git", "check-ignore", "-q", "Cargo.lock"])[0] == 0
    r.check(os.path.exists(lock) and not ignored, "Cargo.lock present and not git-ignored",
            "Cargo.lock missing or git-ignored")
    check_root_manifest(ROOT, r)
    check_authorized_p1_patch(ROOT, r)
    check_manifest_pins(ROOT, r)
    code, _, err = run(["cargo", "build", "--workspace", "--locked", "-q"])
    r.check(code == 0, "cargo build --workspace --locked", f"cargo build --workspace --locked failed:\n{err[-2000:]}")
    meta = metadata(ROOT)
    check_smithay(meta, ROOT, r)
    return meta


