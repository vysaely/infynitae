    code, out, _ = run(["rustc", "--version"])
    r.check(code == 0 and out.startswith(f"rustc {TOOLCHAIN} "), f"active compiler: {out.strip()}",
            f"active compiler is {out.strip()!r}; rustc {TOOLCHAIN} required")
    lock = os.path.join(ROOT, "Cargo.lock")
    ignored = run(["git", "check-ignore", "-q", "Cargo.lock"])[0] == 0
    r.check(os.path.exists(lock) and not ignored, "Cargo.lock present and not git-ignored",
            "Cargo.lock missing or git-ignored")
    check_root_manifest(ROOT, r)
    code, _, err = run(["cargo", "build", "--workspace", "--locked", "-q"])
    r.check(code == 0, "cargo build --workspace --locked", f"cargo build --workspace --locked failed:\n{err[-2000:]}")
    meta = metadata(ROOT)
    check_smithay(meta, r)
    return meta


# ------------------------------------------------------------------ [2] DAG

def dag_problems(meta):
    """Returns a list of DAG violations; empty when the graph matches the architecture."""
    problems = []
    by_id = {p["id"]: p for p in meta["packages"]}
    ws_names = {by_id[i]["name"]: i for i in meta["workspace_members"]}
    expected = set(PRODUCT + ENFORCEMENT)
    if set(ws_names) != expected:
        problems.append(f"workspace members {sorted(ws_names)} != expected {sorted(expected)}")
    nodes = {n["id"]: n for n in meta["resolve"]["nodes"]}

    def direct(pid):
        """(name, dev_only) for every direct dependency of any class."""
        out = []
        for d in nodes[pid]["deps"]:
            kinds = {k["kind"] for k in d["dep_kinds"]}
            if kinds & {None, "build", "dev"}:
                out.append((by_id[d["pkg"]]["name"], kinds == {"dev"}))
        return out

    def allowed_external(name, dev_only):
        return ALLOWED_EXTERNAL[name] | (ALLOWED_DEV_EXTERNAL[name] if dev_only else set())

    def closure(pid):
        seen, stack = set(), [pid]
        while stack:
            for d in nodes[stack.pop()]["deps"]:
                kinds = {k["kind"] for k in d["dep_kinds"]}
                if kinds & {None, "build", "dev"} and d["pkg"] not in seen:
                    seen.add(d["pkg"])
                    stack.append(d["pkg"])
        return {by_id[i]["name"] for i in seen}

    for name in PRODUCT:
        if name not in ws_names:
            continue
        pid = ws_names[name]
        deps = direct(pid)
        if name == CORE and deps:
            problems.append(f"{CORE} has dependencies {[d for d, _ in deps]}; it must have none (INV-ARCH-1)")
        for d, dev_only in deps:
            if d in ws_names:
                if d not in ALLOWED_INTERNAL[name]:
                    problems.append(f"forbidden edge {name} -> {d}")
            elif d not in allowed_external(name, dev_only):
                problems.append(f"{name} depends on external crate {d!r}{' (dev)' if dev_only else ''}; allowed: {sorted(allowed_external(name, dev_only)) or 'none'}")
        for bad in sorted(closure(pid) & FORBIDDEN_TRANSITIVE.get(name, set())):
            problems.append(f"{name} transitively depends on forbidden {bad}")
    # declared manifest edges too: a declaration Cargo drops from the resolve (for example a
    # dependency without a library target) is still a layering violation
    for name in PRODUCT:
        pkg = by_id.get(ws_names.get(name, ""))
        if not pkg:
            continue
        if name == CORE and pkg["dependencies"]:
            problems.append(f"{CORE} declares dependencies {[d['name'] for d in pkg['dependencies']]}; it must declare none (INV-ARCH-1)")
        for d in pkg["dependencies"]:
            if d.get("kind") not in (None, "build", "dev"):
                continue
            kind_str = f" ({d['kind']})" if d.get("kind") else ""
            if d["name"] in ws_names and d["name"] not in ALLOWED_INTERNAL[name]:
                problems.append(f"declared edge {name} -> {d['name']}{kind_str} is forbidden")
            elif d["name"] not in ws_names and d["name"] not in allowed_external(name, d.get("kind") == "dev"):
                problems.append(f"{name} declares external crate {d['name']!r}{kind_str}; allowed: {sorted(allowed_external(name, d.get('kind') == 'dev')) or 'none'}")
            if d["name"] in ENFORCEMENT:
                problems.append(f"product crate {name} declares enforcement crate {d['name']}{kind_str}")
    for name in ENFORCEMENT:
        for p in PRODUCT:
            if p in ws_names and name in closure(ws_names[p]):
                problems.append(f"product crate {p} depends on enforcement crate {name}")
    return problems


def check_dag(meta, r):
    print("\n[2] Dependency DAG (INV-ARCH-1; C1.3, C1.4, C7.1, C7.4)")
    problems = dag_problems(meta)
    for p in problems:
        r.fail(p)
    if not problems:
        r.ok(f"{CORE} has no dependencies (normal, dev, or build)")
        r.ok("every workspace edge is allowed: wayland -> core; backends -> wayland, core; ipc -> core; bin -> all")
        r.ok("no wayland -> backend/ipc, ipc <-> wayland, backend <-> backend, product -> enforcement")
        r.ok("smithay reachable only from the adapter and its dependents; core and ipc closures exclude it")


# ------------------------------------------------------------------ [3] probe features

def check_probe_features(meta, r):
    print("\n[3] Probe-feature hygiene")
    problems = []
    by_name = {p["name"]: p for p in meta["packages"] if p["id"] in meta["workspace_members"]}
    for name in PRODUCT:
        p = by_name.get(name)
        if not p:
            continue
        feats = p["features"]
        for f, enables in feats.items():
            if f == "default":
                if any("probe_" in e for e in enables):
                    problems.append(f"{name}: default features enable a probe: {enables}")
            elif not f.startswith("probe_"):
                problems.append(f"{name}: feature {f!r} is not a probe; INC-0 product crates declare probe features only")
            elif any(not e.split("/")[-1].startswith("probe_") for e in enables):
                problems.append(f"{name}: probe feature {f!r} enables non-probe {enables}")
        for d in p["dependencies"]:
            if any(x.startswith("probe_") for x in d["features"]):
                problems.append(f"{name}: dependency {d['name']} is declared with probe features {d['features']}")
    for x in problems:
        r.fail(x)
    if not problems:
        r.ok("probe features are named probe_*, off by default, never enabled by a dependency declaration")


# ------------------------------------------------------------------ [4] source rules

def rules_binary():
    code, _, err = run(["cargo", "build", "--locked", "-q", "-p", RULES], env={"CARGO_TARGET_DIR": PROBE_TARGET})
    if code != 0:
        raise RuntimeError(f"building {RULES} failed:\n{err}")
    return os.path.join(PROBE_TARGET, "debug", RULES)


def source_rules(binary, root):
    code, out, err = run([binary, "--root", root])
    return code, out + err


def check_source_rules(binary, r):
    print("\n[4] Structural source rules (2g, 2h, mint location, wayland names, unsafe policy)")
    code, out = source_rules(binary, ROOT)
    for line in out.splitlines():
        if line.startswith("ok"):
            r.ok(line[2:].strip())
        elif line.strip():
            r.fail(line.removeprefix("FAIL").strip())
    if code != 0 and "FAIL" not in out:
        r.fail(f"{RULES} exited {code}")


# ------------------------------------------------------------------ [5] compile probes

def compile_probe(package, feature):
    """Returns (exit code, [error diagnostics], cargo stderr)."""
    code, out, err = run(["cargo", "build", "--locked", "-p", package, "--features", feature,
                          "--message-format=json"], env={"CARGO_TARGET_DIR": PROBE_TARGET})
    errors = []
    for line in out.splitlines():
        try:
            m = json.loads(line)
        except json.JSONDecodeError:
            continue
        if m.get("reason") != "compiler-message":
            continue
        d = m["message"]
        if d["level"] not in ("error", "error: internal compiler error"):
            continue
        if d["message"].startswith("aborting due to"):
            continue
        primary = [s for s in d["spans"] if s["is_primary"]]
        errors.append({
            "code": (d.get("code") or {}).get("code"),
            "message": d["message"],
            "rendered": d.get("rendered") or d["message"],
            "file": primary[0]["file_name"] if primary else None,
            "line": primary[0]["line_start"] if primary else None,
            "package": m.get("package_id", ""),
        })
    return code, errors, err


def judge(expected, file, code, errors, stderr):
    """VERDICT for one probe: ('PASS'|'VIOLATION'|'WRONG REASON'|'HARNESS ERROR', detail)."""
    if expected[0] == "compiles":
        if code == 0:
            return "PASS", "compiles"
        return "CONTROL BROKEN", "; ".join(e["message"] for e in errors) or stderr.strip()[-300:]
    if code == 0:
        return "VIOLATION", "compiled"
    if not errors:
        return "HARNESS ERROR", stderr.strip()[-300:] or "cargo failed without a compiler diagnostic"
    if len(errors) != 1:
        return "WRONG REASON", f"{len(errors)} errors: " + " | ".join(f"[{e['code']}] {e['message']}" for e in errors)
    e = errors[0]
    where = f"{e['file']}:{e['line']}"
    if file and (not e["file"] or not os.path.normpath(e["file"]).endswith(os.path.normpath(file))):
        return "WRONG REASON", f"error at {where}, expected in {file}: [{e['code']}] {e['message']}"
    if expected[0] == "code":
        _, want_code, want_text = expected
        if e["code"] != want_code or want_text not in e["rendered"]:
            return "WRONG REASON", f"got [{e['code']}] {e['message']} at {where}; want [{want_code}] containing {want_text!r}"
        return "PASS", f"[{e['code']}] {e['message']} ({where})"
    _, phrase = expected
    if e["code"] is not None or phrase not in e["message"]:
        return "WRONG REASON", f"got [{e['code']}] {e['message']} at {where}; want {phrase!r}"
    return "PASS", f"{e['message']} ({where})"


def check_probes(r):
    print("\n[5] Compile probes (each built alone; exactly one error, in its own file, with the asserted diagnostic)")
    family = None
    for pid, fam, package, feature, expected, file in PROBES_INVENTORY:
        if fam != family:
            family = fam
            print(f"  -- {fam}")
        code, errors, stderr = compile_probe(package, feature)
        verdict, detail = judge(expected, file, code, errors, stderr)
        if verdict == "PASS":
            r.ok(f"{pid}: {detail}")
        else:
            r.fail(f"{pid}: {verdict}: {detail}")
    # the probe harness itself builds with no probe enabled (a broken harness is not a pass)
    code, _, err = run(["cargo", "build", "--locked", "-q", "-p", PROBES], env={"CARGO_TARGET_DIR": PROBE_TARGET})
    r.check(code == 0, "probe harness builds with no probe enabled", f"probe harness broken:\n{err[-1000:]}")


# ------------------------------------------------------------------ [6] seeded negative controls

COPY_ITEMS = ["Cargo.toml", "Cargo.lock", "rust-toolchain.toml", "crates", "enforcement"]


def tree_digest():
    h = hashlib.sha256()
    for item in COPY_ITEMS:
        p = os.path.join(ROOT, item)
        files = [p] if os.path.isfile(p) else sorted(
            os.path.join(d, f) for d, _, fs in os.walk(p) for f in fs)
        for f in files:
            h.update(os.path.relpath(f, ROOT).encode())
            with open(f, "rb") as fh:
                h.update(fh.read())
    return h.hexdigest()


def fresh_copy():
    tmp = tempfile.mkdtemp(prefix="verify-architecture-")
    for item in COPY_ITEMS:
        src = os.path.join(ROOT, item)
        dst = os.path.join(tmp, item)
        if os.path.isdir(src):
            shutil.copytree(src, dst)
        else:
            shutil.copy2(src, dst)
    return tmp


def edit(root, rel, fn):
    p = os.path.join(root, rel)
    with open(p) as f:
        text = f.read()
    new = fn(text)
    if new == text:
        raise RuntimeError(f"seed did not change {rel}")
    with open(p, "w") as f:
        f.write(new)


def append(text):
    return lambda t: t + text


def replace(old, new):
    return lambda t: t.replace(old, new, 1)


