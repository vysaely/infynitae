class Quiet(Results):
    def ok(self, msg):
        pass

    def fail(self, msg):
        self.failures += 1


def check_mutations(binary, r):
    print("\n[6] Seeded negative controls (temporary copies; each defect must be detected)")
    before = tree_digest()
    for desc, rule, rel, seed in SOURCE_SEEDS:
        tmp = fresh_copy()
        try:
            edit(tmp, rel, seed)
            code, out = source_rules(binary, tmp)
            hit = code != 0 and any(l.startswith(f"FAIL {rule}:") for l in out.splitlines())
            r.check(hit, f"detected: {desc} ({rule})", f"NOT DETECTED: {desc} (expected {rule})\n{out}")
        except Exception as e:  # a seed the checks never saw is a broken control, not a detection
            r.fail(f"CONTROL BROKEN: {desc}: {e}")
        finally:
            shutil.rmtree(tmp)
    for desc, want, edits in INVENTORY_SEEDS:
        tmp = fresh_copy()
        try:
            for rel, seed in edits:
                edit_or_create(tmp, rel, seed)
            code, out = source_rules(binary, tmp)
            lines = out.splitlines()
            failed = any(l.startswith("FAIL unsafe-policy:") for l in lines)
            passed = "ok   unsafe-policy" in lines
            hit = failed if want == "FAIL" else (passed and not failed)
            r.check(hit, f"unsafe inventory: {desc} ({want})",
                    f"unsafe inventory: {desc}: expected {want}\n{out}")
        except Exception as e:  # a seed the checks never saw is a broken control, not a detection
            r.fail(f"CONTROL BROKEN: {desc}: {e}")
        finally:
            shutil.rmtree(tmp)
    for desc, rel, line, kind in GRAPH_SEEDS:
        tmp = fresh_copy()
        try:
            q = Quiet()
            if kind == "dag-acyclic":
                # remove the backend's own adapter edge first so the seed is not a Cargo cycle
                def strip_adapter_edge(text):
                    t = text.replace('infynitae-wayland = { path = "../infynitae-wayland" }\n', '')
                    return re.sub(r'probe_[a-z_]+ = \["infynitae-wayland/[a-z_]+"\]\n?', '', t)
                edit(tmp, "crates/infynitae-backend-headless/Cargo.toml", strip_adapter_edge)
                kind = "dag"
            if kind == "append-dag":
                edit(tmp, rel, append(line))
                hit = bool(dag_problems(metadata(tmp, locked=False)))
            elif kind == "dag":
                edit(tmp, rel, replace("[dependencies]\n", f"[dependencies]\n{line}\n"))
                hit = bool(dag_problems(metadata(tmp, locked=False)))
            elif kind == "smithay":
                edit(tmp, rel, replace('version = "=0.7.0"', 'version = "0.7"'))
                hit = not check_smithay(metadata(tmp, locked=False), tmp, q)
            elif kind == "toolchain":
                edit(tmp, rel, replace(f'channel = "{TOOLCHAIN}"', 'channel = "stable"'))
                hit = not check_toolchain(tmp, q)
            elif kind == "patch-remove":
                edit(tmp, rel, replace(f'\n# Canonical dependency patch authorized under D-B12-PIN (OB-11 Option B):\n# Smithay 0.7.0 minimal P1 correction for defect W-SM-4c (seat pointer leave deactivation).\n[patch.crates-io]\nsmithay = {{ path = "{AUTHORIZED_SMITHAY_PATCH_REL}" }}\n', ''))
                hit = not check_root_manifest(tmp, q)
            elif kind == "patch-arbitrary":
                edit(tmp, rel, replace(f'smithay = {{ path = "{AUTHORIZED_SMITHAY_PATCH_REL}" }}',
                                       f'smithay = {{ path = "{AUTHORIZED_SMITHAY_PATCH_REL}" }}\ncalloop = {{ path = "vendor/calloop" }}'))
                hit = not check_root_manifest(tmp, q)
            elif kind == "patch-unpinned":
                edit(tmp, rel, replace(f'path = "{AUTHORIZED_SMITHAY_PATCH_REL}"', 'git = "https://github.com/smithay/smithay"'))
                hit = not check_root_manifest(tmp, q)
            elif kind == "patch-revision":
                edit(tmp, rel, replace(f'path = "{AUTHORIZED_SMITHAY_PATCH_REL}"', 'path = "vendor/smithay-0.7.1"'))
                hit = not check_root_manifest(tmp, q)
            elif kind == "patch-modification":
                edit(tmp, rel, append('\n// unauthorized modification\n'))
                hit = not check_authorized_p1_patch(tmp, q)
            elif kind == "dep-upgrade":
                edit(tmp, rel, replace('version = "=0.7.0"', 'version = "=0.8.0"'))
                hit = not check_manifest_pins(tmp, q)
            r.check(hit, f"detected: {desc}", f"NOT DETECTED: {desc}")
        except Exception as e:  # a seed the checks never saw is a broken control, not a detection
            r.fail(f"CONTROL BROKEN: {desc}: {e}")
        finally:
            shutil.rmtree(tmp)
    # The probe judge rejects compilation, wrong error codes and harness failures.
    by_id = {p[0]: p for p in PROBES_INVENTORY}
