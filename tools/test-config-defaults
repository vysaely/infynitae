#!/bin/sh
# tools/test-config-defaults: verify default settings values match config/config documentation.
set -u
fails=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: got [$2], want [$3]"
        fails=$((fails + 1))
    fi
}

# 1. FOCUS_FOLLOWS_MOUSE: default is strict
got=$(sh -c 'unset FOCUS_FOLLOWS_MOUSE; . live/env.sh >/dev/null 2>&1; echo "$FOCUS_FOLLOWS_MOUSE"')
check "FOCUS_FOLLOWS_MOUSE in env.sh defaults to strict" "$got" "strict"

# 2. PAN_MODE: default is free
got=$(sh -c 'unset PAN_MODE; . live/settings.sh apply >/dev/null 2>&1; echo "$PAN_MODE"')
check "PAN_MODE in settings.sh defaults to free" "$got" "free"
got=$(sh -c 'unset PAN_MODE; . live/env.sh >/dev/null 2>&1; echo "$PAN_MODE"')
check "PAN_MODE in env.sh defaults to free" "$got" "free"

# 3. XWAYLAND: default is true, false disables satellite in session
got=$(sh -c 'unset XWAYLAND; . live/env.sh >/dev/null 2>&1; echo "$XWAYLAND"')
check "XWAYLAND in env.sh defaults to true" "$got" "true"
got=$(sh -c 'XWAYLAND=false; XWLS=""; case "${XWAYLAND:-true}" in 0|false|off|no) ;; *) XWLS="--xwayland-satellite dummy" ;; esac; echo "$XWLS"')
check "XWAYLAND=false omits xwayland-satellite arg" "$got" ""
got=$(sh -c 'XWAYLAND=true; XWLS=""; case "${XWAYLAND:-true}" in 0|false|off|no) ;; *) XWLS="--xwayland-satellite dummy" ;; esac; echo "$XWLS"')
check "XWAYLAND=true includes xwayland-satellite arg" "$got" "--xwayland-satellite dummy"

[ "$fails" = 0 ] && echo "test-config-defaults: passed" || { echo "test-config-defaults: $fails failed"; exit 1; }
