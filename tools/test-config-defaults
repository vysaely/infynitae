#!/bin/sh
# tools/test-config-defaults: verify default settings values match config/config documentation.
set -u
cd "$(dirname "$0")/.."
# a throwaway home: the scripts read ~/.config/infynitae/config, and the tester's own settings must not decide
# and no session: live/env.sh hands its environment to systemd and D-Bus, which must never be the desktop's
HOME=$(mktemp -d); export HOME
XDG_RUNTIME_DIR=$(mktemp -d); export XDG_RUNTIME_DIR
unset DBUS_SESSION_BUS_ADDRESS WAYLAND_DISPLAY DISPLAY
trap 'rm -rf "$HOME" "$XDG_RUNTIME_DIR"' EXIT
fails=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: got [$2], want [$3]"
        fails=$((fails + 1))
    fi
}

# 1. FOCUS_FOLLOWS_MOUSE: default is strict
got=$(sh -c 'unset FOCUS_FOLLOWS_MOUSE; . live/env.sh >/dev/null 2>&1; echo "$FOCUS_FOLLOWS_MOUSE"')
check "FOCUS_FOLLOWS_MOUSE in env.sh defaults to strict" "$got" "strict"

# 2. PAN_MODE: default is free
got=$(sh -c 'unset PAN_MODE; . live/settings.sh apply >/dev/null 2>&1; echo "$PAN_MODE"')
check "PAN_MODE in settings.sh defaults to free" "$got" "free"
got=$(sh -c 'unset PAN_MODE; . live/env.sh >/dev/null 2>&1; echo "$PAN_MODE"')
check "PAN_MODE in env.sh defaults to free" "$got" "free"

# 3. XWAYLAND: default is true, false disables satellite in session
got=$(sh -c 'unset XWAYLAND; . live/env.sh >/dev/null 2>&1; echo "$XWAYLAND"')
check "XWAYLAND in env.sh defaults to true" "$got" "true"
got=$(sh -c 'XWAYLAND=false; XWLS=""; case "${XWAYLAND:-true}" in 0|false|off|no) ;; *) XWLS="--xwayland-satellite dummy" ;; esac; echo "$XWLS"')
check "XWAYLAND=false omits xwayland-satellite arg" "$got" ""
got=$(sh -c 'XWAYLAND=true; XWLS=""; case "${XWAYLAND:-true}" in 0|false|off|no) ;; *) XWLS="--xwayland-satellite dummy" ;; esac; echo "$XWLS"')
check "XWAYLAND=true includes xwayland-satellite arg" "$got" "--xwayland-satellite dummy"

# 4. CORNERS: 8 unless set; SQUARE_CORNERS only squares apps (owner 2026-11-12)
got=$(sh -c 'unset SQUARE_CORNERS CORNERS; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "CORNERS unset gives LOOK_CORNERS=8" "$got" "8"
got=$(sh -c 'SQUARE_CORNERS=true; unset CORNERS; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "SQUARE_CORNERS=true leaves Infynitae's corners at 8" "$got" "8"
got=$(sh -c 'SQUARE_CORNERS=true CORNERS=12; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "CORNERS=12 sets them" "$got" "12"
got=$(sh -c 'unset CORNERS; WINDOW_CORNERS=14; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "WINDOW_CORNERS alone shapes the interface too" "$got" "14"
got=$(sh -c 'CORNERS=4 WINDOW_CORNERS=14; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "CORNERS given wins for the interface" "$got" "4"

# 5. RECORD_CODEC: default is hevc
got=$(sed -n 's/^RECORD_CODEC="\${RECORD_CODEC:-\([^}]*\)}".*/\1/p' live/record/infynitae-recorder)
check "RECORD_CODEC in infynitae-recorder defaults to hevc" "$got" "hevc"

# 6. TOUCHPAD_TAP: default is true
got=$(sh -c 'unset TOUCHPAD_TAP; . live/env.sh >/dev/null 2>&1; echo "$TOUCHPAD_TAP"')
check "TOUCHPAD_TAP in env.sh defaults to true" "$got" "true"

# 7. ACCENT prefers ACCENT over BORDER_ACTIVE and falls back when unset or empty
got=$(sh -c 'unset ACCENT; BORDER_ACTIVE="#cc70a9"; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_ACCENT"')
check "BORDER_ACTIVE alone drives LOOK_ACCENT in settings.sh" "$got" "#cc70a9"
got=$(sh -c 'ACCENT="#1188ee"; BORDER_ACTIVE="#cc70a9"; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_ACCENT"')
check "ACCENT wins over BORDER_ACTIVE in settings.sh" "$got" "#1188ee"
got=$(sh -c 'ACCENT=""; BORDER_ACTIVE="#cc70a9"; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_ACCENT"')
check "empty ACCENT falls back to BORDER_ACTIVE in settings.sh" "$got" "#cc70a9"

# 8. LOCK_WHEN_AWAY drives sleep-lock with SLEEP_LOCK fallback in reload and session.sh
reload_check() {
    TMP_RL=$(mktemp -d)
    sed -n '/^is_true() {/,/^}/p; /^reload_sleep_lock() {/,/^}/p' live/infynitae-reload > "$TMP_RL/fn.sh"
    got=$(sh -c "BIN_DIR=$TMP_RL; LIVE=$TMP_RL; stop_helper() { :; }; first() { echo dummy; }; spawn() { :; }; . $TMP_RL/fn.sh; $1; reload_sleep_lock" | tr '\n' ' ')
    rm -rf "$TMP_RL"
}
reload_check 'unset LOCK_WHEN_AWAY SLEEP_LOCK'
check "reload sleep-lock defaults on" "$got" "sleep-lock: restarted "
reload_check 'unset LOCK_WHEN_AWAY; SLEEP_LOCK=false'
check "reload sleep-lock falls back to SLEEP_LOCK=false" "$got" "sleep-lock: stopped (LOCK_WHEN_AWAY is off) "
reload_check 'LOCK_WHEN_AWAY=false; SLEEP_LOCK=true'
check "reload sleep-lock prefers LOCK_WHEN_AWAY=false over SLEEP_LOCK=true" "$got" "sleep-lock: stopped (LOCK_WHEN_AWAY is off) "
reload_check 'LOCK_WHEN_AWAY=""; SLEEP_LOCK=false'
check "reload sleep-lock empty LOCK_WHEN_AWAY falls back to SLEEP_LOCK=false" "$got" "sleep-lock: stopped (LOCK_WHEN_AWAY is off) "
got=$(sh -c 'infy_on() { [ "$1" = "true" ] || [ "$1" = "1" ] || [ "$1" = "yes" ]; }; LOCK_WHEN_AWAY=false SLEEP_LOCK=true; sed -n "/LOCK_WHEN_AWAY:-/{p;q}" live/session.sh | grep -q "LOCK_WHEN_AWAY:-" && if infy_on "${LOCK_WHEN_AWAY:-${SLEEP_LOCK:-true}}"; then echo on; else echo off; fi')
check "session.sh prefers LOCK_WHEN_AWAY over SLEEP_LOCK" "$got" "off"

[ "$fails" = 0 ] && echo "test-config-defaults: passed" || { echo "test-config-defaults: $fails failed"; exit 1; }
