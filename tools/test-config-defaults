#!/bin/sh
# tools/test-config-defaults: verify default settings values match config/config documentation.
set -u
fails=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: got [$2], want [$3]"
        fails=$((fails + 1))
    fi
}

# 1. FOCUS_FOLLOWS_MOUSE: default is strict
got=$(sh -c 'unset FOCUS_FOLLOWS_MOUSE; . live/env.sh >/dev/null 2>&1; echo "$FOCUS_FOLLOWS_MOUSE"')
check "FOCUS_FOLLOWS_MOUSE in env.sh defaults to strict" "$got" "strict"

# 2. PAN_MODE: default is free
got=$(sh -c 'unset PAN_MODE; . live/settings.sh apply >/dev/null 2>&1; echo "$PAN_MODE"')
check "PAN_MODE in settings.sh defaults to free" "$got" "free"
got=$(sh -c 'unset PAN_MODE; . live/env.sh >/dev/null 2>&1; echo "$PAN_MODE"')
check "PAN_MODE in env.sh defaults to free" "$got" "free"

# 3. XWAYLAND: default is true, false disables satellite in session
got=$(sh -c 'unset XWAYLAND; . live/env.sh >/dev/null 2>&1; echo "$XWAYLAND"')
check "XWAYLAND in env.sh defaults to true" "$got" "true"
got=$(sh -c 'XWAYLAND=false; XWLS=""; case "${XWAYLAND:-true}" in 0|false|off|no) ;; *) XWLS="--xwayland-satellite dummy" ;; esac; echo "$XWLS"')
check "XWAYLAND=false omits xwayland-satellite arg" "$got" ""
got=$(sh -c 'XWAYLAND=true; XWLS=""; case "${XWAYLAND:-true}" in 0|false|off|no) ;; *) XWLS="--xwayland-satellite dummy" ;; esac; echo "$XWLS"')
check "XWAYLAND=true includes xwayland-satellite arg" "$got" "--xwayland-satellite dummy"

# 4. SQUARE_CORNERS: default is true (LOOK_CORNERS=0)
got=$(sh -c 'unset SQUARE_CORNERS CORNERS; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "SQUARE_CORNERS unset in settings.sh gives LOOK_CORNERS=0" "$got" "0"
got=$(sh -c 'SQUARE_CORNERS=false; unset CORNERS; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "SQUARE_CORNERS=false gives LOOK_CORNERS=8" "$got" "8"
got=$(sh -c 'SQUARE_CORNERS=true CORNERS=12; . live/settings.sh >/dev/null 2>&1; look_load; echo "$LOOK_CORNERS"')
check "CORNERS=12 overrides SQUARE_CORNERS" "$got" "12"

# 5. SCREENSHARE_ASK: default is app
test_screenshare_reload() {
    val="${1:-}"
    sh -c '
        is_true() { case "$1" in 1|true|yes|on|TRUE|True) return 0 ;; *) return 1 ;; esac; }
        first="DP-1" chooser="/bin/sh" picker="fuzzel --dmenu"
        '"${val:+SCREENSHARE_ASK=$val}"'
        ask="${SCREENSHARE_ASK:-app}"
        case "$ask" in
            0|false|off|no)
                echo "chooser_type=none"
                ;;
            *)
                if [ -x "$chooser" ]; then
                    if is_true "$ask"; then mode=ask; else mode=first; fi
                    echo "chooser_type=dmenu mode=$mode"
                fi
                ;;
        esac
    '
}
got=$(test_screenshare_reload "")
check "SCREENSHARE_ASK unset defaults to dmenu mode=first" "$got" "chooser_type=dmenu mode=first"
got=$(test_screenshare_reload "true")
check "SCREENSHARE_ASK=true gives dmenu mode=ask" "$got" "chooser_type=dmenu mode=ask"
got=$(test_screenshare_reload "false")
check "SCREENSHARE_ASK=false gives chooser_type=none" "$got" "chooser_type=none"

# 6. RECORD_CODEC: default is hevc
got=$(sed -n 's/^RECORD_CODEC="\${RECORD_CODEC:-\([^}]*\)}".*/\1/p' live/record/infynitae-recorder)
check "RECORD_CODEC in infynitae-recorder defaults to hevc" "$got" "hevc"

# 7. TOUCHPAD_TAP: default is true
got=$(sh -c 'unset TOUCHPAD_TAP; . live/env.sh >/dev/null 2>&1; echo "$TOUCHPAD_TAP"')
check "TOUCHPAD_TAP in env.sh defaults to true" "$got" "true"

[ "$fails" = 0 ] && echo "test-config-defaults: passed" || { echo "test-config-defaults: $fails failed"; exit 1; }
