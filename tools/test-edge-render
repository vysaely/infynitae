#!/bin/sh
# tools/test-edge-render: the edge's four panels (Super+W, Super+L, Super+A, Super+V), drawn by
# `infynitae-edge --render` (the live drawing code, made-up content, no compositor), at two sizes
# and with the panel at the top and at the bottom. Checks each PNG is that size and not blank.
# RENDER_OUT=dir keeps them. Run from the repository root.
set -eu
REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-edge-render.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM
OUT="${RENDER_OUT:-$TMP/out}"
mkdir -p "$OUT" "$TMP/home/.config/infynitae"
LIVE="$REPO_DIR/live"
cc -O1 -o "$TMP/edge" "$LIVE/edge/infynitae-edge.c" "$LIVE/wallpaper/wlr-layer-shell-protocol.c" \
    "$LIVE/wallpaper/xdg-shell-protocol.c" "$LIVE/edge/wlr-foreign-toplevel-protocol.c" \
    $(pkg-config --cflags --libs wayland-client cairo pangocairo xkbcommon gio-2.0) -lm
fail=0
for edge in bottom top; do
    printf 'EDGE_POSITION="%s"\nSQUARE_CORNERS="true"\n' "$edge" > "$TMP/home/.config/infynitae/config"
    for size in 1920x1080 1280x800; do
        for mode in apps windows control clipboard; do
            f="$OUT/edge-$mode-$edge-$size.png"
            if ! HOME="$TMP/home" "$TMP/edge" --render "$mode" "$size" "$f"; then
                echo "FAIL $mode $edge $size: render failed"; fail=1; continue
            fi
            got=$(python3 - "$f" <<'PY'
import struct, sys, zlib
d = open(sys.argv[1], 'rb').read()
w, h = struct.unpack('>II', d[16:24])
i, raw = 8, b''
while i < len(d):
    n = struct.unpack('>I', d[i:i+4])[0]
    if d[i+4:i+8] == b'IDAT': raw += d[i+8:i+8+n]
    i += 12 + n
px = zlib.decompress(raw); first = px[1:5]
print(w, h, 1 if any(px[k:k+4] != first for k in range(1, len(px) - 4, 4099)) else 0)
PY
)
            want="$(echo "$size" | tr x ' ') 1"
            if [ "$got" = "$want" ]; then echo "ok   $mode, panel at the $edge, $size"; else echo "FAIL $mode $edge $size: got $got"; fail=1; fi
        done
    done
done

# CONTROL_MODULES: fewer modules, a shorter panel; none or only unknown words, all of them
panel_h() {
    printf 'SQUARE_CORNERS="true"\n%s\n' "$1" > "$TMP/home/.config/infynitae/config"
    HOME="$TMP/home" INFYNITAE_EDGE_RENDER_RECT=1 "$TMP/edge" --render control 1920x1080 "$TMP/m.png" | cut -d' ' -f4
}
all=$(panel_h '')
few=$(panel_h 'CONTROL_MODULES="volume session"')
junk=$(panel_h 'CONTROL_MODULES="nonsense"')
if [ -n "$few" ] && [ "$few" -lt "$all" ]; then echo "ok   CONTROL_MODULES leaves modules out ($all -> $few px)"; else echo "FAIL CONTROL_MODULES: $all -> $few"; fail=1; fi
if [ "$junk" = "$all" ]; then echo "ok   unknown module words show every module"; else echo "FAIL unknown words: $junk, all $all"; fail=1; fi
# PANEL_ lines: a panel of one's own at its place; a built-in one moved keeps its modules;
# FAVORITES adds the favorites to the apps panel; a search hides them
rect() {
    printf 'SQUARE_CORNERS="true"\n%s\n' "$2" > "$TMP/home/.config/infynitae/config"
    HOME="$TMP/home" INFYNITAE_EDGE_RENDER_RECT=1 "$TMP/edge" --render "$1" 1920x1080 "$TMP/p.png"
}
set -- $(rect mine 'PANEL_MINE="SUPER+M right center 320 clock volume"')
if [ "${1:-0}" -gt 1500 ] && [ "${2:-0}" -gt 300 ] && [ "${3:-0}" -le 330 ]; then echo "ok   a panel of one's own, at the right edge's middle"; else echo "FAIL own panel: $*"; fail=1; fi
set -- $(rect control 'PANEL_CONTROL="bottom left"')
ctl_h=$4
if [ "$1" -lt 20 ] && [ $(( $2 + $4 )) -gt 1060 ] && [ "$ctl_h" = "$all" ]; then echo "ok   the control panel moved bottom left keeps its modules"; else echo "FAIL moved control: $* (all $all)"; fail=1; fi
plain=$(rect apps '' | cut -d' ' -f4)
fav=$(rect apps 'FAVORITES="app0 Steam app3"' | cut -d' ' -f4)
if [ "$fav" -gt "$plain" ]; then echo "ok   favorites show in the apps panel ($plain -> $fav px)"; else echo "FAIL favorites: $plain -> $fav"; fail=1; fi
searched=$(INFYNITAE_EDGE_RENDER_SEARCH=fire rect apps 'FAVORITES="app0 Steam app3"' | cut -d' ' -f4)
if [ "$searched" -lt "$fav" ]; then echo "ok   a search hides the favorites"; else echo "FAIL search with favorites: $searched"; fail=1; fi
if HOME="$TMP/home" "$TMP/edge" --render nosuch 1920x1080 "$TMP/p.png" 2>/dev/null; then echo "FAIL an unknown panel rendered"; fail=1; else echo "ok   an unknown panel is refused"; fi
exit $fail
