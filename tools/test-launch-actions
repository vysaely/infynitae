#!/bin/sh
# tools/test-launch-actions: checks the action dispatcher in live/launch.sh.
# Tests:
# - Finding 19: commands and paths with spaces/options in LAUNCHER, FILE_MANAGER,
#   SCREENSHOT_CMD and SCREEN_LOCKER are run as commands; TERMINAL keeps its own arguments
# - Finding 19: game-mode parses mode and PID without unquoted set expansion
# - Finding 5: brightness-up and brightness-down handle max_brightness 0 without division by zero
# - force-close-x11 and not-responding (owner, 2026-11-22): what is said when a window is not ended
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-launch-actions.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

BIN="$TMP/bin"
HOMEDIR="$TMP/home"
RUN="$TMP/run"
LOG="$TMP/calls"
mkdir -p "$BIN" "$HOMEDIR/.config/infynitae" "$RUN" "$TMP/space dir"
chmod 700 "$RUN"

cat << 'EOF' > "$TMP/space dir/my-term"
#!/bin/sh
echo "term: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-term"

cat << 'EOF' > "$TMP/space dir/my-fm"
#!/bin/sh
echo "fm: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-fm"

cat << 'EOF' > "$TMP/space dir/my-launcher"
#!/bin/sh
echo "launcher: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-launcher"

cat << 'EOF' > "$TMP/space dir/my-lock"
#!/bin/sh
echo "lock: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-lock"

cat << 'EOF' > "$TMP/space dir/my-shot"
#!/bin/sh
echo "shot: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-shot"

cat << 'EOF' > "$BIN/gdbus"
#!/bin/sh
echo "gdbus: $*" >> "$CALL_LOG"
EOF
chmod +x "$BIN/gdbus"

fail=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: expected '$3', got '$2'"
        fail=1
    fi
}

run_action() {
    # Usage: run_action ACTION [ARG] [ENV_VAR=VAL ...]
    action="$1"
    arg="${2:-}"
    shift 2 || shift 1 || true
    env -i HOME="$HOMEDIR" PATH="$BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RUN" CALL_LOG="$LOG" \
        ENABLE_EDGE=false INFYNITAE_SETTINGS_APPLIED=1 "$@" \
        sh "$REPO_DIR/live/launch.sh" "$action" "$arg" >/dev/null 2>&1 || true
}

# 1. A terminal named with its own arguments (TERMINAL="kitty --single-instance")
cp "$TMP/space dir/my-term" "$BIN/my-term"
: > "$LOG"
run_action terminal "" TERMINAL="my-term --single-instance"
check "a terminal with its own arguments executes" "$(grep -c '^term: --single-instance' "$LOG" 2>/dev/null || true)" 1

# 2. File manager configured as command with spaces/flags
: > "$LOG"
run_action files "" FILE_MANAGER="\"$TMP/space dir/my-fm\" --custom-flag"
check "file manager with spaces and flags executes" "$(grep -c '^fm: --custom-flag' "$LOG" 2>/dev/null || true)" 1

# 3. Launcher configured as command with spaces/flags
: > "$LOG"
run_action apps "" LAUNCHER="\"$TMP/space dir/my-launcher\" --drun"
check "launcher with spaces and flags executes" "$(grep -c '^launcher: --drun' "$LOG" 2>/dev/null || true)" 1

# 4. Screen locker configured as command with spaces/flags
: > "$LOG"
run_action lock-screen "" SCREEN_LOCKER="\"$TMP/space dir/my-lock\" -f"
check "screen locker with spaces and flags executes" "$(grep -c '^lock: -f' "$LOG" 2>/dev/null || true)" 1

# 5. Screenshot command configured with spaces
: > "$LOG"
run_action screenshot "" SCREENSHOT_CMD="\"$TMP/space dir/my-shot\""
check "screenshot command with spaces executes" "$(grep -c '^shot: ' "$LOG" 2>/dev/null || true)" 1

# 6. game-mode action correctly calls gdbus without globbing
: > "$LOG"
run_action game-mode "on 4321"
check "game-mode calls RegisterGame with PID" "$(grep -c 'com.feralinteractive.GameMode.RegisterGame 4321' "$LOG" 2>/dev/null || true)" 1

# 7. Finding 20: Shortcut socket messages invoke infynitae via fallback path when not in PATH
mkdir -p "$RUN/infynitae" "$HOMEDIR/.local/bin"
python3 -c "import socket; s = socket.socket(socket.AF_UNIX); s.bind('$RUN/infynitae/shortcuts.sock')"
cat << 'EOF' > "$HOMEDIR/.local/bin/infynitae"
#!/bin/sh
echo "infynitae-bin: $*" >> "$CALL_LOG"
EOF
chmod +x "$HOMEDIR/.local/bin/infynitae"

: > "$LOG"
run_action mute ""
check "mute falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut mute' "$LOG" 2>/dev/null || true)" 1

: > "$LOG"
run_action deafen ""
check "deafen falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut deafen' "$LOG" 2>/dev/null || true)" 1

: > "$LOG"
run_action toggle-idle-inhibit ""
check "toggle-idle-inhibit falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut idle_inhibit' "$LOG" 2>/dev/null || true)" 1

: > "$LOG"
run_action toggle-privacy ""
check "toggle-privacy falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut privacy' "$LOG" 2>/dev/null || true)" 1

# 8. Finding 23: Empty BROWSER falls back to default browser
cat << 'EOF' > "$BIN/gtk-launch"
#!/bin/sh
echo "gtk-launch: $*" >> "$CALL_LOG"
EOF
chmod +x "$BIN/gtk-launch"

: > "$LOG"
run_action browser "" BROWSER=""
check "browser with empty BROWSER falls back to system default" \
    "$(grep -c '^gtk-launch:' "$LOG" 2>/dev/null || true)" 1

# 9. Finding 5: Brightness divide by zero check (verify max_brightness 0 does not divide by zero)
sys_dir="$TMP/sys/class/backlight/panel"
mkdir -p "$sys_dir"
echo 0 > "$sys_dir/brightness"
echo 0 > "$sys_dir/max_brightness"
chmod 666 "$sys_dir/brightness" "$sys_dir/max_brightness"
# launch brightness-up in subshell; check it exits cleanly and does not terminate with division by 0
rc=0
env -i HOME="$HOMEDIR" PATH="$BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RUN" CALL_LOG="$LOG" \
    INFYNITAE_SETTINGS_APPLIED=1 \
    sh -c "sh '$REPO_DIR/live/launch.sh' brightness-up" 2>"$TMP/b_err" || rc=$?
check "brightness-up with max_brightness=0 does not divide by zero" "$(grep -c 'division by 0' "$TMP/b_err" 2>/dev/null || true)" 0

# out-of-memory score: what an action opens gets 300, the lock screen keeps the desktop's
read -r base_oom < /proc/self/oom_score_adj
app_oom=$base_oom
[ "$base_oom" -lt 300 ] && app_oom=300
cat << 'EOF' > "$BIN/oom-probe"
#!/bin/sh
echo "oom: $(cat /proc/self/oom_score_adj)" >> "$CALL_LOG"
EOF
chmod +x "$BIN/oom-probe"
: > "$LOG"
run_action terminal "" TERMINAL="oom-probe"
check "an app opened by key gets out-of-memory score $app_oom" "$(grep '^oom:' "$LOG")" "oom: $app_oom"
: > "$LOG"
run_action lock-screen "" SCREEN_LOCKER="oom-probe"
check "  the lock screen keeps the desktop's $base_oom" "$(grep '^oom:' "$LOG")" "oom: $base_oom"

# force-close-x11: infynitae-xkill gets the session's root (launch.sh's parent; the trailing ":"
# keeps the shell from exec-ing launch.sh in its own place), and a window
# whose process was not ended is said in a notification
cat << 'EOF' > "$HOMEDIR/.local/bin/infynitae-xkill"
#!/bin/sh
echo "xkill: $*" >> "$CALL_LOG"
exit "$XKILL_RC"
EOF
chmod +x "$HOMEDIR/.local/bin/infynitae-xkill"
cat << 'EOF' > "$BIN/notify-send"
#!/bin/sh
echo "notify: $*" >> "$CALL_LOG"
EOF
chmod +x "$BIN/notify-send"
force_close_x11() {
    env -i HOME="$HOMEDIR" PATH="$BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RUN" CALL_LOG="$LOG" \
        ENABLE_EDGE=false INFYNITAE_SETTINGS_APPLIED=1 XKILL_RC="$1" \
        sh -c 'echo $$; sh "$0" force-close-x11 game "The Game"; :' "$REPO_DIR/live/launch.sh" \
        2>/dev/null || true
}
: > "$LOG"
root=$(force_close_x11 0)
check "force-close-x11 passes the app, the title and the session's root" \
    "$(grep '^xkill:' "$LOG")" "xkill: game The Game $root"
check "  ended: nothing to say" "$(grep -c '^notify:' "$LOG" || true)" 0
: > "$LOG"
force_close_x11 1 >/dev/null
check "  no process found: a notification says so" "$(grep '^notify:' "$LOG")" \
    "notify: -a Infynitae Could not end The Game No single process was found for its window. It was asked to close."
: > "$LOG"
force_close_x11 3 >/dev/null
check "  outside the session: a notification says so" \
    "$(grep -c '^notify: .*not one this session started' "$LOG" || true)" 1

# not-responding: the edge asks "<title> is not responding" with End and Wait; End force closes
# the window named, Wait leaves it; without an edge that can ask, a notification
cat << 'EOF' > "$HOMEDIR/.local/bin/infynitae-edge"
#!/bin/sh
echo "edge: $* [$(tr '\n' ' ')]" >> "$CALL_LOG"
[ -n "$EDGE_ANSWER" ] && echo "$EDGE_ANSWER"
exit "${EDGE_RC:-0}"
EOF
chmod +x "$HOMEDIR/.local/bin/infynitae-edge"
not_responding() {
    env -i HOME="$HOMEDIR" PATH="$BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RUN" CALL_LOG="$LOG" \
        ENABLE_EDGE=true INFYNITAE_SETTINGS_APPLIED=1 "$@" \
        sh "$REPO_DIR/live/launch.sh" not-responding 1 7 "Notes" >/dev/null 2>&1 || true
}
echo ask > "$RUN/infynitae-edge-rs.features"
: > "$LOG"
not_responding EDGE_ANSWER=End
check "not-responding asks the edge with End and Wait" "$(grep '^edge:' "$LOG")" \
    "edge: ask Notes is not responding [End Wait ]"
check "  End force closes the window named" "$(grep -c '^infynitae-bin: msg force-close 1 7$' "$LOG" || true)" 1
: > "$LOG"
not_responding EDGE_ANSWER=Wait
check "  Wait leaves it" "$(grep -c '^infynitae-bin:' "$LOG" || true)" 0
: > "$LOG"
not_responding EDGE_RC=1
check "  cancelled leaves it" "$(grep -c '^infynitae-bin:\|^notify:' "$LOG" || true)" 0
: > "$LOG"
not_responding EDGE_RC=3
check "  the edge gone: a notification instead" "$(grep '^notify:' "$LOG")" \
    "notify: -a Infynitae Notes is not responding Super+Shift+Delete ends it."
rm "$RUN/infynitae-edge-rs.features"
: > "$LOG"
not_responding EDGE_ANSWER=End
check "  an edge that cannot ask is not asked" "$(grep -c '^edge:' "$LOG" || true)" 0
check "  and a notification says it" "$(grep -c '^notify: .*Notes is not responding' "$LOG" || true)" 1
rm "$HOMEDIR/.local/bin/infynitae-edge"

# remember-window: a per-window toggle kept in the config for the window's app
remember() {
    env -i HOME="$HOMEDIR" PATH="$BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RUN" ENABLE_EDGE=false \
        INFYNITAE_SETTINGS_APPLIED=1 sh "$REPO_DIR/live/launch.sh" remember-window "$@" >/dev/null 2>&1 || true
}
line() { grep "^$1=" "$HOMEDIR/.config/infynitae/config"; }
cfg_before=$(cat "$HOMEDIR/.config/infynitae/config" 2>/dev/null || true)
printf '%s\n' 'PRIVACY_APPS="bitwarden keepassxc"' '    # Hidden from captures, by app' \
    'KEEP_ON_TOP="Picture-in-Picture, Picture in picture"' > "$HOMEDIR/.config/infynitae/config"
remember PRIVACY_APPS telegramdesktop on
check "privacy on adds the app (spaces in the old value read as separators)" "$(line PRIVACY_APPS)" 'PRIVACY_APPS="bitwarden, keepassxc, telegramdesktop"'
remember PRIVACY_APPS TelegramDesktop on
check "  the same app twice is kept once" "$(line PRIVACY_APPS)" 'PRIVACY_APPS="bitwarden, keepassxc, telegramdesktop"'
remember PRIVACY_APPS keepassxc off
check "privacy off takes it out" "$(line PRIVACY_APPS)" 'PRIVACY_APPS="bitwarden, telegramdesktop"'
check "  the comment under the line stays" "$(sed -n 2p "$HOMEDIR/.config/infynitae/config")" '    # Hidden from captures, by app'
remember KEEP_ON_TOP mpv on
check "keep on top keeps titles with spaces whole" "$(line KEEP_ON_TOP)" 'KEEP_ON_TOP="Picture-in-Picture, Picture in picture, mpv"'
remember KEEP_ON_TOP "picture in picture" off
check "  and takes one out by its name, any case" "$(line KEEP_ON_TOP)" 'KEEP_ON_TOP="Picture-in-Picture, mpv"'
remember DISCORD_KEY_PATCH evil on
check "any other setting is refused" "$(grep -c DISCORD "$HOMEDIR/.config/infynitae/config" || true)" 0
printf '%s\n' 'TERMINAL="kitty"' > "$HOMEDIR/.config/infynitae/config"
remember PRIVACY_APPS bitwarden on
check "a config without the line gets it" "$(line PRIVACY_APPS)" 'PRIVACY_APPS="bitwarden"'
printf '%s' "$cfg_before" > "$HOMEDIR/.config/infynitae/config"

# Retired CONTROL_MENU and CLIPBOARD_PICKER (2026-11-25): an old line changes nothing. Super+A
# runs the control menu, Super+V the MENU_PICKER (another command: BIND_ and EXEC_ lines).
printf '#!/bin/sh\necho control-menu >> "$CALL_LOG"\n' > "$HOMEDIR/.local/bin/infynitae-control-menu"
chmod +x "$HOMEDIR/.local/bin/infynitae-control-menu"
: > "$LOG"
run_action control-menu "" CONTROL_MENU="echo old-control >> $LOG"
check "an old CONTROL_MENU line: Super+A runs the control menu" "$(cat "$LOG")" "control-menu"
printf '#!/bin/sh\necho entry\n' > "$BIN/cliphist"
printf '#!/bin/sh\ncat > /dev/null; echo "picker: $1" >> "$CALL_LOG"\n' > "$BIN/pick"
chmod +x "$BIN/cliphist" "$BIN/pick"
: > "$LOG"
# a compositor without its own clipboard history: cliphist's, through the picker
run_action clipboard-history "" INFYNITAE_BIN=false CLIPBOARD_PICKER="pick old" MENU_PICKER="pick menu"
check "an old CLIPBOARD_PICKER line: Super+V uses MENU_PICKER" "$(cat "$LOG")" "picker: menu"
rm -f "$BIN/cliphist" "$BIN/pick" "$HOMEDIR/.local/bin/infynitae-control-menu"

# Super+S: Enter in the screenshot editor copies without writing the file, so it is told as copied;
# a saved one as saved
cat << 'EOF' > "$HOMEDIR/.local/bin/infynitae-shot"
#!/bin/sh
for f; do :; done
[ "$SHOT_SAVES" = 1 ] && : > "$f"
exit 0
EOF
chmod +x "$HOMEDIR/.local/bin/infynitae-shot"
: > "$LOG"
run_action region-screenshot "" SHOT_SAVES=0 SCREENSHOT_DIR="$TMP/shots"
check "a copied region screenshot is told as copied" "$(cat "$LOG")" "notify: -a Infynitae Screenshot copied"
: > "$LOG"
run_action region-screenshot "" SHOT_SAVES=1 SCREENSHOT_DIR="$TMP/shots"
check "a saved region screenshot is told as saved" "$(grep -c 'Screenshot saved' "$LOG")" 1
rm -f "$HOMEDIR/.local/bin/infynitae-shot"

# region-screenshot freeze overlay: runs infynitae-wallpaper with NoNewPrivs dropped via setpriv
RS_HOME="$TMP/rs_home"
RS_BIN="$TMP/rs_bin"
RS_RUN="$TMP/rs_run"
RS_LOG="$TMP/rs_nnp"
RS_SETPRIV="$TMP/rs_setpriv"
mkdir -p "$RS_HOME/.config/infynitae" "$RS_HOME/.local/bin" "$RS_HOME/infynitae" "$RS_BIN" "$RS_RUN"
ln -s "$REPO_DIR/live" "$RS_HOME/infynitae/live"
chmod 700 "$RS_RUN"
: > "$RS_LOG"
: > "$RS_SETPRIV"
printf '#!/bin/sh\necho '\''{"outputs":[{"name":"eDP-1"}]}'\''\n' > "$RS_BIN/infynitae"
printf '#!/bin/sh\nout=""; while [ $# -gt 0 ]; do out="$1"; shift; done; : > "$out"\n' > "$RS_BIN/grim"
cat > "$RS_BIN/slurp" <<EOF
#!/bin/sh
i=0
while [ ! -s "$RS_LOG" ] && [ \$i -lt 200 ]; do
    sleep 0.01
    i=\$((i + 1))
done
exit 1
EOF
cat > "$RS_BIN/setpriv" <<EOF
#!/bin/sh
echo "\$*" >> "$RS_SETPRIV"
exec /usr/bin/setpriv "\$@"
EOF
cat > "$RS_HOME/.local/bin/infynitae-wallpaper" <<EOF
#!/bin/sh
awk '/^NoNewPrivs:/ { print \$2 }' /proc/self/status > "$RS_LOG"
exec sleep 5
EOF
chmod +x "$RS_BIN/infynitae" "$RS_BIN/grim" "$RS_BIN/slurp" "$RS_BIN/setpriv" "$RS_HOME/.local/bin/infynitae-wallpaper"
env -i HOME="$RS_HOME" PATH="$RS_BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RS_RUN" \
    FREEZE_SCREENSHOT=true INFYNITAE_SETTINGS_APPLIED=1 \
    sh "$REPO_DIR/live/launch.sh" region-screenshot >/dev/null 2>&1 || true
check "region-screenshot freeze overlay drops NoNewPrivs" "$(cat "$RS_LOG")" 1
check "  via setpriv --no-new-privs --inh-caps=-all" \
    "$(grep -c -- '--no-new-privs --inh-caps=-all .*infynitae-wallpaper --overlay' "$RS_SETPRIV" || true)" 1

# Super+V (2026-11-25): the picker lists the compositor's clipboard history and the picked line's
# entry is the clipboard again (`msg clipboard use`), a pinned one too; with a compositor from
# before it, cliphist's history as before
cat << 'EOF' > "$BIN/clip-infynitae"
#!/bin/sh
case "$*" in
    "msg clipboard") [ -n "${OWN_CLIPBOARD:-}" ] && printf 'pinned:7\tkept note\n5\tgit push\n' ;;
    *) echo "clip: $*" >> "$CALL_LOG" ;;
esac
EOF
cat << 'EOF' > "$BIN/pick-line"
#!/bin/sh
sed -n "${PICK_LINE}p"
EOF
cat << 'EOF' > "$BIN/cliphist"
#!/bin/sh
case "$1" in list) printf '3\told entry\n' ;; decode) cat ;; esac
EOF
cat << 'EOF' > "$BIN/wl-copy"
#!/bin/sh
echo "wl-copy: $(cat)" >> "$CALL_LOG"
EOF
chmod +x "$BIN/clip-infynitae" "$BIN/pick-line" "$BIN/cliphist" "$BIN/wl-copy"
pick() {
    : > "$LOG"
    run_action clipboard-history "" INFYNITAE_BIN="$BIN/clip-infynitae" MENU_PICKER=pick-line "$@"
    cat "$LOG"
}
check "Super+V uses the picked entry of the compositor's history" "$(pick OWN_CLIPBOARD=1 PICK_LINE=2)" "clip: msg clipboard use 5"
check "  a pinned one too" "$(pick OWN_CLIPBOARD=1 PICK_LINE=1)" "clip: msg clipboard use 7"
check "  an older compositor: cliphist's entry, through wl-copy" "$(pick PICK_LINE=1)" "$(printf 'wl-copy: 3\told entry')"
rm "$BIN/clip-infynitae" "$BIN/pick-line" "$BIN/cliphist" "$BIN/wl-copy"

exit $fail
