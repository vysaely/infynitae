#!/bin/sh
# tools/test-launch-actions: checks the action dispatcher in live/launch.sh.
# Tests:
# - Finding 19: commands and paths with spaces/options in LAUNCHER, FILE_MANAGER,
#   SCREENSHOT_CMD, SCREEN_LOCKER, and TERMINAL are executed without word splitting
# - Finding 19: game-mode parses mode and PID without unquoted set expansion
# - Finding 5: brightness-up and brightness-down handle max_brightness 0 without division by zero
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-launch-actions.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

BIN="$TMP/bin"
HOMEDIR="$TMP/home"
RUN="$TMP/run"
LOG="$TMP/calls"
mkdir -p "$BIN" "$HOMEDIR/.config/infynitae" "$RUN" "$TMP/space dir"
chmod 700 "$RUN"

cat << 'EOF' > "$TMP/space dir/my-term"
#!/bin/sh
echo "term: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-term"

cat << 'EOF' > "$TMP/space dir/my-fm"
#!/bin/sh
echo "fm: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-fm"

cat << 'EOF' > "$TMP/space dir/my-launcher"
#!/bin/sh
echo "launcher: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-launcher"

cat << 'EOF' > "$TMP/space dir/my-lock"
#!/bin/sh
echo "lock: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-lock"

cat << 'EOF' > "$TMP/space dir/my-shot"
#!/bin/sh
echo "shot: $*" >> "$CALL_LOG"
EOF
chmod +x "$TMP/space dir/my-shot"

cat << 'EOF' > "$BIN/gdbus"
#!/bin/sh
echo "gdbus: $*" >> "$CALL_LOG"
EOF
chmod +x "$BIN/gdbus"

fail=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: expected '$3', got '$2'"
        fail=1
    fi
}

run_action() {
    # Usage: run_action ACTION [ARG] [ENV_VAR=VAL ...]
    action="$1"
    arg="${2:-}"
    shift 2 || shift 1 || true
    env -i HOME="$HOMEDIR" PATH="$BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RUN" CALL_LOG="$LOG" \
        ENABLE_EDGE=false INFYNITAE_SETTINGS_APPLIED=1 "$@" \
        sh "$REPO_DIR/live/launch.sh" "$action" "$arg" >/dev/null 2>&1 || true
}

# 1. Terminal with path containing spaces
: > "$LOG"
run_action terminal "" TERMINAL="$TMP/space dir/my-term"
check "terminal with spaces in path executes" "$(grep -c '^term:' "$LOG" 2>/dev/null || true)" 1

# 2. File manager configured as command with spaces/flags
: > "$LOG"
run_action files "" FILE_MANAGER="\"$TMP/space dir/my-fm\" --custom-flag"
check "file manager with spaces and flags executes" "$(grep -c '^fm: --custom-flag' "$LOG" 2>/dev/null || true)" 1

# 3. Launcher configured as command with spaces/flags
: > "$LOG"
run_action apps "" LAUNCHER="\"$TMP/space dir/my-launcher\" --drun"
check "launcher with spaces and flags executes" "$(grep -c '^launcher: --drun' "$LOG" 2>/dev/null || true)" 1

# 4. Screen locker configured as command with spaces/flags
: > "$LOG"
run_action lock-screen "" SCREEN_LOCKER="\"$TMP/space dir/my-lock\" -f"
check "screen locker with spaces and flags executes" "$(grep -c '^lock: -f' "$LOG" 2>/dev/null || true)" 1

# 5. Screenshot command configured with spaces
: > "$LOG"
run_action screenshot "" SCREENSHOT_CMD="\"$TMP/space dir/my-shot\""
check "screenshot command with spaces executes" "$(grep -c '^shot: ' "$LOG" 2>/dev/null || true)" 1

# 6. game-mode action correctly calls gdbus without globbing
: > "$LOG"
run_action game-mode "on 4321"
check "game-mode calls RegisterGame with PID" "$(grep -c 'com.feralinteractive.GameMode.RegisterGame 4321' "$LOG" 2>/dev/null || true)" 1

# 7. Finding 20: Shortcut socket messages invoke infynitae via fallback path when not in PATH
mkdir -p "$RUN/infynitae" "$HOMEDIR/.local/bin"
python3 -c "import socket; s = socket.socket(socket.AF_UNIX); s.bind('$RUN/infynitae/shortcuts.sock')"
cat << 'EOF' > "$HOMEDIR/.local/bin/infynitae"
#!/bin/sh
echo "infynitae-bin: $*" >> "$CALL_LOG"
EOF
chmod +x "$HOMEDIR/.local/bin/infynitae"

: > "$LOG"
run_action mute ""
check "mute falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut mute' "$LOG" 2>/dev/null || true)" 1

: > "$LOG"
run_action deafen ""
check "deafen falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut deafen' "$LOG" 2>/dev/null || true)" 1

: > "$LOG"
run_action toggle-idle-inhibit ""
check "toggle-idle-inhibit falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut idle_inhibit' "$LOG" 2>/dev/null || true)" 1

: > "$LOG"
run_action toggle-privacy ""
check "toggle-privacy falls back to ~/.local/bin/infynitae when PATH lacks it" \
    "$(grep -c 'infynitae-bin: msg shortcut privacy' "$LOG" 2>/dev/null || true)" 1

# 8. Finding 23: Empty BROWSER falls back to default browser
cat << 'EOF' > "$BIN/gtk-launch"
#!/bin/sh
echo "gtk-launch: $*" >> "$CALL_LOG"
EOF
chmod +x "$BIN/gtk-launch"

: > "$LOG"
run_action browser "" BROWSER=""
check "browser with empty BROWSER falls back to system default" \
    "$(grep -c '^gtk-launch:' "$LOG" 2>/dev/null || true)" 1

# 9. Finding 5: Brightness divide by zero check (verify max_brightness 0 does not divide by zero)
sys_dir="$TMP/sys/class/backlight/panel"
mkdir -p "$sys_dir"
echo 0 > "$sys_dir/brightness"
echo 0 > "$sys_dir/max_brightness"
chmod 666 "$sys_dir/brightness" "$sys_dir/max_brightness"
# launch brightness-up in subshell; check it exits cleanly and does not terminate with division by 0
rc=0
env -i HOME="$HOMEDIR" PATH="$BIN:/usr/bin:/bin" XDG_RUNTIME_DIR="$RUN" CALL_LOG="$LOG" \
    INFYNITAE_SETTINGS_APPLIED=1 \
    sh -c "sh '$REPO_DIR/live/launch.sh' brightness-up" 2>"$TMP/b_err" || rc=$?
check "brightness-up with max_brightness=0 does not divide by zero" "$(grep -c 'division by 0' "$TMP/b_err" 2>/dev/null || true)" 0

exit $fail
