#!/bin/sh
# tools/test-settings-sync: tests lean theme sync (live/settings.sh apply).
# - writes terminal theme files only when installed or config folder exists
# - skips apply when neither config nor settings.sh changed since last apply
# - re-applies when config changed
# - force flag re-applies even when unchanged
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-settings-sync.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

fail=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: expected '$3', got '$2'"
        fail=1
    fi
}

apply() {
    h="$1"
    shift
    HOME="$h" CONFIG_FILE="$h/.config/infynitae/config" sh "$REPO_DIR/live/settings.sh" apply "$@" >/dev/null 2>&1 || true
}

# 1. With foot not installed and no ~/.config/foot, apply writes nothing there
H1="$TMP/h1"
mkdir -p "$H1/.config/infynitae"
printf 'SURFACE_COLOR="#111317"\nBORDER_ACTIVE="#7aa2f7"\n' > "$H1/.config/infynitae/config"

apply "$H1"
check "with foot not installed and no ~/.config/foot, apply writes nothing there" \
    "$([ -e "$H1/.config/foot" ] && echo exists || echo none)" "none"
check "with alacritty not installed and no ~/.config/alacritty, apply writes nothing there" \
    "$([ -e "$H1/.config/alacritty" ] && echo exists || echo none)" "none"

# Also check with a minimal PATH where kitty is not found
MIN_BIN="$TMP/minbin"
mkdir -p "$MIN_BIN"
for cmd in sh cat cmp mv rm mkdir stat sed awk grep; do
    p=$(command -v "$cmd" 2>/dev/null || true)
    [ -n "$p" ] && ln -sf "$p" "$MIN_BIN/$cmd"
done
H_nokitty="$TMP/h_nokitty"
mkdir -p "$H_nokitty/.config/infynitae"
printf 'SURFACE_COLOR="#111317"\nBORDER_ACTIVE="#7aa2f7"\n' > "$H_nokitty/.config/infynitae/config"
PATH="$MIN_BIN" apply "$H_nokitty"
check "with kitty not installed and no ~/.config/kitty, apply writes nothing there" \
    "$([ -e "$H_nokitty/.config/kitty" ] && echo exists || echo none)" "none"

# 2. When config folder already exists, apply writes the theme file
H2="$TMP/h2"
mkdir -p "$H2/.config/infynitae" "$H2/.config/foot" "$H2/.config/alacritty"
printf 'SURFACE_COLOR="#111317"\nBORDER_ACTIVE="#7aa2f7"\n' > "$H2/.config/infynitae/config"

apply "$H2"
check "when ~/.config/foot exists, apply writes foot.ini" \
    "$([ -f "$H2/.config/foot/foot.ini" ] && echo yes || echo no)" "yes"
check "when ~/.config/alacritty exists, apply writes infynitae-theme.toml" \
    "$([ -f "$H2/.config/alacritty/infynitae-theme.toml" ] && echo yes || echo no)" "yes"

# 3. Second apply with nothing changed writes nothing (skips)
stamp="$H2/.cache/infynitae/settings-applied"
check "stamp file created on apply" "$([ -f "$stamp" ] && echo yes || echo no)" "yes"

# Touch a file that apply manages to a custom sentinel value
printf 'custom-marker\n' > "$H2/.icons/default/index.theme"
apply "$H2"
check "second apply with nothing changed writes nothing (marker preserved)" \
    "$(cat "$H2/.icons/default/index.theme" 2>/dev/null || echo missing)" "custom-marker"

# 4. A changed config writes again
# Sleep briefly or use touch -d to ensure timestamp advance
touch -d "+2 seconds" "$H2/.config/infynitae/config"
printf 'SURFACE_COLOR="#222530"\n' >> "$H2/.config/infynitae/config"
apply "$H2"
check "changed config writes again (marker overwritten)" \
    "$([ "$(cat "$H2/.icons/default/index.theme" 2>/dev/null)" = "custom-marker" ] && echo unchanged || echo overwritten)" "overwritten"

# 5. --force re-applies even when unchanged
printf 'custom-marker-force\n' > "$H2/.icons/default/index.theme"
HOME="$H2" CONFIG_FILE="$H2/.config/infynitae/config" sh "$REPO_DIR/live/settings.sh" apply --force >/dev/null 2>&1 || true
check "apply --force writes even when unchanged" \
    "$([ "$(cat "$H2/.icons/default/index.theme" 2>/dev/null)" = "custom-marker-force" ] && echo unchanged || echo overwritten)" "overwritten"

# 6. Fallback defaults without edge binary and resolved LOOK_* scheme propagation
H_FALLBACK="$TMP/h_fallback"
mkdir -p "$H_FALLBACK/.config/infynitae"
: > "$H_FALLBACK/.config/infynitae/config"
apply "$H_FALLBACK"
look_fb="$H_FALLBACK/.cache/infynitae/look"
check "fallback look uses #111317 card and e6 opacity" \
    "$(grep -E '^LOOK_CARD=|^LOOK_CARD_AA=|^LOOK_TEXT=|^LOOK_SMALL_RADIUS=' "$look_fb" | tr '\n' ' ')" \
    'LOOK_CARD="#111317" LOOK_CARD_AA="e6" LOOK_TEXT="#eef2f8" LOOK_SMALL_RADIUS="4" '

H3="$TMP/h3"
mkdir -p "$H3/.local/bin" "$H3/.config/infynitae" "$H3/.config/mako" "$H3/.config/fuzzel" \
    "$H3/.config/foot" "$H3/.config/kitty" "$H3/.config/alacritty"
cat > "$H3/.local/bin/infynitae-edge-rs" << 'EOF'
#!/bin/sh
[ "${1:-}" = "--print-theme" ] || exit 1
cat << 'OUT'
LOOK_CARD="#1b1824"
LOOK_CARD_AA="cc"
LOOK_EDGE="#e8e2f0"
LOOK_EDGE_AA="1a"
LOOK_TEXT="#e8e2f0"
LOOK_TEXT_AA="ff"
LOOK_MUTED="#a8a3b4"
LOOK_MUTED_AA="ff"
LOOK_ACCENT="#c49ef7"
LOOK_ACCENT_AA="ff"
LOOK_ON_ACCENT="#1b1824"
LOOK_ON_ACCENT_AA="ff"
LOOK_ACCENT_TEXT="#d0b2fa"
LOOK_ACCENT_TEXT_AA="ff"
LOOK_ALERT="#ed6a6f"
LOOK_ALERT_AA="ff"
LOOK_TRACK="#e8e2f0"
LOOK_TRACK_AA="1f"
LOOK_CORNERS="12"
LOOK_SMALL_RADIUS="7"
LOOK_FONT="Cantarell"
OUT
EOF
chmod +x "$H3/.local/bin/infynitae-edge-rs"
printf 'SURFACE_COLOR="#111317"\nBORDER_ACTIVE="#7aa2f7"\nTEXT_COLOR="#eef2f8"\nTHEME_SCHEME="tonal"\n' > "$H3/.config/infynitae/config"

# Count awk invocations during apply when --print-theme prints the full palette
AWK_REAL=$(command -v awk)
AWK_BIN="$TMP/awkbin"
AWK_LOG="$TMP/awk.calls"
mkdir -p "$AWK_BIN"
cat > "$AWK_BIN/awk" << EOF
#!/bin/sh
echo x >> "$AWK_LOG"
exec "$AWK_REAL" "\$@"
EOF
chmod +x "$AWK_BIN/awk"
: > "$AWK_LOG"
PATH="$AWK_BIN:$PATH" apply "$H3"
check "apply with full --print-theme runs awk at most once" "$(wc -l < "$AWK_LOG" | tr -d ' ')" "1"

check "look file saves all 21 LOOK_* lines" "$(wc -l < "$H3/.cache/infynitae/look" | tr -d ' ')" "21"
check "look file saves LOOK_ACCENT_TEXT" "$(grep '^LOOK_ACCENT_TEXT=' "$H3/.cache/infynitae/look")" 'LOOK_ACCENT_TEXT="#d0b2fa"'
check "look file saves LOOK_ALERT" "$(grep '^LOOK_ALERT=' "$H3/.cache/infynitae/look")" 'LOOK_ALERT="#ed6a6f"'
check "look file saves LOOK_FONT" "$(grep '^LOOK_FONT=' "$H3/.cache/infynitae/look")" 'LOOK_FONT="Cantarell"'

gtk3_ini="$H3/.config/gtk-3.0/settings.ini"
gtk3_css="$H3/.config/gtk-3.0/gtk.css"
check "GTK animations enabled" "$(grep '^gtk-enable-animations=' "$gtk3_ini")" "gtk-enable-animations=true"
check "GTK accent_color uses LOOK_ACCENT_TEXT" "$(grep '^@define-color accent_color ' "$gtk3_css")" "@define-color accent_color #d0b2fa;"
check "GTK borders blends translucent LOOK_EDGE onto LOOK_CARD" "$(grep '^@define-color borders ' "$gtk3_css")" "@define-color borders #302d39;"
check "GTK button radius is LOOK_SMALL_RADIUS" "$(grep -c 'border-radius: 7px;' "$gtk3_css")" "2"
check "GTK button:hover uses 8%" "$(grep '^button:hover ' "$gtk3_css")" "button:hover { background: mix(@theme_bg_color, @theme_fg_color, 0.08); }"
check "GTK rows use 16% accent with normal text while selection stays solid" \
    "$(grep -A1 '^\.view:selected' "$gtk3_css" | tr '\n' ' ')" \
    ".view:selected, treeview:selected, row:selected {     background-color: alpha(@accent_bg_color, 0.16); color: @theme_fg_color; "

mako_cfg="$H3/.config/mako/config"
check "mako font uses LOOK_FONT 13px" "$(grep '^font=' "$mako_cfg")" "font=Cantarell 13px"
check "mako margin is 24" "$(grep '^margin=' "$mako_cfg")" "margin=24"
check "mako padding is 16,18" "$(grep '^padding=' "$mako_cfg")" "padding=16,18"

fuzzel_cfg="$H3/.config/fuzzel/fuzzel.ini"
check "fuzzel font uses LOOK_FONT:pixelsize=13" "$(grep '^font=' "$fuzzel_cfg")" "font=Cantarell:pixelsize=13"
check "fuzzel selection uses 16% alpha (29)" "$(grep '^selection=' "$fuzzel_cfg")" "selection=c49ef729"

check "foot background uses LOOK_CARD" "$(grep '^background=' "$H3/.config/foot/foot.ini")" "background=1b1824"
check "kitty padding is 8" "$(grep '^window_padding_width ' "$H3/.config/kitty/infynitae-theme.conf")" "window_padding_width 8"
check "kitty selection mixes 30% accent into surface" "$(grep '^selection_background ' "$H3/.config/kitty/infynitae-theme.conf")" "selection_background #4e4063"
check "alacritty selection mixes 30% accent into surface" "$(grep '^background = ' "$H3/.config/alacritty/infynitae-theme.toml" | tail -1)" 'background = "#4e4063"'

# 7. Old-key-only config produces the same look file and themed app outputs as ACCENT, and ACCENT wins
H_old="$TMP/h_old" H_both="$TMP/h_both"
for d in "$H_old" "$H_both"; do
    mkdir -p "$d/.config/infynitae" "$d/.config/mako" "$d/.config/fuzzel" "$d/.config/foot"
done
printf 'SURFACE_COLOR="#171013"\nBORDER_ACTIVE="#cc70a9"\n' > "$H_old/.config/infynitae/config"
apply "$H_old"
mkdir -p "$TMP/old_snap"
cp "$H_old/.cache/infynitae/look" "$TMP/old_snap/look"
cp "$H_old/.config/gtk-3.0/gtk.css" "$TMP/old_snap/gtk.css"
cp "$H_old/.config/mako/config" "$TMP/old_snap/mako.config"
cp "$H_old/.config/fuzzel/fuzzel.ini" "$TMP/old_snap/fuzzel.ini"
printf 'SURFACE_COLOR="#171013"\nACCENT="#cc70a9"\n' > "$H_old/.config/infynitae/config"
apply "$H_old" --force
check "old BORDER_ACTIVE gives same look file as ACCENT" "$(cmp -s "$TMP/old_snap/look" "$H_old/.cache/infynitae/look" && echo same || echo diff)" "same"
check "old BORDER_ACTIVE gives same GTK CSS as ACCENT" "$(cmp -s "$TMP/old_snap/gtk.css" "$H_old/.config/gtk-3.0/gtk.css" && echo same || echo diff)" "same"
check "old BORDER_ACTIVE gives same mako config as ACCENT" "$(cmp -s "$TMP/old_snap/mako.config" "$H_old/.config/mako/config" && echo same || echo diff)" "same"
check "old BORDER_ACTIVE gives same fuzzel config as ACCENT" "$(cmp -s "$TMP/old_snap/fuzzel.ini" "$H_old/.config/fuzzel/fuzzel.ini" && echo same || echo diff)" "same"

printf 'SURFACE_COLOR="#171013"\nBORDER_ACTIVE="#cc70a9"\nACCENT="#1188ee"\n' > "$H_both/.config/infynitae/config"
apply "$H_both"
check "ACCENT wins when both ACCENT and BORDER_ACTIVE are set" "$(grep '^LOOK_ACCENT=' "$H_both/.cache/infynitae/look")" 'LOOK_ACCENT="#1188ee"'
printf 'SURFACE_COLOR="#171013"\nACCENT=""\nBORDER_ACTIVE="#cc70a9"\n' > "$H_both/.config/infynitae/config"
apply "$H_both" --force
check "empty ACCENT falls back to BORDER_ACTIVE" "$(grep '^LOOK_ACCENT=' "$H_both/.cache/infynitae/look")" 'LOOK_ACCENT="#cc70a9"'

exit $fail
