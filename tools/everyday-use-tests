def on_screen(e):
    o = snap()["outputs"][0]; c = o["camera"]["center"]; z = o["camera"]["zoom"]; W, H = o["mode"]
    ax, ay = e["anchor"]; w, h = e["size"]; sx, sy = (ax - c[0]) * z + W / 2, (ay - c[1]) * z + H / 2
    return sx >= 0 and sy >= 0 and sx + w * z <= W and sy + h * z <= H, f"screen=({sx:.0f},{sy:.0f}) {w}x{h}"
