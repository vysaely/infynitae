        s = snap(); o = s["outputs"][0]; c = o["camera"]["center"]; z = o["camera"]["zoom"]; W, H = o["mode"]
        for e in s["elements"]:
            ax, ay = e["anchor"]; ew, eh = e["size"]; sx, sy = (ax - c[0]) * z + W / 2, (ay - c[1]) * z + H / 2; inside = sx >= 0 and sy >= 0 and sx + ew * z <= W and sy + eh * z <= H
            res.append(f"{e['title'][:18]} screen=({sx:.0f},{sy:.0f}) {ew}x{eh} fully-on-screen={inside}")
