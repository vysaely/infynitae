def pixel(x, y):
    r = subprocess.run(["su", "tester", "-c", f"grim -g '{x},{y} 1x1' -t ppm -"], env=E, stdout=subprocess.PIPE)
    return tuple(r.stdout[-3:])
def panel_open(): return pixel(960, 8) != (13, 17, 23) and sum(pixel(960, 8)) > sum(pixel(960, 300)) + 40
