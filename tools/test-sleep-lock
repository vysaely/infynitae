#!/bin/sh
# tools/test-sleep-lock: test live/infynitae-sleep-lock, run by live/bus-watch as in a session,
# without logind or a compositor. The compositor's answer (`infynitae msg snapshot`), logind's
# delay and the lock screen are stand-ins; logind's signals and inhibitor come from tools/bus-stub
# on a private bus (tools/bus-stub.sh).
# It checks: the sleep goes on only once the compositor says the session is locked; a process
# merely named like the lock screen counts for nothing; a lock that is not confirmed keeps the
# inhibitor (the sleep is never let go early); the wake takes it again; the lock screen never
# holds it; one watcher per session.
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
SCRIPT="$REPO_DIR/live/infynitae-sleep-lock"
TMP=$(mktemp -d "/tmp/infynitae-test-sleep-lock.XXXXXX")
BIN="$TMP/bin"
mkdir -p "$BIN" "$TMP/home" "$TMP/run" "$TMP/bus"
. "$REPO_DIR/tools/bus-stub.sh"
bus_build "$TMP/bus"
bus_start
trap 'bus_stop; rm -rf "$TMP"' EXIT INT TERM

# the compositor: locked once $TMP/locked exists
cat > "$BIN/infynitae" <<EOF
#!/bin/sh
# \`msg lock\`: only a compositor that has it (\$TMP/has-msg-lock), which locks at once
if [ "\$1 \$2" = "msg lock" ]; then
    [ -f "$TMP/has-msg-lock" ] || exit 2
    touch "$TMP/locked"; echo '{"id":1,"ok":true}'; exit 0
fi
[ "\$1 \$2" = "msg snapshot" ] || exit 2
# an older compositor that cannot say whether it is locked
[ -f "$TMP/no-snapshot" ] && exit 2
if [ -f "$TMP/locked" ]; then echo '{"id":1,"ok":true,"snapshot":{"locked":true}}'
else echo '{"id":1,"ok":true,"snapshot":{"locked":false}}'; fi
EOF
# logind's delay limit: 1 s, so the test is quick
cat > "$BIN/busctl" <<EOF
#!/bin/sh
if [ -f "$TMP/long-delay" ]; then echo "t 3000000"; else echo "t 1000000"; fi
EOF
# a lock screen that locks, and one that never does
cat > "$BIN/good-lock" <<EOF
#!/bin/sh
sleep 0.3; touch "$TMP/locked"; sleep 1000
EOF
cat > "$BIN/stuck-lock" <<EOF
#!/bin/sh
exec sleep 1000
EOF
# a lock screen that fails at once
cat > "$BIN/dead-lock" <<EOF
#!/bin/sh
echo "cannot open display" >&2; exit 1
EOF
chmod +x "$BIN"/*

fail=0
# waits up to 5 s for N inhibitors open
inhibitors_are() {
    i=0
    while [ "$(inhibitors)" != "$1" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
    [ "$(inhibitors)" = "$1" ]
}
# run LOCKER [pre-locked]: one announced sleep; prints the script's log. WAKE=1: the wake after it,
# and a second watcher started meanwhile
run() {
    rm -f "$TMP/locked"
    rm -rf "$TMP/home/.local/state"
    [ "${2:-}" = pre ] && touch "$TMP/locked"
    HOME="$TMP/home" XDG_RUNTIME_DIR="$TMP/run" PATH="$BIN:$PATH" \
        INFYNITAE_BIN="$BIN/infynitae" SCREEN_LOCKER="$BIN/$1" \
        "$BUS_WATCH" --sleep "$SCRIPT" &
    pid=$!
    inhibitors_are 1 || { echo "FAIL  the watcher took no inhibitor"; fail=1; }
    bus_send "PrepareForSleep true"
    sleep 2.2
    # the inhibitor still held?
    held=no
    [ "$(inhibitors)" = 1 ] && held=yes
    if [ "${WAKE:-}" = 1 ]; then
        bus_send "PrepareForSleep false"
        woke=released
        inhibitors_are 1 && woke=held
        second=0
        HOME="$TMP/home" XDG_RUNTIME_DIR="$TMP/run" "$BUS_WATCH" --sleep "$SCRIPT" || second=$?
        sleep 0.3
        second_inhibitors=$(inhibitors)
    fi
    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    inhibitors_are 0 || { echo "FAIL  the inhibitor outlived the watcher"; fail=1; }
    pkill -f "$BIN/" 2>/dev/null || true
    LOG=$(cat "$TMP/home/.local/state/infynitae/sleep-lock.log" 2>/dev/null || true)
}
check() {
    if printf '%s\n' "$LOG" | grep -q "$2"; then echo "ok    $1"; else echo "FAIL  $1: no \"$2\" in:"; printf '%s\n' "$LOG"; fail=1; fi
}
held_is() {
    if [ "$held" = "$2" ]; then echo "ok    $1"; else echo "FAIL  $1: inhibitor held=$held"; fail=1; fi
}

WAKE=1 run good-lock
check "a confirmed lock lets the sleep go on" "lock confirmed"
check "  and then releases the inhibitor" "letting the sleep go on"
held_is "  the inhibitor is gone, the lock screen still up" no
check "the wake is logged" "woke up"
if [ "$woke" = held ]; then echo "ok    the wake takes the inhibitor again"; else echo "FAIL  no inhibitor after the wake"; fail=1; fi
if [ "$second" = 0 ] && [ "$second_inhibitors" = 1 ]; then echo "ok    a second watcher in the session ends at once"
else echo "FAIL  a second watcher: exit $second, $second_inhibitors inhibitors"; fail=1; fi

run stuck-lock
check "an unconfirmed lock is said" "no confirmation in time"
held_is "  and keeps the inhibitor" yes

# a process named like the lock screen is no lock: the script asks the compositor
mkdir -p "$TMP/named"
cp "$(command -v sleep)" "$TMP/named/infynitae-lock"
"$TMP/named/infynitae-lock" 30 &
fake=$!
run good-lock
kill "$fake" 2>/dev/null || true
check "a process named infynitae-lock counts for nothing" "starting the lock screen"

run good-lock pre
check "a session already locked starts nothing" "already locked"

# a compositor with `msg lock`: it locks at once, no lock screen is waited for, the sleep goes on
touch "$TMP/has-msg-lock"
run stuck-lock
rm -f "$TMP/has-msg-lock"
check "a compositor that locks itself is asked first" "locked by the compositor"
held_is "  and the sleep goes on at once" no

# a compositor that cannot say it is locked, and another lock screen than infynitae-lock: it must still run
# after a second; one that exited keeps the inhibitor (lock-screen audit r-14, finding 2)
touch "$TMP/no-snapshot" "$TMP/long-delay"
run dead-lock
check "a lock screen that exited confirms nothing" "the lock screen exited"
held_is "  and keeps the inhibitor" yes
run stuck-lock
check "one still running after a second is taken as the lock" "lock confirmed by the lock screen"
rm -f "$TMP/no-snapshot" "$TMP/long-delay"

exit "$fail"
