#!/bin/sh
# tools/test-install-lib: checks installer library routines (live/install-lib.sh).
# Tests:
# - Finding 9: INFY_LIVE does not use non-POSIX ${BASH_SOURCE[0]} syntax and resolves packages.txt
# - Finding 25: set_option handles values with slashes, ampersands, and backslashes
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-install-lib.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

fail=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: expected '$3', got '$2'"
        fail=1
    fi
}

# Finding 9: POSIX compatibility of script directory detection
# Ensure ${BASH_SOURCE[0]} bracket syntax is not present
has_bracket_syntax=$(grep -F '${BASH_SOURCE[0]}' "$REPO_DIR/live/install-lib.sh" || true)
check "install-lib.sh does not use \${BASH_SOURCE[0]} syntax" "$has_bracket_syntax" ""

# Verify INFY_LIVE resolves properly when sourced
resolved_live=$(bash -c "unset BASH_SOURCE; . '$REPO_DIR/live/install-lib.sh' >/dev/null 2>&1; echo \"\$INFY_LIVE\"")
check "INFY_LIVE resolves to directory containing packages.txt" \
    "$([ -f "$resolved_live/packages.txt" ] && echo yes || echo no)" "yes"

# Finding 25: set_option handles values with slashes, ampersands, and backslashes
cfg_file="$TMP/test_config"
cat << 'EOF' > "$cfg_file"
NOTIFICATIONS="mako"
EOF

# Source install-lib.sh and test set_option function
bash -c '
    src="'"$REPO_DIR"'"
    cfg="'"$cfg_file"'"
    . "'"$REPO_DIR"'/live/install-lib.sh"
    # Call install_config helper function set_option
    # We simulate set_option defined by install-lib.sh
    eval "$(sed -n "/^    set_option() {/,/}/p" "'"$REPO_DIR"'/live/install-lib.sh")"
    set_option NOTIFICATIONS "custom/path & flag\\extra"
' 2>"$TMP/sed_err" || true
val_got=$(grep '^NOTIFICATIONS=' "$cfg_file" | cut -d= -f2- || true)
check "set_option replaces setting with value containing slashes, ampersands, and backslashes" \
    "$val_got" '"custom/path & flag\extra"'

# Installer speed settings tests
STUB_DIR="$TMP/bin"
mkdir -p "$STUB_DIR"

cat << 'EOF' > "$STUB_DIR/sudo"
#!/bin/sh
echo "sudo $*" >> "$STUB_LOG"
if [ "$1" = "install" ]; then
    shift
    echo "install $*" >> "$STUB_LOG"
    exit 0
fi
"$@"
EOF
chmod +x "$STUB_DIR/sudo"

cat << 'EOF' > "$STUB_DIR/install"
#!/bin/sh
echo "install $*" >> "$STUB_LOG"
exit 0
EOF
chmod +x "$STUB_DIR/install"

cat << 'EOF' > "$STUB_DIR/modinfo"
#!/bin/sh
echo "modinfo $*" >> "$STUB_LOG"
exit "${STUB_MODINFO_EXIT:-0}"
EOF
chmod +x "$STUB_DIR/modinfo"

cat << 'EOF' > "$STUB_DIR/modprobe"
#!/bin/sh
echo "modprobe $*" >> "$STUB_LOG"
exit 0
EOF
chmod +x "$STUB_DIR/modprobe"

cat << 'EOF' > "$STUB_DIR/sysctl"
#!/bin/sh
echo "sysctl $*" >> "$STUB_LOG"
exit 0
EOF
chmod +x "$STUB_DIR/sysctl"

cat << 'EOF' > "$STUB_DIR/usermod"
#!/bin/sh
echo "usermod $*" >> "$STUB_LOG"
exit 0
EOF
chmod +x "$STUB_DIR/usermod"

cat << 'EOF' > "$STUB_DIR/getent"
#!/bin/sh
echo "getent $*" >> "$STUB_LOG"
if [ "$1" = "group" ] && [ "$2" = "realtime" ]; then
    exit "${STUB_GETENT_REALTIME_EXIT:-0}"
fi
exit 1
EOF
chmod +x "$STUB_DIR/getent"

cat << 'EOF' > "$STUB_DIR/id"
#!/bin/sh
echo "id $*" >> "$STUB_LOG"
if [ "$1" = "-nG" ]; then
    echo "${STUB_ID_GROUPS:-testuser}"
    exit 0
fi
echo "${USER:-testuser}"
EOF
chmod +x "$STUB_DIR/id"

cat << 'EOF' > "$STUB_DIR/cmp"
#!/bin/sh
exit 1
EOF
chmod +x "$STUB_DIR/cmp"

run_speed_settings() {
    modinfo_exit="$1"
    getent_exit="$2"
    id_groups="$3"
    STUB_LOG="$TMP/stub.log"
    : > "$STUB_LOG"
    OUT_LOG="$TMP/out.log"
    : > "$OUT_LOG"
    PATH="$STUB_DIR:$PATH" \
    STUB_LOG="$STUB_LOG" \
    STUB_MODINFO_EXIT="$modinfo_exit" \
    STUB_GETENT_REALTIME_EXIT="$getent_exit" \
    STUB_ID_GROUPS="$id_groups" \
    USER="testuser" \
    bash -c '
        src="'"$REPO_DIR"'"
        . "'"$REPO_DIR"'/live/install-lib.sh"
        install_speed_settings "$src"
    ' > "$OUT_LOG" 2>&1 || true
}

# 1. Full run: modinfo succeeds, realtime group exists, user not in it
run_speed_settings 0 0 "testuser wheel"
has_ntsync_file=$(grep -c '^install -D -m 644 .*live/ntsync\.conf /etc/modules-load\.d/ntsync\.conf$' "$TMP/stub.log" || true)
check "ntsync conf installed when modinfo succeeds" "$has_ntsync_file" "1"

has_modprobe=$(grep -c '^modprobe ntsync$' "$TMP/stub.log" || true)
check "ntsync modprobe called when modinfo succeeds" "$has_modprobe" "1"

has_usermod=$(grep -c '^usermod -aG realtime testuser$' "$TMP/stub.log" || true)
check "usermod called when realtime group exists and user not in it" "$has_usermod" "1"

has_login_msg=$(grep -c 'applies from the next login' "$TMP/out.log" || true)
check "login message printed on usermod" "$has_login_msg" "1"

has_sysctl_file=$(grep -c '^install -D -m 644 .*live/99-infynitae-memory\.conf /etc/sysctl\.d/99-infynitae-memory\.conf$' "$TMP/stub.log" || true)
check "memory sysctl conf installed" "$has_sysctl_file" "1"

has_sysctl_p=$(grep -c '^sysctl -p /etc/sysctl\.d/99-infynitae-memory\.conf$' "$TMP/stub.log" || true)
check "sysctl -p applied for memory conf" "$has_sysctl_p" "1"

# 2. Kernel without ntsync module (modinfo fails)
run_speed_settings 1 0 "testuser wheel"
has_ntsync_file=$(grep -c 'ntsync\.conf' "$TMP/stub.log" || true)
check "ntsync conf omitted when modinfo fails" "$has_ntsync_file" "0"

has_modprobe=$(grep -c 'modprobe' "$TMP/stub.log" || true)
check "ntsync modprobe omitted when modinfo fails" "$has_modprobe" "0"

has_sysctl_file=$(grep -c '^install -D -m 644 .*live/99-infynitae-memory\.conf /etc/sysctl\.d/99-infynitae-memory\.conf$' "$TMP/stub.log" || true)
check "memory sysctl conf still installed when modinfo fails" "$has_sysctl_file" "1"

# 3. User already in realtime group
run_speed_settings 0 0 "testuser wheel realtime"
has_usermod=$(grep -c 'usermod' "$TMP/stub.log" || true)
check "usermod omitted when user already in realtime group" "$has_usermod" "0"

# 4. Realtime group does not exist
run_speed_settings 0 1 "testuser wheel"
has_usermod=$(grep -c 'usermod' "$TMP/stub.log" || true)
check "usermod omitted when realtime group does not exist" "$has_usermod" "0"

# 5. File contents
ntsync_content=$(cat "$REPO_DIR/live/ntsync.conf" 2>/dev/null || true)
check "live/ntsync.conf content is exactly 'ntsync'" "$ntsync_content" "ntsync"

has_compaction=$(grep -c '^vm\.compaction_proactiveness = 0' "$REPO_DIR/live/99-infynitae-memory.conf" 2>/dev/null || true)
check "live/99-infynitae-memory.conf sets vm.compaction_proactiveness = 0" "$has_compaction" "1"

has_comment=$(grep -c '^#' "$REPO_DIR/live/99-infynitae-memory.conf" 2>/dev/null || true)
check "live/99-infynitae-memory.conf has a comment" "$has_comment" "1"

# 6. Delegation from install_system_files
has_call=$(grep -c 'install_speed_settings' "$REPO_DIR/live/install-lib.sh" || true)
check "install_system_files delegates to install_speed_settings" "$([ "$has_call" -ge 2 ] && echo yes || echo no)" "yes"

# 7. Power-key suspend detection covers convertibles and touchscreen+battery handhelds, not desktops
PS_DIR="$TMP/power_supply"
mkdir -p "$PS_DIR/AC"
got_no_bat=$(INFYNITAE_POWER_SUPPLY="$PS_DIR" bash -c ". '$REPO_DIR/live/install-lib.sh' && has_battery && echo yes || echo no" 2>/dev/null || echo missing)
check "has_battery is false when only AC exists" "$got_no_bat" "no"

mkdir -p "$PS_DIR/BAT1"
got_bat=$(INFYNITAE_POWER_SUPPLY="$PS_DIR" bash -c ". '$REPO_DIR/live/install-lib.sh' && has_battery && echo yes || echo no" 2>/dev/null || echo missing)
check "has_battery is true when BAT1 exists" "$got_bat" "yes"

check_power_key() {
    label="$1" tablet="$2" accel="$3" touch="$4" bat="$5" want="$6"
    got=$(bash -c "
        . '$REPO_DIR/live/install-lib.sh'
        has_tablet_mode_switch() { $tablet; }
        has_accelerometer() { $accel; }
        has_touchscreen() { $touch; }
        has_battery() { $bat; }
        wants_power_key_suspend && echo yes || echo no
    " 2>/dev/null || echo missing)
    check "$label" "$got" "$want"
}
check_power_key "power key suspend on convertible (tablet switch)" true false false false yes
check_power_key "power key suspend on convertible (accelerometer)" false true false false yes
check_power_key "power key suspend on handheld (touchscreen + battery)" false false true true yes
check_power_key "no power key suspend on desktop with USB touchscreen" false false true false no
check_power_key "no power key suspend on clamshell laptop without touchscreen" false false false true no

# 8. The Windows and Android file handlers (install_foreign_apps), with GLib's own gio in a fake
# home: another app that opens .exe files keeps them unless the menu's question was answered yes;
# the types no app opens go to the handlers.
foreign() {
    home="$TMP/foreign-$1"
    rm -rf "$home"
    mkdir -p "$home/sys/applications" "$home/home/.config" "$home/home/.local/bin" "$home/bin"
    # GLib lists an app only when its program is on PATH: the handlers' in ~/.local/bin, as
    # install_programs puts them, the others' on PATH
    for p in home/.local/bin/infynitae-windows-run home/.local/bin/infynitae-android-run bin/other bin/archives; do
        printf '#!/bin/sh\n' > "$home/$p"
        chmod +x "$home/$p"
    done
    printf '[Desktop Entry]\nType=Application\nName=Other launcher\nExec=other %%f\nMimeType=application/x-ms-dos-executable;application/x-msdownload;\n' \
        > "$home/sys/applications/other-launcher.desktop"
    printf '[Desktop Entry]\nType=Application\nName=Archives\nExec=archives %%f\nMimeType=application/vnd.android.package-archive;\n' \
        > "$home/sys/applications/archives.desktop"
    # GLib finds the apps for a type in the folder's mimeinfo.cache (update-desktop-database)
    printf '[MIME Cache]\napplication/x-ms-dos-executable=other-launcher.desktop;\napplication/x-msdownload=other-launcher.desktop;\napplication/vnd.android.package-archive=archives.desktop;\n' \
        > "$home/sys/applications/mimeinfo.cache"
    # a choice of the user's own
    printf '[Default Applications]\napplication/vnd.android.package-archive=archives.desktop\n' \
        > "$home/home/.config/mimeapps.list"
    env -i PATH="$home/bin:$PATH" HOME="$home/home" XDG_DATA_DIRS="$home/sys" FOREIGN_DEFAULTS="$2" bash -c '
        . "'"$REPO_DIR"'/live/install-lib.sh"
        [ "$1" = menu ] && { foreign_other_defaults "'"$REPO_DIR"'"; exit; }
        install_foreign_apps "'"$REPO_DIR"'"
        # the session has ~/.local/bin on PATH
        PATH="$HOME/.local/bin:$PATH"
        for t in application/x-ms-dos-executable application/x-msdownload application/x-msi \
            application/vnd.microsoft.portable-executable application/vnd.android.package-archive; do
            printf "%s " "$(default_app "$t")"
        done
    ' sh "$1" 2>&1
}
if command -v gio >/dev/null 2>&1; then
    check "the menu is told which types another app opens" "$(foreign menu false | tr '\t\n' '= ')" \
        "application/vnd.android.package-archive=archives.desktop application/x-ms-dos-executable=other-launcher.desktop application/x-msdownload=other-launcher.desktop "
    check "not asked: the other apps keep their types, the rest go to the handlers" "$(foreign keep false)" \
        "other-launcher.desktop other-launcher.desktop infynitae-windows-run.desktop infynitae-windows-run.desktop archives.desktop "
    check "not asked: the handlers are installed" \
        "$(cd "$TMP/foreign-keep/home/.local/share/applications" && ls *.desktop | tr '\n' ' ')" \
        "infynitae-android-run.desktop infynitae-windows-run.desktop "
    check "asked, yes: the handlers open every type" "$(foreign take true)" \
        "infynitae-windows-run.desktop infynitae-windows-run.desktop infynitae-windows-run.desktop infynitae-windows-run.desktop infynitae-android-run.desktop "
else
    echo "FAIL gio (glib2) is needed for the file handler checks"
    fail=1
fi

# 9. The part "Windows and Android programs": its packages only when chosen, and the choice kept
# for infynitae-update. pacman is a stand-in that has nothing installed.
mkdir -p "$TMP/nopacman"
printf '#!/bin/sh\nexit 1\n' > "$TMP/nopacman/pacman"
chmod +x "$TMP/nopacman/pacman"
foreign_pkgs() {
    PATH="$TMP/nopacman:$PATH" FOREIGN_APPS="$1" bash -c '. "'"$REPO_DIR"'/live/install-lib.sh"; wanted_pkgs' 2>/dev/null \
        | grep -x 'bubblewrap\|waydroid' | tr '\n' ' '
}
check "chosen: bubblewrap and waydroid are wanted" "$(foreign_pkgs true)" "bubblewrap waydroid "
check "not chosen: neither is" "$(foreign_pkgs false)" ""
check "the choice is saved and read back" "$(XDG_STATE_HOME="$TMP/state" bash -c '
    . "'"$REPO_DIR"'/live/install-lib.sh"
    FOREIGN_APPS=true save_install_choices
    FOREIGN_APPS=""
    load_install_choices
    echo "$FOREIGN_APPS"')" true

# 10. Disk guard install (install_disk_guard / install_btrfs_guard): non-btrfs no-op vs btrfs
DG_BIN="$TMP/dg-bin"
mkdir -p "$DG_BIN"
cat > "$DG_BIN/sudo" <<'EOF'
#!/bin/sh
echo "sudo $*" >> "$DG_LOG"
"$@"
EOF
cat > "$DG_BIN/install" <<'EOF'
#!/bin/sh
echo "install $*" >> "$DG_LOG"
EOF
cat > "$DG_BIN/findmnt" <<'EOF'
#!/bin/sh
echo "${DG_FSTYPE:-btrfs}"
EOF
cat > "$DG_BIN/systemctl" <<'EOF'
#!/bin/sh
echo "systemctl $*" >> "$DG_LOG"
cmd="$1"
[ "$cmd" = "--user" ] && cmd="$2"
case "$cmd" in
    cat) exit "${DG_SYSTEMCTL_CAT_EXIT:-0}" ;;
    is-enabled|is-active) exit "${DG_UNIT_ACTIVE_EXIT:-1}" ;;
    *) exit 0 ;;
esac
EOF
cat > "$DG_BIN/systemd-tmpfiles" <<'EOF'
#!/bin/sh
echo "systemd-tmpfiles $*" >> "$DG_LOG"
EOF
cat > "$DG_BIN/btrfs" <<'EOF'
#!/bin/sh
echo "btrfs $*" >> "$DG_LOG"
case "$1 $2" in
    "device usage")
        printf '/dev/nvme0n1p1, ID: 1\n   Device size:          107374182400\n   Device slack:         %s\n   Unallocated:          %s\n' \
            "${DG_SLACK:-0}" "${DG_UNALLOC:-32212254720}"
        ;;
    "filesystem usage")
        printf '    Device unallocated:\t\t%s\n' "${DG_UNALLOC:-32212254720}"
        ;;
esac
EOF
chmod +x "$DG_BIN"/*

run_dg() {
    dg_home="$TMP/dg-home-$1"
    rm -rf "$dg_home"
    mkdir -p "$dg_home"
    DG_LOG="$TMP/dg-$1.log"
    DG_OUT="$TMP/dg-$1.out"
    : > "$DG_LOG"
    : > "$DG_OUT"
    shift
    # Use /usr/bin:/bin after DG_BIN so cmp is the real system cmp (not STUB_DIR/cmp)
    PATH="$DG_BIN:/usr/bin:/bin" HOME="$dg_home" DG_LOG="$DG_LOG" "$@" \
        bash -c '. "'"$REPO_DIR"'/live/install-lib.sh"; '"$DG_CALL" > "$DG_OUT" 2>&1
}

# 10a. Non-btrfs root: install_btrfs_guard is a no-op; install_disk_guard installs only the user timer
DG_CALL='install_btrfs_guard "'"$REPO_DIR"'"' run_dg ext4-only env DG_FSTYPE=ext4
check "non-btrfs root: install_btrfs_guard is a complete no-op" "$(cat "$TMP/dg-ext4-only.log")" ""

DG_CALL='install_disk_guard "'"$REPO_DIR"'"' run_dg ext4 env DG_FSTYPE=ext4
check "non-btrfs root: no oomd rule installed or oomd enabled" \
    "$(grep -c 'oomd' "$TMP/dg-ext4.log" || true)" "0"
check "non-btrfs root: user timer enabled" \
    "$(grep -c '^systemctl --user enable --now infynitae-disk-guard\.timer$' "$TMP/dg-ext4.log" || true)" "1"
check "non-btrfs root: no btrfs files or resize" \
    "$(grep -cE 'btrfs|infynitae-disk-fix' "$TMP/dg-ext4.log" || true)" "0"

# 10b. Btrfs root with >= 20 GiB unallocated (30 GiB) and no reserve: installs everything and shrinks 4G
mkdir -p "$TMP/empty-sysfs"
DG_CALL='install_disk_guard "'"$REPO_DIR"'"' run_dg btrfs-ok env \
    DG_FSTYPE=btrfs DG_SLACK=3584 DG_UNALLOC=32212254720 INFYNITAE_DISK_GUARD_BTRFS="$TMP/empty-sysfs"
check "btrfs root: tmpfiles conf installed" \
    "$(grep -c '^install -D -m 644 .*/etc/tmpfiles\.d/btrfs-reclaim\.conf$' "$TMP/dg-btrfs-ok.log" || true)" "1"
check "btrfs root: tmpfiles applied" \
    "$(grep -c '^systemd-tmpfiles --create /etc/tmpfiles\.d/btrfs-reclaim\.conf$' "$TMP/dg-btrfs-ok.log" || true)" "1"
check "btrfs root: balance service and timer installed" \
    "$(grep -c '^install -D -m 644 .*/etc/systemd/system/btrfs-balance-light\.' "$TMP/dg-btrfs-ok.log" || true)" "2"
check "btrfs root: balance and scrub timers enabled" \
    "$(grep -cE '^systemctl enable --now (btrfs-balance-light|btrfs-scrub@-)\.timer$' "$TMP/dg-btrfs-ok.log" || true)" "2"
check "btrfs root: infynitae-disk-fix installed with 755" \
    "$(grep -c '^install -D -m 755 .*infynitae-disk-fix /usr/local/lib/infynitae-disk-fix$' "$TMP/dg-btrfs-ok.log" || true)" "1"
check "btrfs root: polkit rule installed with 644" \
    "$(grep -c '^install -D -m 644 .*50-infynitae-disk-fix.rules /etc/polkit-1/rules.d/50-infynitae-disk-fix.rules$' "$TMP/dg-btrfs-ok.log" || true)" "1"
check "btrfs root: 4 GiB reserve created when unallocated >= 20 GiB" \
    "$(grep -c '^btrfs filesystem resize 1:-4G /$' "$TMP/dg-btrfs-ok.log" || true)" "1"

# 10c. Btrfs root with < 20 GiB unallocated (12 GiB): skips reserve and says so
DG_CALL='install_disk_guard "'"$REPO_DIR"'"' run_dg btrfs-small env \
    DG_FSTYPE=btrfs DG_SLACK=0 DG_UNALLOC=12884901888 INFYNITAE_DISK_GUARD_BTRFS="$TMP/empty-sysfs"
check "btrfs small root: skips 4 GiB resize" \
    "$(grep -c 'btrfs filesystem resize' "$TMP/dg-btrfs-small.log" || true)" "0"
check "btrfs small root: explains why reserve skipped" \
    "$(grep -c 'less than 20 GiB unallocated' "$TMP/dg-btrfs-small.out" || true)" "1"

# 10d. Btrfs root already having 4 GiB reserve (idempotent): does not shrink again
DG_CALL='install_disk_guard "'"$REPO_DIR"'"' run_dg btrfs-idem env \
    DG_FSTYPE=btrfs DG_SLACK=4294970880 DG_UNALLOC=159693934592 INFYNITAE_DISK_GUARD_BTRFS="$TMP/empty-sysfs"
check "btrfs existing reserve: does not resize again" \
    "$(grep -c 'btrfs filesystem resize' "$TMP/dg-btrfs-idem.log" || true)" "0"
check "btrfs existing reserve: reports already set" \
    "$(grep -c 'reserve is already set' "$TMP/dg-btrfs-idem.out" || true)" "1"

# 10e. Dry-run never invokes sudo or writes user units
DG_CALL='install_disk_guard "'"$REPO_DIR"'" --dry-run' run_dg dry-ext4 env DG_FSTYPE=ext4
check "dry-run on ext4 calls no sudo" \
    "$(grep -c '^sudo ' "$TMP/dg-dry-ext4.log" || true)" "0"
check "dry-run writes no user units" \
    "$([ -e "$TMP/dg-home-dry-ext4/.config/systemd/user/infynitae-disk-guard.timer" ] && echo yes || echo no)" "no"

# 10f. DISK_GUARD=false skips install_disk_guard and persists across save/load; legacy defaults true
DG_CALL='DISK_GUARD=false install_disk_guard "'"$REPO_DIR"'"' run_dg disabled env DG_FSTYPE=btrfs
check "DISK_GUARD=false skips all actions" "$(cat "$TMP/dg-disabled.log")" ""

check "DISK_GUARD=false saved and read back" "$(XDG_STATE_HOME="$TMP/dg-state" bash -c '
    . "'"$REPO_DIR"'/live/install-lib.sh"
    DISK_GUARD=false save_install_choices
    DISK_GUARD=""
    load_install_choices
    echo "$DISK_GUARD"')" "false"

mkdir -p "$TMP/dg-legacy-state/infynitae"
printf 'SKIP=""\nFOREIGN_APPS=false\n' > "$TMP/dg-legacy-state/infynitae/install-choices"
check "legacy install-choices defaults DISK_GUARD to true" "$(XDG_STATE_HOME="$TMP/dg-legacy-state" bash -c '
    . "'"$REPO_DIR"'/live/install-lib.sh"
    load_install_choices
    echo "$DISK_GUARD"')" "true"

# 10g. Idempotency: when units are active/enabled and sysfs reclaim is 1, no enable or resize runs
mkdir -p "$TMP/sysfs-reclaim-on/uuid1/allocation/data"
printf '1\n' > "$TMP/sysfs-reclaim-on/uuid1/allocation/data/dynamic_reclaim"
printf '1\n' > "$TMP/sysfs-reclaim-on/uuid1/allocation/data/periodic_reclaim"
DG_CALL='install_disk_guard "'"$REPO_DIR"'"' run_dg btrfs-active env \
    DG_FSTYPE=btrfs DG_SLACK=4294970880 DG_UNALLOC=159693934592 DG_UNIT_ACTIVE_EXIT=0 \
    INFYNITAE_DISK_GUARD_BTRFS="$TMP/sysfs-reclaim-on"
check "idempotent run does not re-enable active timers" \
    "$(grep -cE '^systemctl (--user )?enable ' "$TMP/dg-btrfs-active.log" || true)" "0"

# 10h. install.sh --help documents --no-disk-guard
check "install.sh --help lists --no-disk-guard" \
    "$("$REPO_DIR/install.sh" --help | grep -c -- '--no-disk-guard' || true)" "1"

# 11. install_programs replaces the compositor only when its content changed, and says so in
# COMPOSITOR_CHANGED (infynitae-update tells from it whether a restart brings anything). A source
# with only the compositor and build scripts that do nothing; the other programs are missing.
src="$TMP/programs-src"
mkdir -p "$src/target/release" "$src/live" "$TMP/programs-home"
printf '#!/bin/sh\nexit 0\n' > "$src/live/build-satellite.sh"
cp "$src/live/build-satellite.sh" "$src/live/build-helpers.sh"
install_compositor() {
    env -i PATH="$PATH" HOME="$TMP/programs-home" CARGO_TARGET_DIR=target bash -c '
        . "'"$REPO_DIR"'/live/install-lib.sh"
        install_programs "'"$src"'" 2>/dev/null
        echo "$COMPOSITOR_CHANGED $(stat -c %i "$HOME/.local/bin/infynitae")"'
}
printf 'one' > "$src/target/release/infynitae"
first=$(install_compositor)
check "first install: changed" "${first%% *}" true
second=$(install_compositor)
check "the same content again: not changed, the file left as it was" "$second" "false ${first#* }"
printf 'two' > "$src/target/release/infynitae"
third=$(install_compositor)
check "new content: changed" "${third%% *}" true
check "new content: installed" "$(cat "$TMP/programs-home/.local/bin/infynitae")" two

exit $fail
