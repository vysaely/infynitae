#!/bin/sh
# tools/test-recorder-backend: which engine keeps the replay buffer (REPLAY_BACKEND), which codec
# gpu-screen-recorder gets, and that stopping a recording leaves the replay stream and chunks
# intact, with stubs; nothing is recorded.
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "${TMPDIR:-/tmp}/infynitae-test-recorder.XXXXXX")
cleanup() {
    if [ -f "$TMP/run/infynitae-recorder-supervisor.pid" ]; then
        sup_pid=$(cat "$TMP/run/infynitae-recorder-supervisor.pid" 2>/dev/null || true)
        [ -n "$sup_pid" ] && kill -9 "$sup_pid" 2>/dev/null || true
    fi
    if [ -f "$TMP/run/infynitae-recording.pid" ]; then
        rec_pgid=$(cat "$TMP/run/infynitae-recording.pid" 2>/dev/null || true)
        case "$rec_pgid" in
            ''|0|1|*[!0-9]*) ;;
            *) kill -TERM -"$rec_pgid" 2>/dev/null || true ;;
        esac
    fi
    if [ -d "$TMP/stub" ]; then
        for pf in "$TMP/stub/stream.pids" "$TMP/stub/ffmpeg.pids"; do
            [ -f "$pf" ] || continue
            while IFS= read -r p; do
                [ -n "$p" ] && kill -TERM "$p" 2>/dev/null || true
            done < "$pf"
        done
        sleep 0.1
        for pf in "$TMP/stub/stream.pids" "$TMP/stub/ffmpeg.pids"; do
            [ -f "$pf" ] || continue
            while IFS= read -r p; do
                [ -n "$p" ] && kill -9 "$p" 2>/dev/null || true
            done < "$pf"
        done
    fi
    rm -rf "$TMP"
}
trap cleanup EXIT INT TERM
mkdir -p "$TMP/bin" "$TMP/home/.local/bin" "$TMP/run" "$TMP/replay" "$TMP/stub"

fail=0
check() {
    if [ "$2" = "$3" ]; then
        echo "ok   $1"
    else
        echo "FAIL $1: expected '$3', got '$2'"
        fail=1
    fi
}

# a stub that can or cannot read a screen and lists the codecs in $STUB_CODECS
cat > "$TMP/bin/gpu-screen-recorder" <<'STUB'
#!/bin/sh
case "$1" in
    --list-capture-options) [ "${STUB_SCREEN:-yes}" = yes ] && echo "DP-1|1920x1080"; echo portal ;;
    --info) echo section=system_info; echo 'vendor|amd'; echo section=video_codecs
            for c in $STUB_CODECS; do echo "$c"; done; echo section=image_formats; echo jpeg ;;
    *) echo "gsr $*" ;;
esac
STUB
chmod +x "$TMP/bin/gpu-screen-recorder"

# runs one function of the recorder with the stub on PATH (or without it: NO_GSR=1)
run() {
    path="$TMP/bin:/usr/bin:/bin"
    [ "${NO_GSR:-0}" = 1 ] && path="/usr/bin:/bin"
    env -i HOME="$TMP/home" XDG_RUNTIME_DIR="$TMP/run" PATH="$path" \
        INFYNITAE_RECORDER_FUNCTIONS=1 RECORD_CODEC="${RECORD_CODEC:-hevc}" \
        REPLAY_STORAGE="${REPLAY_STORAGE:-}" \
        STUB_CODECS="${STUB_CODECS:-}" STUB_SCREEN="${STUB_SCREEN:-yes}" \
        sh -c ". '$REPO_DIR/live/record/infynitae-recorder'; $1" 2>/dev/null
}

STUB_CODECS="h264 h264_software hevc av1"
check "the codec asked for, when the GPU has it" "$(RECORD_CODEC=av1 run gsr_codec)" "av1"
check "hevc by default" "$(run gsr_codec)" "hevc"
STUB_CODECS="h264 h264_software"
check "another GPU codec when it lacks the one asked for" "$(RECORD_CODEC=av1 run gsr_codec)" "h264"
STUB_CODECS="h264_software"
check "the CPU when the GPU encodes nothing" "$(run gsr_codec)" "h264_software"

check "usable: installed and reads a screen" "$(run 'gsr_usable && echo yes || echo no')" "yes"
check "not usable: cannot read a screen" "$(STUB_SCREEN=no run 'gsr_usable && echo yes || echo no')" "no"
check "not usable: not installed" "$(NO_GSR=1 run 'gsr_usable && echo yes || echo no')" "no"
# REPLAY_STORAGE: the buffer in RAM by default, in a file with "disk"
check "replay buffer in RAM by default" \
    "$(run start_gsr_replay | grep '^gsr ' | grep -c -- '-replay-storage')" "0"
check "replay buffer on disk with REPLAY_STORAGE=disk" \
    "$(REPLAY_STORAGE=disk run start_gsr_replay | grep '^gsr ' | grep -c -- '-replay-storage disk')" "1"
: > "$TMP/run/infynitae-gsr-failed"
check "not usable: failed 3 times this session" "$(run 'gsr_usable && echo yes || echo no')" "no"
rm "$TMP/run/infynitae-gsr-failed"

check "REPLAY_BACKEND defaults to auto" "$(run 'echo $REPLAY_BACKEND')" "auto"

# the supervisor with an engine that is gpu-screen-recorder and dies at once: after 3 quick deaths
# the compositor's capture takes over for the session (the review of 2026-11-20 found it never did)
check "gpu-screen-recorder dying at once 3 times falls back to the compositor's capture" "$(run '
    start_replay_engine() { echo gsr > "$RUNTIME_DIR/infynitae-replay-engine"; return 1; }
    supervisor_loop >/dev/null 2>&1 &
    sleep 4
    kill -9 $! 2>/dev/null
    [ -e "$RUNTIME_DIR/infynitae-gsr-failed" ] && echo yes || echo no')" "yes"

# stubs for the compositor-capture replay backend and continuous recording (nothing is captured)
cat > "$TMP/home/.local/bin/infynitae-record-stream" <<'STUB'
#!/bin/sh
if [ "${1:-}" = "--info" ]; then
    echo "WIDTH=1920"
    echo "HEIGHT=1080"
    exit 0
fi
echo "$$" >> "$STUB_DIR/stream.pids"
if [ "${STUB_IGNORE_INT:-0}" = 1 ]; then
    trap '' INT
else
    trap 'kill "$child" 2>/dev/null || true; exit 0' INT
fi
trap 'kill "$child" 2>/dev/null || true; exit 0' TERM
sleep 30 </dev/null >/dev/null 2>&1 &
child=$!
wait "$child" 2>/dev/null || true
STUB
chmod +x "$TMP/home/.local/bin/infynitae-record-stream"

cat > "$TMP/bin/ffmpeg" <<'STUB'
#!/bin/sh
last=""
for arg in "$@"; do
    last="$arg"
done
case "$last" in
    -)
        exit 0
        ;;
    */chunk%03d.mkv)
        dir=${last%/*}
        echo "$$" >> "$STUB_DIR/ffmpeg.pids"
        echo "replay" > "$dir/chunk000.mkv"
        exec cat >/dev/null
        ;;
    *)
        echo "$$" >> "$STUB_DIR/ffmpeg.pids"
        if [ "${STUB_IGNORE_INT:-0}" = 1 ]; then
            trap '' INT
            if [ -n "${STUB_SIGNAL_LOG:-}" ]; then
                trap 'echo TERM >> "$STUB_SIGNAL_LOG"; kill "$child" 2>/dev/null || true; exit 0' TERM
            else
                trap 'kill "$child" 2>/dev/null || true; exit 0' TERM
            fi
        elif [ -n "${STUB_SIGNAL_LOG:-}" ]; then
            trap 'echo INT >> "$STUB_SIGNAL_LOG"; kill "$child" 2>/dev/null || true; exit 0' INT
            trap 'echo TERM >> "$STUB_SIGNAL_LOG"; kill "$child" 2>/dev/null || true; exit 0' TERM
        else
            trap 'kill "$child" 2>/dev/null || true; exit 0' INT TERM
        fi
        sleep 30 </dev/null >/dev/null 2>&1 &
        child=$!
        wait "$child" 2>/dev/null || true
        ;;
esac
STUB
chmod +x "$TMP/bin/ffmpeg"

cat > "$TMP/bin/pactl" <<'STUB'
#!/bin/sh
exit 0
STUB
chmod +x "$TMP/bin/pactl"

cat > "$TMP/bin/notify-send" <<'STUB'
#!/bin/sh
exit 0
STUB
chmod +x "$TMP/bin/notify-send"

rec() {
    env -i HOME="$TMP/home" XDG_RUNTIME_DIR="$TMP/run" PATH="$TMP/bin:/usr/bin:/bin" \
        WAYLAND_DISPLAY=wayland-test REPLAY_BACKEND=infynitae REPLAY_DIR="$TMP/replay" \
        RECORD_AUDIO=none STUB_DIR="$TMP/stub" STUB_IGNORE_INT="${STUB_IGNORE_INT:-0}" \
        STUB_SIGNAL_LOG="${STUB_SIGNAL_LOG:-}" \
        sh "$REPO_DIR/live/record/infynitae-recorder" "$@" >/dev/null 2>&1
}

line_count() {
    if [ -f "$1" ]; then
        wc -l < "$1"
    else
        echo 0
    fi
}

wait_for_pids() {
    target_s=$1
    target_f=$2
    i=0
    while [ "$i" -lt 40 ]; do
        s_cnt=$(line_count "$TMP/stub/stream.pids")
        f_cnt=$(line_count "$TMP/stub/ffmpeg.pids")
        if [ "$s_cnt" -ge "$target_s" ] && [ "$f_cnt" -ge "$target_f" ]; then
            return 0
        fi
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

rec supervisor &
sup_bg=$!
i=0
while [ "$i" -lt 40 ] && [ ! -f "$TMP/replay/chunk000.mkv" ]; do
    sleep 0.1
    i=$((i + 1))
done
wait_for_pids 1 1 || true
replay_stream_pid=$(sed -n '1p' "$TMP/stub/stream.pids" 2>/dev/null || true)
replay_ffmpeg_pid=$(sed -n '1p' "$TMP/stub/ffmpeg.pids" 2>/dev/null || true)
echo "original-chunk000" > "$TMP/replay/chunk000.mkv"
echo "original-chunk001" > "$TMP/replay/chunk001.mkv"

STUB_SIGNAL_LOG="$TMP/stub/signals.log" rec record-start
wait_for_pids 2 2 || true
rec_pid_file=$(cat "$TMP/run/infynitae-recording.pid" 2>/dev/null || true)
rec_stream_pid=$(sed -n '2p' "$TMP/stub/stream.pids" 2>/dev/null || true)
rec_ffmpeg_pid=$(sed -n '2p' "$TMP/stub/ffmpeg.pids" 2>/dev/null || true)

replay_pgid=$(ps -o pgid= -p "$replay_stream_pid" 2>/dev/null | tr -d ' ' || true)
rec_stream_pgid=$(ps -o pgid= -p "$rec_stream_pid" 2>/dev/null | tr -d ' ' || true)
rec_ffmpeg_pgid=$(ps -o pgid= -p "$rec_ffmpeg_pid" 2>/dev/null | tr -d ' ' || true)
pgid_ok=$([ -n "$rec_pid_file" ] && [ "$rec_stream_pgid" = "$rec_pid_file" ] && [ "$rec_ffmpeg_pgid" = "$rec_pid_file" ] && [ "$replay_pgid" != "$rec_pid_file" ] && echo yes || echo no)
check "recording runs in its own process group matching its PID file" "$pgid_ok" "yes"

rec record-stop
# give supervisor_loop (>1s sleep) time to restart and wipe chunks if the replay stream died
sleep 1.5

replay_alive=$([ -n "$replay_stream_pid" ] && [ -n "$replay_ffmpeg_pid" ] && kill -0 "$replay_stream_pid" 2>/dev/null && kill -0 "$replay_ffmpeg_pid" 2>/dev/null && echo yes || echo no)
chunks_kept=$([ -f "$TMP/replay/chunk001.mkv" ] && [ "$(cat "$TMP/replay/chunk000.mkv" 2>/dev/null || true)" = "original-chunk000" ] && echo yes || echo no)
rec_stopped=$(! kill -0 "$rec_stream_pid" 2>/dev/null && ! kill -0 "$rec_ffmpeg_pid" 2>/dev/null && [ ! -e "$TMP/run/infynitae-recording.pid" ] && echo yes || echo no)
sig_first=$(head -n 1 "$TMP/stub/signals.log" 2>/dev/null || true)

check "stopping a recording leaves the replay stream running" "$replay_alive" "yes"
check "stopping a recording keeps existing replay chunks" "$chunks_kept" "yes"
check "stopping a recording terminates both recording processes" "$rec_stopped" "yes"
check "stop_recording sends SIGINT first to the recording group" "$sig_first" "INT"

prev_s=$(line_count "$TMP/stub/stream.pids")
prev_f=$(line_count "$TMP/stub/ffmpeg.pids")
STUB_IGNORE_INT=1 STUB_SIGNAL_LOG="$TMP/stub/signals_ign.log" rec record-start
wait_for_pids "$((prev_s + 1))" "$((prev_f + 1))" || true
ign_stream_pid=$(sed -n "$((prev_s + 1))p" "$TMP/stub/stream.pids" 2>/dev/null || true)
ign_ffmpeg_pid=$(sed -n "$((prev_f + 1))p" "$TMP/stub/ffmpeg.pids" 2>/dev/null || true)

rec record-stop
sleep 0.2
ign_stopped=$([ -n "$ign_stream_pid" ] && [ -n "$ign_ffmpeg_pid" ] && ! kill -0 "$ign_stream_pid" 2>/dev/null && ! kill -0 "$ign_ffmpeg_pid" 2>/dev/null && [ ! -e "$TMP/run/infynitae-recording.pid" ] && echo yes || echo no)
ign_sig=$(head -n 1 "$TMP/stub/signals_ign.log" 2>/dev/null || true)
replay_still_alive=$([ -n "$replay_stream_pid" ] && [ -n "$replay_ffmpeg_pid" ] && kill -0 "$replay_stream_pid" 2>/dev/null && kill -0 "$replay_ffmpeg_pid" 2>/dev/null && echo yes || echo no)
chunks_still_kept=$([ -f "$TMP/replay/chunk001.mkv" ] && [ "$(cat "$TMP/replay/chunk000.mkv" 2>/dev/null || true)" = "original-chunk000" ] && echo yes || echo no)

check "stop_recording escalates to SIGTERM when recording ignores SIGINT" "$ign_stopped:$ign_sig" "yes:TERM"
check "SIGTERM escalation still leaves replay running" "$replay_still_alive" "yes"
check "SIGTERM escalation still keeps replay chunks" "$chunks_still_kept" "yes"

kill -9 "$sup_bg" 2>/dev/null || true
exit $fail
