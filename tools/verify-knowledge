#!/usr/bin/env python3
"""
verify-knowledge: Automated verification and schema validator for Infynitae Native's
Permanent Engineering Knowledge System (docs/knowledge/).

Enforces:
1. Unique record IDs across the knowledge base.
2. Required metadata fields present and non-empty.
3. Allowed evidence classifications and adoption statuses.
4. Format consistency and required content sections.
5. Resolution of internal relative markdown links.
6. Explicit supersession links for SUPERSEDED records.
7. Zero modification of sealed foundation governance files by this branch
   (diffed against the merge base with main, so main advancing is not a failure).
8. No record present at that merge base has been removed (no silent loss).
9. Every record is listed in INDEX.md (discoverability).

Usage:
  tools/verify-knowledge                 all checks (local use, on a branch or main)
  tools/verify-knowledge --content-only  checks 1-6 and 9 only; skips the git checks 7-8,
                                         which compare with the merge base of `main`. CI runs
                                         this: its checkout is shallow and has no `main`, and
                                         governance branches change docs/foundation legitimately
                                         (tools/check-foundation-docs guards those). A deleted
                                         record is still caught by INDEX.md's broken link.
  tools/verify-knowledge --self-test     seeds one defect at a time into a temporary copy of
                                         docs/knowledge and requires each to be detected.
"""

import contextlib
import io
import os
import re
import shutil
import sys
import subprocess
import tempfile
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
KNOWLEDGE_DIR = REPO_ROOT / "docs" / "knowledge"
FOUNDATION_DIR = REPO_ROOT / "docs" / "foundation"

ALLOWED_EVIDENCE = {
    "SOURCE-DERIVED",
    "EXPERIMENTALLY VERIFIED",
    "INDEPENDENTLY REPRODUCED",
    "HYPOTHESIS",
    "DISPUTED",
    "CONTRADICTED",
}

ALLOWED_STATUSES = {
    "RESEARCH",
    "PROPOSED",
    "APPROVED",
    "IMPLEMENTED",
    "VALIDATED",
    "REJECTED",
    "SUPERSEDED",
    "DEFERRED",
}

REQUIRED_METADATA_FIELDS = [
    "id",
    "title",
    "subsystem",
    "source_rev",
    "date",
    "evidence_class",
    "applicability",
    "affected_branches",
    "related_invariants",
    "adoption_status",
    "next_action",
]

REQUIRED_SECTIONS = [
    "Verified Facts",
    "Unverified Hypotheses",
    "Performance & Correctness Implications",
    "Limitations & Counterexamples",
    "Reproduction Instructions",
    "Links & Citations",
]

NON_RECORD_FILES = {
    "INDEX.md",
    "README.md",
    "CONTRADICTIONS_AND_SUPERSEDED.md",
    "PROVENANCE_INVENTORY.md",
    "AGENT_INTEGRATION.md",
    "WORKFLOW.md",
}


def parse_metadata_table(text):
    """Extract metadata key-value pairs from a markdown table or frontmatter."""
    metadata = {}
    lines = text.splitlines()
    in_table = False
    for line in lines:
        stripped = line.strip()
        if stripped.startswith("|") and stripped.endswith("|"):
            parts = [p.strip() for p in stripped.split("|")[1:-1]]
            if len(parts) >= 2:
                key_raw = parts[0].strip().replace("*", "").strip().lower().replace(" ", "_").replace("-", "_")
                val_raw = parts[1].strip()
                if key_raw in {"parameter", "field", "key", ":---", "---"}:
                    continue
                metadata[key_raw] = val_raw
                in_table = True
        elif in_table and not stripped.startswith("|"):
            break
    return metadata


def parse_sections(text):
    """Find markdown level 2 or level 3 headers."""
    headers = set()
    for line in text.splitlines():
        match = re.match(r"^#{2,3}\s+(.+)$", line.strip())
        if match:
            header_name = match.group(1).strip()
            # Normalize header
            headers.add(header_name.lower())
    return headers


def git(*args):
    return subprocess.run(["git", *args], cwd=REPO_ROOT, capture_output=True, text=True, check=False)


def merge_base():
    """The commit this branch forked from main (main itself when on main)."""
    res = git("merge-base", "HEAD", "main")
    return res.stdout.strip() if res.returncode == 0 and res.stdout.strip() else None


def check_sealed_files(base):
    """Verify that this branch (committed or not) modifies no file under docs/foundation/."""
    if base is None:
        return ["Could not find the merge base with main; sealed-file check not run"]
    try:
        diff_res = subprocess.run(
            ["git", "diff", "--name-only", base, "--", "docs/foundation"],
            cwd=REPO_ROOT,
            capture_output=True,
            text=True,
            check=False,
        )
        if diff_res.returncode == 0 and diff_res.stdout.strip():
            return [f"Sealed foundation file modified: {f}" for f in diff_res.stdout.splitlines()]
    except Exception as e:
        return [f"Could not execute git diff: {e}"]
    return []


def main(content_only=False):
    errors = []
    warnings = []
    seen_ids = {}

    if not KNOWLEDGE_DIR.exists():
        print(f"Error: Knowledge directory {KNOWLEDGE_DIR} does not exist.")
        sys.exit(1)

    # 1. Sealed files check
    base = None if content_only else merge_base()
    foundation_errors = [] if content_only else check_sealed_files(base)
    if foundation_errors:
        errors.extend(foundation_errors)

    record_files = []
    for root, _, files in os.walk(KNOWLEDGE_DIR):
        for f in files:
            if f.endswith(".md"):
                rel_path = Path(root, f).relative_to(KNOWLEDGE_DIR)
                if f not in NON_RECORD_FILES and not rel_path.name.startswith("."):
                    record_files.append(Path(root, f))

    print(f"Validating {len(record_files)} knowledge records...")

    # 2. Parse and validate records
    records_by_id = {}
    for rpath in record_files:
        rel_str = "docs/knowledge/" + str(rpath.relative_to(KNOWLEDGE_DIR))
        try:
            content = rpath.read_text(encoding="utf-8")
        except Exception as e:
            errors.append(f"{rel_str}: Failed to read file: {e}")
            continue

        meta = parse_metadata_table(content)
        sections = parse_sections(content)

        # Check metadata fields
        for field in REQUIRED_METADATA_FIELDS:
            if field not in meta or not meta[field]:
                errors.append(f"{rel_str}: Missing required metadata field '{field}'")

        rec_id = meta.get("id")
        if rec_id:
            # Check ID format (e.g. KNOW-ARCH-001)
            if not re.match(r"^KNOW-[A-Z]+-\d{3}$", rec_id):
                errors.append(f"{rel_str}: Invalid ID format '{rec_id}'. Expected 'KNOW-<CATEGORY>-<NUM>'")
            if rec_id in seen_ids:
                errors.append(f"{rel_str}: Duplicate ID '{rec_id}' (first seen in {seen_ids[rec_id]})")
            else:
                seen_ids[rec_id] = rel_str
                records_by_id[rec_id] = (rpath, meta)

            # Check filename matches ID
            if not rpath.name.startswith(rec_id):
                warnings.append(f"{rel_str}: Filename does not start with ID '{rec_id}'")

        # Check Evidence Classification
        eclass = meta.get("evidence_class")
        if eclass and eclass not in ALLOWED_EVIDENCE:
            errors.append(f"{rel_str}: Invalid evidence_class '{eclass}'. Allowed: {sorted(ALLOWED_EVIDENCE)}")

        # Check Adoption Status
        astatus = meta.get("adoption_status")
        if astatus and astatus not in ALLOWED_STATUSES:
            errors.append(f"{rel_str}: Invalid adoption_status '{astatus}'. Allowed: {sorted(ALLOWED_STATUSES)}")

        # Check Superseded requirement
        if astatus == "SUPERSEDED":
            if "superseded_by" not in meta or not meta["superseded_by"]:
                errors.append(f"{rel_str}: Status is SUPERSEDED but 'superseded_by' metadata is missing or empty")

        # Check Date format YYYY-MM-DD
        dt = meta.get("date")
        if dt and not re.match(r"^\d{4}-\d{2}-\d{2}$", dt):
            errors.append(f"{rel_str}: Invalid date format '{dt}'. Expected YYYY-MM-DD")

        # Check required content sections
        for sec in REQUIRED_SECTIONS:
            sec_lower = sec.lower()
            if not any(sec_lower in s for s in sections):
                errors.append(f"{rel_str}: Missing content section '{sec}'")

        # Check local relative markdown links
        link_matches = re.findall(r"\[([^\]]+)\]\(([^)]+)\)", content)
        for link_text, link_target in link_matches:
            if link_target.startswith("http://") or link_target.startswith("https://") or link_target.startswith("#") or link_target.startswith("file://"):
                continue
            # Strip fragment
            clean_target = link_target.split("#")[0]
            if clean_target:
                target_path = (rpath.parent / clean_target).resolve()
                if not target_path.exists():
                    errors.append(f"{rel_str}: Broken relative link to '{link_target}'")

    # 3. Check Supersession links
    for rec_id, (rpath, meta) in records_by_id.items():
        if meta.get("adoption_status") == "SUPERSEDED":
            sup_id = meta.get("superseded_by", "").strip()
            if sup_id and sup_id not in seen_ids:
                errors.append(f"{seen_ids[rec_id]}: Superseded by unknown ID '{sup_id}'")

    # 3b. Relative links in the meta documents (INDEX.md, ledger, inventory, ...)
    for name in sorted(NON_RECORD_FILES):
        mpath = KNOWLEDGE_DIR / name
        if not mpath.exists():
            continue
        for _, link_target in re.findall(r"\[([^\]]+)\]\(([^)]+)\)", mpath.read_text(encoding="utf-8")):
            if link_target.startswith(("http://", "https://", "#", "file://")):
                continue
            clean_target = link_target.split("#")[0]
            if clean_target and not (mpath.parent / clean_target).resolve().exists():
                errors.append(f"docs/knowledge/{name}: Broken relative link to '{link_target}'")

    # 4. No silent loss: every record file at the merge base still exists
    if base is not None:
        listed = git("ls-tree", "-r", "--name-only", base, "--", "docs/knowledge")
        for name in listed.stdout.splitlines():
            if Path(name).name in NON_RECORD_FILES or not name.endswith(".md"):
                continue
            if not (REPO_ROOT / name).exists():
                errors.append(f"{name}: record present at merge base {base[:7]} was removed (mark it SUPERSEDED instead)")

    # 5. Discoverability: every record is linked from INDEX.md
    index_text = (KNOWLEDGE_DIR / "INDEX.md").read_text(encoding="utf-8") if (KNOWLEDGE_DIR / "INDEX.md").exists() else ""
    for rec_id, (rpath, _) in records_by_id.items():
        if str(rpath.relative_to(KNOWLEDGE_DIR)) not in index_text:
            errors.append(f"{seen_ids[rec_id]}: not linked from INDEX.md")

    print("\n--- Validation Results ---")
    if warnings:
        print(f"Warnings ({len(warnings)}):")
        for w in warnings:
            print(f"  [WARN] {w}")

    if errors:
        print(f"\nErrors ({len(errors)}):")
        for e in errors:
            print(f"  [FAIL] {e}")
        print("\nRESULT: FAILED")
        sys.exit(1)
    else:
        print(f"All {len(record_files)} knowledge records validated successfully.")
        print(f"Unique IDs: {len(seen_ids)}")
        if content_only:
            print("Sealed governance integrity: not checked (--content-only)")
        else:
            print(f"Sealed governance integrity: UNTOUCHED (against merge base {base[:7] if base else '?'})")
        print("RESULT: PASS")
        sys.exit(0)


def _seed(path, old, new):
    text = path.read_text(encoding="utf-8")
    if old not in text:
        raise RuntimeError(f"self-test: cannot seed defect, '{old}' not found in {path.name}")
    path.write_text(text.replace(old, new, 1), encoding="utf-8")


def self_test():
    """Seed one defect at a time into a copy of docs/knowledge; each must fail with its message."""
    src = REPO_ROOT / "docs" / "knowledge"
    records = sorted(p for p in src.rglob("KNOW-*.md"))
    if len(records) < 2:
        print("self-test: need at least two records")
        sys.exit(1)
    a, b = (p.relative_to(src) for p in records[:2])
    a_id = re.match(r"KNOW-[A-Z]+-\d{3}", a.name).group(0)

    def new_record(k):
        text = (k / a).read_text(encoding="utf-8").replace(a_id, "KNOW-SELFTEST-999")
        (k / a.parent / "KNOW-SELFTEST-999-seeded.md").write_text(text, encoding="utf-8")

    defects = [
        ("duplicate ID", lambda k: shutil.copy(k / a, k / a.parent / ("dup-" + a.name)), "Duplicate ID"),
        ("missing metadata field", lambda k: _seed(k / a, "| **next_action** |", "| **next_step** |"), "Missing required metadata field 'next_action'"),
        ("invalid evidence class", lambda k: _seed(k / a, "| **evidence_class** | ", "| **evidence_class** | GUESSED "), "Invalid evidence_class"),
        ("invalid adoption status", lambda k: _seed(k / a, "| **adoption_status** | ", "| **adoption_status** | MAYBE "), "Invalid adoption_status"),
        ("invalid date", lambda k: _seed(k / a, "| **date** | ", "| **date** | 14 Oct "), "Invalid date format"),
        ("missing section", lambda k: _seed(k / a, "## Limitations & Counterexamples", "## Caveats"), "Missing content section 'Limitations & Counterexamples'"),
        ("broken link in a record", lambda k: _seed(k / a, "## Links & Citations", "## Links & Citations\n- [gone](KNOW-NOWHERE-000.md)"), "Broken relative link to 'KNOW-NOWHERE-000.md'"),
        ("record not in INDEX.md", new_record, "not linked from INDEX.md"),
        ("indexed record deleted", lambda k: (k / b).unlink(), f"Broken relative link to '{b}'"),
    ]

    global KNOWLEDGE_DIR
    saved = KNOWLEDGE_DIR
    failures = 0
    try:
        for label, seed, expect in [("clean copy", lambda k: None, None)] + defects:
            with tempfile.TemporaryDirectory(prefix="verify-knowledge-") as tmp:
                k = Path(tmp) / "knowledge"
                shutil.copytree(src, k)
                seed(k)
                KNOWLEDGE_DIR = k
                out = io.StringIO()
                with contextlib.redirect_stdout(out):
                    try:
                        main(content_only=True)
                        code = 0
                    except SystemExit as e:
                        code = e.code
                text = out.getvalue()
                ok = (code == 0) if expect is None else (code == 1 and expect in text)
                print(f"  [{'ok' if ok else 'MISSED'}] {label}")
                if not ok:
                    failures += 1
                    print("    " + "\n    ".join(text.splitlines()[-8:]))
    finally:
        KNOWLEDGE_DIR = saved
    print(f"self-test: {len(defects) + 1 - failures}/{len(defects) + 1} cases correct (clean copy passes, {len(defects)} seeded defects detected)")
    print("RESULT: PASS" if not failures else "RESULT: FAILED")
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    args = sys.argv[1:]
    if args == ["--self-test"]:
        self_test()
    elif args in ([], ["--content-only"]):
        main(content_only=bool(args))
    else:
        print(__doc__)
        sys.exit(2)
