#!/bin/sh
# tools/test-session: tests for live/session.sh startup logic.
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
SESSION_SCRIPT="$REPO_DIR/live/session.sh"

TMP=$(mktemp -d "/tmp/infynitae-test-session.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

# Mock required binaries and paths
MOCK_BIN="$TMP/bin"
mkdir -p "$MOCK_BIN"
export PATH="$MOCK_BIN:$PATH"

# Fake infynitae compositor comm for $PPID check
cat > "$MOCK_BIN/renice" <<EOF
#!/bin/sh
exit 0
EOF
chmod +x "$MOCK_BIN/renice"

# ---- 1. Finding 13: State directory created at startup on fresh install
HOME1="$TMP/home1"
mkdir -p "$HOME1"
(
    export HOME="$HOME1"
    export WAYLAND_DISPLAY="wayland-test"
    export START_TERMINAL="false"
    export START_LOCKED="0"
    unset XDG_STATE_HOME
    # Run session.sh up to terminal exit
    sh "$SESSION_SCRIPT" >/dev/null 2>&1 || true
)

if [ ! -d "$HOME1/.local/state/infynitae" ]; then
    echo "FAIL Finding 13: session.sh did not create $HOME1/.local/state/infynitae"
    exit 1
fi
echo "ok Finding 13: state directory created at session start"

# ---- 2. Finding 14: Screen locker verification race on fast-exiting locker
# If a locker writes "Screen locked" and exits immediately (or daemonizes),
# kill -0 $LOCK_PID breaks out of the loop. session.sh must do a final log
# check to avoid falsely aborting the session.
HOME2="$TMP/home2"
mkdir -p "$HOME2/.local/bin"

# Fast-forking locker: forks worker to write "Screen locked", initial PID exits immediately
cat > "$HOME2/.local/bin/infynitae-lock" <<EOF
#!/bin/sh
( sleep 0.18; echo "Screen locked" ) &
exit 0
EOF
chmod +x "$HOME2/.local/bin/infynitae-lock"

# Run session.sh with START_LOCKED=1 in a subshell.
# If the race condition exists, session.sh kills $PPID / exits with 1.
# If fixed, it detects "Screen locked" and proceeds cleanly.
rc=0
(
    export HOME="$HOME2"
    export WAYLAND_DISPLAY="wayland-test"
    export START_TERMINAL="false"
    export START_LOCKED="1"
    # Provide dummy config and env
    mkdir -p "$HOME2/infynitae/live"
    : > "$HOME2/infynitae/live/env.sh"
    : > "$HOME2/infynitae/live/config.sh"
    # Intercept kill -TERM $PPID so test runner is not terminated
    cat > "$MOCK_BIN/kill" <<KEER
#!/bin/sh
exit 0
KEER
    chmod +x "$MOCK_BIN/kill"
    sh "$SESSION_SCRIPT" --lock >/dev/null 2>&1
) || rc=$?

if [ $rc -ne 0 ]; then
    echo "FAIL Finding 14: session.sh aborted (exit code $rc) on fast-exiting locker"
    exit 1
fi
echo "ok Finding 14: session.sh does not abort when locker writes confirmation before exit"

# ---- 3. Finding 21: Paths with spaces or compound commands in NOTIFICATIONS and TERMINAL
HOME3="$TMP/home3"
mkdir -p "$HOME3"
SPACED_DIR="$TMP/dir with spaces"
mkdir -p "$SPACED_DIR"

NOTIFY_MARKER="$TMP/notify_marker"
TERM_MARKER="$TMP/term_marker"

cat > "$SPACED_DIR/custom-notify" <<EOF
#!/bin/sh
touch "$NOTIFY_MARKER"
exit 0
EOF
chmod +x "$SPACED_DIR/custom-notify"

cat > "$SPACED_DIR/custom-term" <<EOF
#!/bin/sh
touch "$TERM_MARKER"
exit 0
EOF
chmod +x "$SPACED_DIR/custom-term"

(
    export HOME="$HOME3"
    export WAYLAND_DISPLAY="wayland-test"
    export START_LOCKED="0"
    export NOTIFICATIONS="'$SPACED_DIR/custom-notify' --arg"
    export TERMINAL="$SPACED_DIR/custom-term"
    export START_TERMINAL="true"
    export SESSION_RESTORE="false"
    sh "$SESSION_SCRIPT" >/dev/null 2>&1 || true
)

sleep 0.2
if [ ! -f "$NOTIFY_MARKER" ]; then
    echo "FAIL Finding 21: NOTIFICATIONS with arguments/spaces failed to execute"
    exit 1
fi
if [ ! -f "$TERM_MARKER" ]; then
    echo "FAIL Finding 21: TERMINAL path with spaces failed to execute"
    exit 1
fi
echo "ok Finding 21: spaced paths and commands in NOTIFICATIONS and TERMINAL execute cleanly"

# ---- 4. infy_on accepts 1, true, yes and on in any case and nothing else (as parse_bool does)
(
    . "$REPO_DIR/live/config.sh"
    for val in 1 true yes on TRUE True tRuE YES Yes ON On; do
        if ! infy_on "$val"; then
            echo "FAIL infy_on: rejected truthy '$val'"
            exit 1
        fi
    done
    for val in 0 false no off FALSE False NO OFF 2 "" "true1" " true" "auto" "random" "yes please"; do
        if infy_on "$val"; then
            echo "FAIL infy_on: accepted non-truthy '$val'"
            exit 1
        fi
    done
)
echo "ok infy_on: accepts 1, true, yes and on in any case and nothing else"

# ---- 5. Owner, 2026-11-22: the compositor's main thread is raised with reset-on-fork, so what it
# starts later begins at normal priority; real-time when allowed, else normal with the same flag
HOME5="$TMP/home5"
mkdir -p "$HOME5/.local/bin" "$TMP/bin5"
PRIO_LOG="$TMP/prio.log"
cp "$(command -v sh)" "$TMP/bin5/infynitae"
for tool in chrt renice; do
    cat > "$TMP/bin5/$tool" <<EOF
#!/bin/sh
echo "$tool \$*" >> "$PRIO_LOG"
case " \$* " in *" -r "*) [ -n "\${NO_RT:-}" ] && exit 1 ;; esac
exit 0
EOF
    chmod +x "$TMP/bin5/$tool"
done
session_as_compositor() {
    : > "$PRIO_LOG"
    (
        export HOME="$HOME5" WAYLAND_DISPLAY="wayland-test" START_TERMINAL="false" START_LOCKED="0"
        export PATH="$TMP/bin5:$PATH" "$@"
        # the parent is named like the compositor: $PPID of session.sh
        "$TMP/bin5/infynitae" -c 'echo $$ > "$1"; sh "$2" >/dev/null 2>&1; :' sh "$TMP/root5" \
            "$SESSION_SCRIPT"
    ) || true
    root=$(cat "$TMP/root5")
}
expect_log() {
    if [ "$(cat "$PRIO_LOG")" != "$2" ]; then
        echo "FAIL $1: expected '$2', got '$(cat "$PRIO_LOG")'"
        exit 1
    fi
    echo "ok $1"
}
session_as_compositor
expect_log "the compositor's thread: nice -10, real-time 2, reset on fork" \
    "$(printf 'renice -n -10 -p %s\nchrt -R -r -p 2 %s' "$root" "$root")"
session_as_compositor NO_RT=1
expect_log "  without real-time rights: normal priority, reset on fork" \
    "$(printf 'renice -n -10 -p %s\nchrt -R -r -p 2 %s\nchrt -R -o -p 0 %s' "$root" "$root" "$root")"

# ---- 6. Owner, 2026-11-22: the kernel ends an app before the desktop when memory runs out: what
# session.sh starts gets an out-of-memory score of 300, the lock screen started on sleep keeps the
# desktop's
HOME6="$TMP/home6"
mkdir -p "$HOME6/.local/bin"
read -r base < /proc/self/oom_score_adj
app_score=$base
[ "$base" -lt 300 ] && app_score=300
cat > "$HOME6/.local/bin/infynitae-sleep-lock" <<EOF
#!/bin/sh
cat /proc/self/oom_score_adj > "$TMP/sleep_lock_oom"
EOF
cat > "$HOME6/.local/bin/app-term" <<EOF
#!/bin/sh
cat /proc/self/oom_score_adj > "$TMP/term_oom"
EOF
chmod +x "$HOME6/.local/bin/infynitae-sleep-lock" "$HOME6/.local/bin/app-term"
(
    export HOME="$HOME6" WAYLAND_DISPLAY="wayland-test" START_LOCKED="0" SESSION_RESTORE="false"
    export START_TERMINAL="true" TERMINAL="$HOME6/.local/bin/app-term" LOCK_WHEN_AWAY="true"
    sh "$SESSION_SCRIPT" >/dev/null 2>&1
) || true
i=0
while [ ! -s "$TMP/sleep_lock_oom" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
if [ "$(cat "$TMP/term_oom")" != "$app_score" ]; then
    echo "FAIL an app session.sh starts: score $(cat "$TMP/term_oom"), expected $app_score"
    exit 1
fi
echo "ok an app session.sh starts gets out-of-memory score $app_score (the desktop has $base)"
if [ "$(cat "$TMP/sleep_lock_oom")" != "$base" ]; then
    echo "FAIL the sleep lock: score $(cat "$TMP/sleep_lock_oom"), expected $base"
    exit 1
fi
echo "ok   the lock screen started on sleep keeps the desktop's $base"

# ---- 7. One bus watcher for drives and the sleep lock (2026-11-25): session.sh starts
# infynitae-bus-watch with the two scripts, and it keeps the desktop's out-of-memory score for the
# lock screen; without it (section 6: installed before) the sleep lock runs on its own
HOME7="$TMP/home7"
B7="$HOME7/.local/bin"
mkdir -p "$B7"
cat > "$B7/infynitae-bus-watch" <<EOF
#!/bin/sh
printf '%s\n' "\$*" > "$TMP/bus_watch_args"
cat /proc/self/oom_score_adj > "$TMP/bus_watch_oom.new"
mv "$TMP/bus_watch_oom.new" "$TMP/bus_watch_oom"
EOF
printf '#!/bin/sh\ntouch "%s/script_ran"\n' "$TMP" > "$B7/infynitae-automount"
cp "$B7/infynitae-automount" "$B7/infynitae-sleep-lock"
chmod +x "$B7/infynitae-bus-watch" "$B7/infynitae-automount" "$B7/infynitae-sleep-lock"
# watch AUTOMOUNT LOCK_WHEN_AWAY: prints the bus watcher's arguments
watch() {
    rm -f "$TMP/bus_watch_oom" "$TMP/bus_watch_args"
    (
        export HOME="$HOME7" WAYLAND_DISPLAY="wayland-test" START_LOCKED="0" SESSION_RESTORE="false"
        export START_TERMINAL="false" AUTOMOUNT="$1" LOCK_WHEN_AWAY="$2"
        sh "$SESSION_SCRIPT" >/dev/null 2>&1
    ) || true
    i=0
    while [ ! -s "$TMP/bus_watch_oom" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
    cat "$TMP/bus_watch_args" 2>/dev/null || true
}
got=$(watch true true)
if [ "$got" != "--udisks $B7/infynitae-automount --sleep $B7/infynitae-sleep-lock" ]; then
    echo "FAIL the bus watcher: started with \"$got\""
    exit 1
fi
if [ "$(cat "$TMP/bus_watch_oom")" != "$base" ]; then
    echo "FAIL the bus watcher: score $(cat "$TMP/bus_watch_oom"), expected $base"
    exit 1
fi
echo "ok   one bus watcher for drives and the sleep lock, with the desktop's score $base"
got=$(watch false true)
[ "$got" = "--sleep $B7/infynitae-sleep-lock" ] || { echo "FAIL AUTOMOUNT=false: started with \"$got\""; exit 1; }
got=$(watch true false)
[ "$got" = "--udisks $B7/infynitae-automount" ] || { echo "FAIL LOCK_WHEN_AWAY=false: started with \"$got\""; exit 1; }
sleep 0.3
[ ! -e "$TMP/script_ran" ] || { echo "FAIL a script was started beside the bus watcher"; exit 1; }
echo "ok   each switch off leaves its script out, and no script runs beside the watcher"

# ---- 8. infynitae-session fallback: 2 fast crashes on new binary fall back to ~/.local/bin/infynitae.previous and notify owner
HOME7="$TMP/home7"
mkdir -p "$HOME7/.local/bin" "$HOME7/.local/state/infynitae" "$HOME7/infynitae/live" "$TMP/bin7"
cp "$REPO_DIR/live/session.sh" "$HOME7/infynitae/live/session.sh"
cp "$REPO_DIR/live/log-rotate.sh" "$HOME7/infynitae/live/log-rotate.sh" 2>/dev/null || true
cat > "$HOME7/infynitae/live/env.sh" <<'EOF'
# test no-op env
EOF
cat > "$HOME7/.local/bin/notify-send" <<EOF
#!/bin/sh
printf '%s\n' "\$*" > "$TMP/fb_notify"
touch "$HOME7/.local/state/infynitae/stop"
EOF
cat > "$HOME7/.local/bin/infynitae-lock" <<'EOF'
#!/bin/sh
echo "Screen locked"
sleep 10
EOF
cat > "$HOME7/.local/bin/infynitae" <<EOF
#!/bin/sh
echo "new" >> "$TMP/fb_starts"
exit 42
EOF
cat > "$HOME7/.local/bin/infynitae.previous" <<EOF
#!/bin/sh
echo "previous" >> "$TMP/fb_starts"
export WAYLAND_DISPLAY="wayland-fb" START_TERMINAL="false" START_LOCKED="0" SESSION_RESTORE="false" NOTIFICATIONS="none"
sh "$HOME7/infynitae/live/session.sh" >/dev/null 2>&1
i=0
while [ ! -s "$TMP/fb_notify" ] && [ \$i -lt 100 ]; do sleep 0.05; i=\$((i + 1)); done
exit 0
EOF
chmod +x "$HOME7/.local/bin/notify-send" "$HOME7/.local/bin/infynitae-lock" "$HOME7/.local/bin/infynitae" "$HOME7/.local/bin/infynitae.previous"

(
    export HOME="$HOME7" PATH="$HOME7/.local/bin:$PATH" XDG_RUNTIME_DIR="$TMP/rt7"
    mkdir -p "$XDG_RUNTIME_DIR"
    sh "$REPO_DIR/live/infynitae-session" </dev/null >/dev/null 2>&1
)
starts=$(tr '\n' ' ' < "$TMP/fb_starts")
if [ "$starts" != "new new previous " ]; then
    echo "FAIL compositor fallback start sequence: expected 'new new previous ', got '$starts'"
    exit 1
fi
echo "ok compositor fallback starts: new, new, then .previous"
if ! grep -q "Started previous Infynitae" "$TMP/fb_notify" 2>/dev/null; then
    echo "FAIL compositor fallback did not notify owner: $(cat "$TMP/fb_notify" 2>/dev/null || true)"
    exit 1
fi
echo "ok compositor fallback notified owner via notify-send"

# When .previous also crashes 3 times, infynitae-session stops cleanly (exit 1)
HOME8="$TMP/home8"
mkdir -p "$HOME8/.local/bin" "$HOME8/.local/state/infynitae" "$HOME8/infynitae/live"
cat > "$HOME8/infynitae/live/env.sh" <<'EOF'
# test no-op env
EOF
cat > "$HOME8/.local/bin/infynitae" <<EOF
#!/bin/sh
echo "new" >> "$TMP/fb8_starts"
exit 42
EOF
cat > "$HOME8/.local/bin/infynitae.previous" <<EOF
#!/bin/sh
echo "previous" >> "$TMP/fb8_starts"
exit 43
EOF
chmod +x "$HOME8/.local/bin/infynitae" "$HOME8/.local/bin/infynitae.previous"
if (
    export HOME="$HOME8" PATH="$HOME8/.local/bin:$PATH" XDG_RUNTIME_DIR="$TMP/rt8"
    mkdir -p "$XDG_RUNTIME_DIR"
    sh "$REPO_DIR/live/infynitae-session" </dev/null >/dev/null 2>&1
); then
    echo "FAIL fallback crash loop did not exit non-zero"
    exit 1
fi
starts8=$(tr '\n' ' ' < "$TMP/fb8_starts")
if [ "$starts8" != "new new previous previous previous " ]; then
    echo "FAIL fallback crash loop sequence: expected 'new new previous previous previous ', got '$starts8'"
    exit 1
fi
echo "ok fallback stops after 3 failures of .previous too"

# ---- 8. Privilege dropping: unprivileged daemons run with NoNewPrivs=1; polkit/edge/automount keep 0
HOME9="$TMP/home9"
mkdir -p "$HOME9/.local/bin" "$HOME9/.local/state/infynitae" "$HOME9/infynitae/live" "$TMP/priv9" "$TMP/priv9_bin"
cat > "$HOME9/infynitae/live/env.sh" <<'EOF'
# test no-op env
EOF
cat > "$HOME9/infynitae/live/config.sh" <<'EOF'
# test no-op config
EOF
cat > "$TMP/priv9_bin/setpriv" <<EOF
#!/bin/sh
echo "\$*" >> "$TMP/priv9/setpriv_calls"
exec /usr/bin/setpriv "\$@"
EOF
chmod +x "$TMP/priv9_bin/setpriv"
for h in infynitae-wallpaper infynitae-polkit infynitae-edge infynitae-automount autorotate; do
    cat > "$HOME9/.local/bin/$h" <<EOF
#!/bin/sh
awk '/^NoNewPrivs:/ { print \$2 }' /proc/self/status > "$TMP/priv9/$h"
EOF
    chmod +x "$HOME9/.local/bin/$h"
done
ln -sf infynitae-edge "$HOME9/.local/bin/infynitae-edge-apps" 2>/dev/null || true
cat > "$HOME9/infynitae/live/autorotate" <<EOF
#!/bin/sh
awk '/^NoNewPrivs:/ { print \$2 }' /proc/self/status > "$TMP/priv9/autorotate"
EOF
cat > "$TMP/bin9_monitor" <<'EOF'
#!/bin/sh
exit 0
EOF
chmod +x "$HOME9/infynitae/live/autorotate" "$TMP/bin9_monitor"
cp "$TMP/bin9_monitor" "$HOME9/.local/bin/monitor-sensor"
(
    export HOME="$HOME9" WAYLAND_DISPLAY="wayland-priv" PATH="$TMP/priv9_bin:$HOME9/.local/bin:$PATH"
    export START_LOCKED="0" START_TERMINAL="false" SESSION_RESTORE="false"
    export ENABLE_EDGE="true" AUTOMOUNT="true" NOTIFICATIONS="none"
    sh "$SESSION_SCRIPT" >/dev/null 2>&1
) || true
i=0
while [ ! -s "$TMP/priv9/autorotate" ] && [ $i -lt 50 ]; do sleep 0.05; i=$((i + 1)); done
for want_1 in infynitae-wallpaper autorotate; do
    got_p=$(cat "$TMP/priv9/$want_1" 2>/dev/null || echo missing)
    if [ "$got_p" != "1" ]; then
        echo "FAIL $want_1 NoNewPrivs: expected 1, got '$got_p'"
        exit 1
    fi
    if ! grep -q -- "--no-new-privs --inh-caps=-all .*$want_1" "$TMP/priv9/setpriv_calls" 2>/dev/null; then
        echo "FAIL $want_1 was not launched through setpriv --no-new-privs --inh-caps=-all"
        exit 1
    fi
done
for want_0 in infynitae-polkit infynitae-automount; do
    if [ ! -s "$TMP/priv9/$want_0" ]; then
        echo "FAIL $want_0 did not run"
        exit 1
    fi
    if grep -q "$want_0" "$TMP/priv9/setpriv_calls" 2>/dev/null; then
        echo "FAIL $want_0 unexpectedly ran through setpriv"
        exit 1
    fi
done
echo "ok session helpers drop NoNewPrivs where safe while preserving polkit/automount"
