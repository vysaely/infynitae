#!/bin/sh
# tools/test-session: tests for live/session.sh startup logic.
set -eu

REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
SESSION_SCRIPT="$REPO_DIR/live/session.sh"

TMP=$(mktemp -d "/tmp/infynitae-test-session.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM

# Mock required binaries and paths
MOCK_BIN="$TMP/bin"
mkdir -p "$MOCK_BIN"
export PATH="$MOCK_BIN:$PATH"

# Fake infynitae compositor comm for $PPID check
cat > "$MOCK_BIN/renice" <<EOF
#!/bin/sh
exit 0
EOF
chmod +x "$MOCK_BIN/renice"

# ---- 1. Finding 13: State directory created at startup on fresh install
HOME1="$TMP/home1"
mkdir -p "$HOME1"
(
    export HOME="$HOME1"
    export WAYLAND_DISPLAY="wayland-test"
    export START_TERMINAL="false"
    export START_LOCKED="0"
    unset XDG_STATE_HOME
    # Run session.sh up to terminal exit
    sh "$SESSION_SCRIPT" >/dev/null 2>&1 || true
)

if [ ! -d "$HOME1/.local/state/infynitae" ]; then
    echo "FAIL Finding 13: session.sh did not create $HOME1/.local/state/infynitae"
    exit 1
fi
echo "ok Finding 13: state directory created at session start"

# ---- 2. Finding 14: Screen locker verification race on fast-exiting locker
# If a locker writes "Screen locked" and exits immediately (or daemonizes),
# kill -0 $LOCK_PID breaks out of the loop. session.sh must do a final log
# check to avoid falsely aborting the session.
HOME2="$TMP/home2"
mkdir -p "$HOME2/.local/bin"

# Fast-forking locker: forks worker to write "Screen locked", initial PID exits immediately
cat > "$HOME2/.local/bin/infynitae-lock" <<EOF
#!/bin/sh
( sleep 0.18; echo "Screen locked" ) &
exit 0
EOF
chmod +x "$HOME2/.local/bin/infynitae-lock"

# Run session.sh with START_LOCKED=1 in a subshell.
# If the race condition exists, session.sh kills $PPID / exits with 1.
# If fixed, it detects "Screen locked" and proceeds cleanly.
rc=0
(
    export HOME="$HOME2"
    export WAYLAND_DISPLAY="wayland-test"
    export START_TERMINAL="false"
    export START_LOCKED="1"
    # Provide dummy config and env
    mkdir -p "$HOME2/infynitae/live"
    : > "$HOME2/infynitae/live/env.sh"
    : > "$HOME2/infynitae/live/config.sh"
    # Intercept kill -TERM $PPID so test runner is not terminated
    cat > "$MOCK_BIN/kill" <<KEER
#!/bin/sh
exit 0
KEER
    chmod +x "$MOCK_BIN/kill"
    sh "$SESSION_SCRIPT" --lock >/dev/null 2>&1
) || rc=$?

if [ $rc -ne 0 ]; then
    echo "FAIL Finding 14: session.sh aborted (exit code $rc) on fast-exiting locker"
    exit 1
fi
echo "ok Finding 14: session.sh does not abort when locker writes confirmation before exit"

# ---- 3. Finding 21: Paths with spaces or compound commands in NOTIFICATIONS and TERMINAL
HOME3="$TMP/home3"
mkdir -p "$HOME3"
SPACED_DIR="$TMP/dir with spaces"
mkdir -p "$SPACED_DIR"

NOTIFY_MARKER="$TMP/notify_marker"
TERM_MARKER="$TMP/term_marker"

cat > "$SPACED_DIR/custom-notify" <<EOF
#!/bin/sh
touch "$NOTIFY_MARKER"
exit 0
EOF
chmod +x "$SPACED_DIR/custom-notify"

cat > "$SPACED_DIR/custom-term" <<EOF
#!/bin/sh
touch "$TERM_MARKER"
exit 0
EOF
chmod +x "$SPACED_DIR/custom-term"

(
    export HOME="$HOME3"
    export WAYLAND_DISPLAY="wayland-test"
    export START_LOCKED="0"
    export NOTIFICATIONS="'$SPACED_DIR/custom-notify' --arg"
    export TERMINAL="$SPACED_DIR/custom-term"
    export START_TERMINAL="true"
    export SESSION_RESTORE="false"
    sh "$SESSION_SCRIPT" >/dev/null 2>&1 || true
)

sleep 0.2
if [ ! -f "$NOTIFY_MARKER" ]; then
    echo "FAIL Finding 21: NOTIFICATIONS with arguments/spaces failed to execute"
    exit 1
fi
if [ ! -f "$TERM_MARKER" ]; then
    echo "FAIL Finding 21: TERMINAL path with spaces failed to execute"
    exit 1
fi
echo "ok Finding 21: spaced paths and commands in NOTIFICATIONS and TERMINAL execute cleanly"

# ---- 4. infy_on accepts 1, true, yes and on in any case and nothing else (as parse_bool does)
(
    . "$REPO_DIR/live/config.sh"
    for val in 1 true yes on TRUE True tRuE YES Yes ON On; do
        if ! infy_on "$val"; then
            echo "FAIL infy_on: rejected truthy '$val'"
            exit 1
        fi
    done
    for val in 0 false no off FALSE False NO OFF 2 "" "true1" " true" "auto" "random" "yes please"; do
        if infy_on "$val"; then
            echo "FAIL infy_on: accepted non-truthy '$val'"
            exit 1
        fi
    done
)
echo "ok infy_on: accepts 1, true, yes and on in any case and nothing else"

# ---- 5. Owner, 2026-11-22: the compositor's main thread is raised with reset-on-fork, so what it
# starts later begins at normal priority; real-time when allowed, else normal with the same flag
HOME5="$TMP/home5"
mkdir -p "$HOME5/.local/bin" "$TMP/bin5"
PRIO_LOG="$TMP/prio.log"
cp "$(command -v sh)" "$TMP/bin5/infynitae"
for tool in chrt renice; do
    cat > "$TMP/bin5/$tool" <<EOF
#!/bin/sh
echo "$tool \$*" >> "$PRIO_LOG"
case " \$* " in *" -r "*) [ -n "\${NO_RT:-}" ] && exit 1 ;; esac
exit 0
EOF
    chmod +x "$TMP/bin5/$tool"
done
session_as_compositor() {
    : > "$PRIO_LOG"
    (
        export HOME="$HOME5" WAYLAND_DISPLAY="wayland-test" START_TERMINAL="false" START_LOCKED="0"
        export PATH="$TMP/bin5:$PATH" "$@"
        # the parent is named like the compositor: $PPID of session.sh
        "$TMP/bin5/infynitae" -c 'echo $$ > "$1"; sh "$2" >/dev/null 2>&1; :' sh "$TMP/root5" \
            "$SESSION_SCRIPT"
    ) || true
    root=$(cat "$TMP/root5")
}
expect_log() {
    if [ "$(cat "$PRIO_LOG")" != "$2" ]; then
        echo "FAIL $1: expected '$2', got '$(cat "$PRIO_LOG")'"
        exit 1
    fi
    echo "ok $1"
}
session_as_compositor
expect_log "the compositor's thread: nice -10, real-time 2, reset on fork" \
    "$(printf 'renice -n -10 -p %s\nchrt -R -r -p 2 %s' "$root" "$root")"
session_as_compositor NO_RT=1
expect_log "  without real-time rights: normal priority, reset on fork" \
    "$(printf 'renice -n -10 -p %s\nchrt -R -r -p 2 %s\nchrt -R -o -p 0 %s' "$root" "$root" "$root")"

# ---- 6. Owner, 2026-11-22: the kernel ends an app before the desktop when memory runs out: what
# session.sh starts gets an out-of-memory score of 300, the lock screen started on sleep keeps the
# desktop's
HOME6="$TMP/home6"
mkdir -p "$HOME6/.local/bin"
read -r base < /proc/self/oom_score_adj
app_score=$base
[ "$base" -lt 300 ] && app_score=300
cat > "$HOME6/.local/bin/infynitae-sleep-lock" <<EOF
#!/bin/sh
cat /proc/self/oom_score_adj > "$TMP/sleep_lock_oom"
EOF
cat > "$HOME6/.local/bin/app-term" <<EOF
#!/bin/sh
cat /proc/self/oom_score_adj > "$TMP/term_oom"
EOF
chmod +x "$HOME6/.local/bin/infynitae-sleep-lock" "$HOME6/.local/bin/app-term"
(
    export HOME="$HOME6" WAYLAND_DISPLAY="wayland-test" START_LOCKED="0" SESSION_RESTORE="false"
    export START_TERMINAL="true" TERMINAL="$HOME6/.local/bin/app-term" LOCK_WHEN_AWAY="true"
    sh "$SESSION_SCRIPT" >/dev/null 2>&1
) || true
i=0
while [ ! -s "$TMP/sleep_lock_oom" ] && [ $i -lt 100 ]; do sleep 0.05; i=$((i + 1)); done
if [ "$(cat "$TMP/term_oom")" != "$app_score" ]; then
    echo "FAIL an app session.sh starts: score $(cat "$TMP/term_oom"), expected $app_score"
    exit 1
fi
echo "ok an app session.sh starts gets out-of-memory score $app_score (the desktop has $base)"
if [ "$(cat "$TMP/sleep_lock_oom")" != "$base" ]; then
    echo "FAIL the sleep lock: score $(cat "$TMP/sleep_lock_oom"), expected $base"
    exit 1
fi
echo "ok   the lock screen started on sleep keeps the desktop's $base"
