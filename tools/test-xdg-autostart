#!/bin/sh
# tools/test-xdg-autostart: live/xdg-autostart starts what the XDG Autostart spec says, nothing
# else (--dry-run prints the commands). Run from the repository root.
set -eu
REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-xdg-autostart.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM
U="$TMP/user/autostart"; S="$TMP/sys/autostart"; mkdir -p "$U" "$S"
entry() { printf '[Desktop Entry]\nType=Application\nName=%s\n%s\n' "$2" "$3" > "$1"; }
entry "$U/discord.desktop" Discord 'Exec=/usr/bin/discord --start-minimized %U'
entry "$U/hidden.desktop" Hidden 'Exec=hidden-app
Hidden=true'
entry "$U/off.desktop" Off 'Exec=off-app
X-GNOME-Autostart-enabled=false'
entry "$S/gnome-only.desktop" GnomeOnly 'Exec=gnome-thing
OnlyShowIn=GNOME;Unity;'
entry "$S/ours.desktop" Ours 'Exec=ours-app
OnlyShowIn=GNOME;Infynitae;'
entry "$S/not-here.desktop" NotHere 'Exec=not-here
NotShowIn=infynitae;'
entry "$S/tryexec.desktop" TryExec 'Exec=missing-app
TryExec=/nonexistent/missing-app'
entry "$S/discord.desktop" SystemDiscord 'Exec=system-discord'
entry "$U/masks.desktop" Masks 'Exec=user-masks
Hidden=true'
entry "$S/masks.desktop" Masked 'Exec=system-masked'
printf '[Desktop Entry]\nType=Link\nURL=https://example.org\nExec=link-thing\n' > "$S/link.desktop"
printf '[Desktop Entry]\nType=Application\nExec=user-dirs\n\n[Desktop Action x]\nExec=action-thing\n' > "$S/userdirs.desktop"

got=$(XDG_CONFIG_HOME="$TMP/user" XDG_CONFIG_DIRS="$TMP/sys" XDG_CURRENT_DESKTOP="infynitae:wlroots" \
    sh "$REPO_DIR/live/xdg-autostart" --dry-run | LC_ALL=C sort | tr '\n' '|')
want="/usr/bin/discord --start-minimized|ours-app|user-dirs|"
if [ "$got" = "$want" ]; then
    echo "ok   only the entries the spec starts, field codes dropped, user files win"
else
    echo "FAIL expected $want"
    echo "     got      $got"
    exit 1
fi

# the journal: what is new or gone since the last session start, once (`true` starts nothing)
J="$TMP/j"; mkdir -p "$J/home/.config/infynitae" "$J/user/autostart" "$J/sys"
entry "$J/user/autostart/a.desktop" A 'Exec=true a'
entry "$J/user/autostart/b.desktop" B 'Exec=true b'
printf '#!/bin/sh\n' > "$J/home/.config/infynitae/autostart.sh"; chmod +x "$J/home/.config/infynitae/autostart.sh"
session() {
    HOME="$J/home" XDG_STATE_HOME="$J/state" XDG_CONFIG_HOME="$J/user" XDG_CONFIG_DIRS="$J/sys" \
        sh "$REPO_DIR/live/xdg-autostart"
}
# event and the detail's file, per line
journal() { awk -F '\t' 'NF == 6 { sub(/: .*/, "", $5); print $2 " " $5 " " $6 }' "$J/state/infynitae/journal/journal.tsv" | LC_ALL=C sort | tr '\n' '|'; }
session
got=$(journal)
want="autostart-added $J/home/.config/infynitae/autostart.sh new|autostart-added $J/user/autostart/a.desktop new|autostart-added $J/user/autostart/b.desktop new|"
[ "$got" = "$want" ] || { echo "FAIL first session: expected $want"; echo "     got $got"; exit 1; }
session
[ "$(journal)" = "$want" ] || { echo "FAIL an unchanged session wrote: $(journal)"; exit 1; }
rm "$J/user/autostart/b.desktop"
entry "$J/user/autostart/c.desktop" C 'Exec=true c'
printf '#!/bin/sh\necho changed\n' > "$J/home/.config/infynitae/autostart.sh"
: > "$J/state/infynitae/journal/journal.tsv"
session
got=$(journal)
want="autostart-added $J/home/.config/infynitae/autostart.sh new|autostart-added $J/user/autostart/c.desktop new|autostart-removed $J/home/.config/infynitae/autostart.sh gone|autostart-removed $J/user/autostart/b.desktop gone|"
[ "$got" = "$want" ] || { echo "FAIL changed session: expected $want"; echo "     got $got"; exit 1; }
echo "ok   the journal names each autostart entry new or gone since the last session, once"
