#!/bin/sh
# tools/test-edge-pick: live/edge-pick points infynitae-edge at the edge from apps whatever EDGE_IMPL
# says, names an old EDGE_IMPL value in one log line, and leaves the link alone when the edge from
# apps is not built. Stand-in binaries in a temporary folder. Run from the repository root.
set -eu
REPO_DIR=$(cd "$(dirname "$0")/.." && pwd)
TMP=$(mktemp -d "/tmp/infynitae-test-edge-pick.XXXXXX")
trap 'rm -rf "$TMP"' EXIT INT TERM
fails=0
check() { if eval "$2"; then echo "ok   $1"; else echo "FAIL $1"; fails=$((fails + 1)); fi; }
mk() { printf '#!/bin/sh\n' > "$TMP/bin/$1"; chmod 755 "$TMP/bin/$1"; }
pick() {
    mkdir -p "$TMP/home/.config/infynitae"
    if [ -n "$1" ]; then echo "EDGE_IMPL=\"$1\"" > "$TMP/home/.config/infynitae/config"; else : > "$TMP/home/.config/infynitae/config"; fi
    HOME="$TMP/home" sh "$REPO_DIR/live/edge-pick" "$TMP/bin" >/dev/null 2>"$TMP/err" || true
    readlink "$TMP/bin/infynitae-edge" 2>/dev/null || echo none
}

mkdir -p "$TMP/bin"
mk infynitae-edge-rs; mk infynitae-edge-c; mk infynitae-edge-apps
check "no EDGE_IMPL: the edge from apps" '[ "$(pick "")" = infynitae-edge-apps ] && [ ! -s "$TMP/err" ]'
check "EDGE_IMPL=apps: the edge from apps, nothing logged" '[ "$(pick apps)" = infynitae-edge-apps ] && [ ! -s "$TMP/err" ]'
check "EDGE_IMPL=rust: the edge from apps" '[ "$(pick rust)" = infynitae-edge-apps ]'
check "EDGE_IMPL=rust: one line in the log" '[ "$(wc -l < "$TMP/err")" = 1 ] && grep -q "EDGE_IMPL=\"rust\"" "$TMP/err"'
check "EDGE_IMPL=c: the edge from apps" '[ "$(pick c)" = infynitae-edge-apps ]'
check "EDGE_IMPL=c: one line in the log" '[ "$(wc -l < "$TMP/err")" = 1 ] && grep -q "EDGE_IMPL=\"c\"" "$TMP/err"'

# binaries from before the edge from apps: the link they had stays
rm -rf "$TMP/bin"; mkdir -p "$TMP/bin"; mk infynitae-edge-rs; ln -s infynitae-edge-rs "$TMP/bin/infynitae-edge"
check "apps not built: the link is left as it was" '[ "$(pick "")" = infynitae-edge-rs ]'

# an edge installed before the link (a plain file named infynitae-edge) gives way to the link
rm -rf "$TMP/bin"; mkdir -p "$TMP/bin"; mk infynitae-edge-apps; mk infynitae-edge
check "a plain infynitae-edge is replaced by the link" '[ "$(pick "")" = infynitae-edge-apps ]'

[ "$fails" = 0 ] && echo "test-edge-pick: passed" || { echo "test-edge-pick: $fails failed"; exit 1; }
