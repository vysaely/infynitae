#!/usr/bin/env python3
"""verify-development-environment — Non-destructive verification of the Infynitae Native development environment.

Derives status from repository state, installed development toolchains, and foundation verifiers.
Never modifies tracked files, toolchains or system settings; cargo build artifacts go to target/ (git-ignored).

Usage:
  tools/verify-development-environment [--spike] [--help]
"""

import os
import tomllib
import shutil
import subprocess
import sys

HISTORICAL_SEALS = [
    ("Phase C seal", "615b0ed2f3631b698b0c54783c28f696ef4ff34a"),
    ("Phase D falsification baseline", "e8ec03a2ab36f315ae025723ec666b9ad278ac83"),
    ("Phase D 1R seal", "84ce620898445aaadb72f386ec3954e5bbfe2c2f"),
    ("Phase D 2R seal", "5827926782089dc8c6a1c203f844fbc879fce9be"),
    ("Phase D final seal", "c0a1cee310e56b75d32cf30152a09975ff776700"),
    ("Phase D tracking", "09075a2d07dbc0cba862baac62136f9f3ff9e7b5"),
    ("Phase E corrective checkpoint E1R seal", "1ae1b736515b8c52c3e6ba7596b22c81f7098390"),
    ("Phase E corrective checkpoint E1R tracking", "e9d36732ac4fa9e934ee1b90bb696e9545c598ab"),
    ("Phase E final review commit", "cfb54f091bd2a19065a45b32662e8f0bbddd62fc"),
]

PINNED_TOOLCHAIN = "1.99.0"

REQUIRED_SYSTEM_TOOLS = ["git", "python3", "rustc", "cargo", "pkg-config", "tar"]
OPTIONAL_SYSTEM_TOOLS = ["gh", "zstd"]

REQUIRED_PKG_CONFIG = [
    "wayland-server",
    "xkbcommon",
    "libinput",
    "libdrm",
    "gbm",
]

# Reported but not required: no current build needs them.
# wayland-protocols: system protocol XML (Phase A reference reading); the Rust
#   `wayland-protocols` crate bundles its own XML.
# libseat (Arch package `seatd`): Smithay `backend_session_libseat`, Phase G DRM backend only.
DEFERRED_PKG_CONFIG = [
    ("wayland-protocols", "reference XML only"),
    ("libseat", "Phase G session backend; package seatd"),
]


def run_cmd(cmd, cwd=None):
    try:
        res = subprocess.run(
            cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
        )
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return -1, "", str(e)


def main():
    repo_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    print("=" * 70)
    print("Infynitae Native — Development Environment Verifier")
    print(f"Repository root: {repo_root}")
    print("=" * 70)

    all_passed = True

    # 1. Git Repository State
    print("\n[1] Git Repository State:")
    code, head_hash, _ = run_cmd(["git", "rev-parse", "HEAD"], cwd=repo_root)
    if code == 0:
        code_b, branch, _ = run_cmd(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=repo_root)
        print(f"  ✓ HEAD:   {head_hash} (branch: {branch})")
    else:
        print("  ✗ Failed to determine git HEAD")
        all_passed = False

    # Check seals reachability
    missing_seals = 0
    for name, seal_hash in HISTORICAL_SEALS:
        code, _, _ = run_cmd(["git", "cat-file", "-e", seal_hash], cwd=repo_root)
        if code == 0:
            print(f"  ✓ Reachable seal: {seal_hash[:10]} ({name})")
        else:
            print(f"  ✗ Missing seal:    {seal_hash} ({name})")
            missing_seals += 1
            all_passed = False

    # 2. Phase F workspace integrity (INC-0 onwards)
    print("\n[2] Phase F Workspace Integrity:")
    try:
        with open(os.path.join(repo_root, "Cargo.toml"), "rb") as f:
            manifest = tomllib.load(f)
        members = manifest.get("workspace", {}).get("members", [])
        if members:
            print(f"  ✓ root workspace: {len(members)} members")
        else:
            print("  ✗ root Cargo.toml has no [workspace] members")
            all_passed = False
    except (OSError, tomllib.TOMLDecodeError) as e:
        print(f"  ✗ root Cargo.toml unreadable: {e}")
        all_passed = False
    try:
        with open(os.path.join(repo_root, "rust-toolchain.toml"), "rb") as f:
            channel = tomllib.load(f).get("toolchain", {}).get("channel")
        if channel == PINNED_TOOLCHAIN:
            print(f"  ✓ rust-toolchain.toml pins {PINNED_TOOLCHAIN}")
        else:
            print(f"  ✗ rust-toolchain.toml channel {channel!r}; {PINNED_TOOLCHAIN!r} expected")
            all_passed = False
    except (OSError, tomllib.TOMLDecodeError) as e:
        print(f"  ✗ rust-toolchain.toml unreadable: {e}")
        all_passed = False
    code_l, _, _ = run_cmd(["git", "ls-files", "--error-unmatch", "Cargo.lock"], cwd=repo_root)
    if code_l == 0:
        print("  ✓ Cargo.lock tracked")
    elif os.path.exists(os.path.join(repo_root, "Cargo.lock")):
        print("  - Cargo.lock present but not yet committed")
    else:
        print("  ✗ Cargo.lock missing")
        all_passed = False
    for rel in ("tools/verify-architecture", ".github/workflows/ci.yml"):
        path = os.path.join(repo_root, rel)
        if os.path.exists(path) and (rel.endswith(".yml") or os.access(path, os.X_OK)):
            print(f"  ✓ {rel}")
        else:
            print(f"  ✗ {rel} missing or not executable")
            all_passed = False
    if os.path.exists(os.path.join(repo_root, "src")):
        print("  ✗ root src/ exists; production code lives under crates/")
        all_passed = False
    else:
        print("  ✓ no root src/ (production crates live under crates/)")

    # 3. Toolchain & Command Availability
    print("\n[3] Toolchain Availability:")
    for tool in REQUIRED_SYSTEM_TOOLS:
        path = shutil.which(tool)
        if path:
            # get version if possible
            _, ver, _ = run_cmd([tool, "--version"])
            first_line = ver.splitlines()[0] if ver else path
            print(f"  ✓ {tool:<12} {first_line}")
        else:
            print(f"  ✗ {tool:<12} MISSING (required)")
            all_passed = False

    for tool in OPTIONAL_SYSTEM_TOOLS:
        path = shutil.which(tool)
        if path:
            _, ver, _ = run_cmd([tool, "--version"])
            first_line = ver.splitlines()[0] if ver else path
            print(f"  ✓ {tool:<12} {first_line}")
        else:
            print(f"  - {tool:<12} NOT FOUND (optional)")

    # 4. Native Wayland / Graphics Build Libraries
    print("\n[4] Native Build Libraries (pkg-config):")
    if shutil.which("pkg-config"):
        for lib in REQUIRED_PKG_CONFIG:
            code, ver, _ = run_cmd(["pkg-config", "--modversion", lib])
            if code == 0:
                print(f"  ✓ {lib:<20} {ver}")
            else:
                print(f"  ✗ {lib:<20} NOT FOUND via pkg-config")
                all_passed = False
        for lib, why in DEFERRED_PKG_CONFIG:
            code, ver, _ = run_cmd(["pkg-config", "--modversion", lib])
            if code == 0:
                print(f"  ✓ {lib:<20} {ver}")
            else:
                print(f"  - {lib:<20} NOT FOUND (not required: {why})")
    else:
        print("  ✗ pkg-config not available to inspect system libraries")
        all_passed = False

    # 5. Foundation Documentation Checks
    print("\n[5] Foundation Document Integrity:")
    checker_path = os.path.join(repo_root, "tools", "check-foundation-docs")
    if os.path.exists(checker_path):
        code, out, _ = run_cmd([sys.executable, checker_path], cwd=repo_root)
        if code == 0 and "RESULT: PASS" in out:
            print("  ✓ check-foundation-docs: PASS (57 invariants, 20 formulas, 51 obligations intact)")
        else:
            print("  ✗ check-foundation-docs: FAILED")
            for line in out.splitlines()[-5:]:
                print(f"    {line}")
            all_passed = False

        code_st, out_st, _ = run_cmd([sys.executable, checker_path, "--self-test"], cwd=repo_root)
        if code_st == 0 and "SELF-TEST: PASS" in out_st:
            print("  ✓ check-foundation-docs --self-test: PASS (18/18 seeded defects detected)")
        else:
            print("  ✗ check-foundation-docs --self-test: FAILED")
            all_passed = False
    else:
        print(f"  ✗ Foundation checker script missing: {checker_path}")
        all_passed = False

    # 6. Architecture Authority Spike (C1)
    print("\n[6] C1 Authority Spike Verification:")
    spike_script = os.path.join(repo_root, "experiments", "c1-authority-spike", "verify.sh")
    if os.path.exists(spike_script) and shutil.which("cargo"):
        code_sp, out_sp, err_sp = run_cmd([spike_script], cwd=repo_root)
        if code_sp == 0 and "result: PASS" in out_sp:
            print("  ✓ c1-authority-spike/verify.sh: PASS (compiler negative probes verified)")
        else:
            print("  ✗ c1-authority-spike/verify.sh: FAILED")
            all_passed = False
    else:
        print("  - c1-authority-spike skipped (cargo or script unavailable)")

    # 7. Production architecture enforcement (OB-19)
    print("\n[7] Production Architecture Verification:")
    va = os.path.join(repo_root, "tools", "verify-architecture")
    if os.path.exists(va) and shutil.which("cargo"):
        code_va, out_va, _ = run_cmd([va], cwd=repo_root)
        if code_va == 0 and "== verify-architecture: PASS" in out_va:
            print("  ✓ tools/verify-architecture: PASS")
        else:
            print("  ✗ tools/verify-architecture: FAILED")
            for line in out_va.splitlines():
                if "FAIL" in line:
                    print(f"    {line.strip()}")
            all_passed = False
    else:
        print("  ✗ tools/verify-architecture missing or cargo unavailable")
        all_passed = False

    print("\n" + "=" * 70)
    if all_passed:
        print("VERIFICATION RESULT: ALL CHECKS PASSED")
        print("Environment and repository are ready for authorized development handoff.")
        try:
            with open(os.path.join(repo_root, "docs", "foundation", "CHECKPOINT.md")) as f:
                phase = next((l.strip() for l in f if l.startswith("CURRENT_PHASE:")), "unknown")
        except OSError:
            phase = "CHECKPOINT.md unreadable"
        print(f"Current gate (docs/foundation/CHECKPOINT.md): {phase}")
        print("=" * 70)
        return 0
    else:
        print("VERIFICATION RESULT: SOME CHECKS FAILED OR INCOMPLETE")
        print("=" * 70)
        return 1


if __name__ == "__main__":
    sys.exit(main())
