+    /// A window asking to be minimized (exclusive fullscreen games do on focus loss). There is
+    /// nothing to minimize it to, but it must hear the answer: Wine stays minimized, drawing
+    /// nothing, until WM_STATE goes Iconic and back. Focusing the window sets Normal again; one
+    /// that already has the focus would never get that, so it is told at once.
+    fn iconify(&self, window: x::Window) {
+        let set_state = |state: WmState| {
+            if let Err(e) = self.connection.send_and_check_request(&x::ChangeProperty {
+                mode: x::PropMode::Replace,
+                window,
+                property: self.atoms.wm_state,
+                r#type: self.atoms.wm_state,
+                data: &[state as u32, 0],
+            }) {
+                debug!("ChangeProperty failed ({window:?}: {e:?})");
+            }
+        };
+        set_state(WmState::Iconic);
+        let active = self
+            .connection
+            .wait_for_reply(self.get_property_cookie(
+                self.root,
+                self.atoms.active_win,
+                x::ATOM_WINDOW,
+                1,
+            ))
+            .unwrap();
+        if active.value::<x::Window>().first() == Some(&window) {
+            set_state(WmState::Normal);
+        }
+    }
